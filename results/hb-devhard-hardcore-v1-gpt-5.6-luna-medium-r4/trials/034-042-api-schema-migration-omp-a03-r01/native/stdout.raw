Implement version-aware payload conversion\n    - [ ] Add batch aggregation audit and CLI support\n  Verification:\n    - [ ] Run migration test suite and CLI smoke check\n    - [ ] Review changed files and audit output"}],"details":{"op":"done","phases":[{"name":"Research","tasks":[{"content":"Read migration requirements and current converter","status":"completed"},{"content":"Inspect schemas tests and package entrypoints","status":"in_progress"}]},{"name":"Implementation","tasks":[{"content":"Implement version-aware payload conversion","status":"pending"},{"content":"Add batch aggregation audit and CLI support","status":"pending"}]},{"name":"Verification","tasks":[{"content":"Run migration test suite and CLI smoke check","status":"pending"},{"content":"Review changed files and audit output","status":"pending"}]}],"storage":"memory","completedTasks":[{"phase":"Research","content":"Read migration requirements and current converter"}]},"isError":false,"timestamp":1788152664066},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_0d771f53efec988f016a950b58e19487d286856b8b25a555f5\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"<PROVIDER_ENCRYPTED_PAYLOAD_REDACTED>\",\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"0b418157-82ae-4eef-a391-4af998e4a8da\"},\"summary\":[],\"metadata\":{\"turn_id\":\"0b418157-82ae-4eef-a391-4af998e4a8da\"}}"},{"type":"toolCall","id":"call_ksqdkd206oTO1Iw6cp4dPYq7|ctc_0d771f53efec988f016a950b598cd087d2880a5a35f775ba43","name":"edit","arguments":{"input":"*** Begin Patch\n[ in/schema_migration/client.py#97CA]\nPUT 1.=14:\n+\"\"\"Legacy order payload migration utilities.\"\"\"\n+\n+from __future__ import annotations\n+\n+import copy\n+import json\n+import sys\n+from pathlib import Path\n+\n+\n+_PII_KEYS = {\n+    \"ssn\",\n+    \"credit_card\",\n+    \"card_number\",\n+    \"cvv\",\n+    \"phone_number\",\n+    \"passport_number\",\n+}\n+_LEGACY_FIELDS = {\n+    \"id\", \"order_ref\", \"customer_id\", \"customer_name\", \"customer\",\n+    \"items\", \"lines\", \"ship_to\", \"shipTo\", \"shipping_method\", \"shipping\",\n+}\n+\n+\n+class ConversionError(ValueError):\n+    \"\"\"Raised when a payload cannot satisfy the target order shape.\"\"\"\n+\n+\n+def _require_mapping(value, path):\n+    if not isinstance(value, dict):\n+        raise ConversionError(f\"{path} must be an object\")\n+    return value\n+\n+\n+def _required_string(value, path):\n+    if not isinstance(value, str) or not value:\n+        raise ConversionError(f\"missing or invalid {path}\")\n+    return value\n+\n+\n+def _integer(value, path):\n+    if isinstance(value, bool):\n+        raise ConversionError(f\"{path} must be an integer\")\n+    try:\n+        converted = int(value)\n+    except (TypeError, ValueError):\n+        raise ConversionError(f\"{path} must be an integer\") from None\n+    if isinstance(value, float) and not value.is_integer():\n+        raise ConversionError(f\"{path} must be an integer\")\n+    if isinstance(value, str) and str(converted) != value.strip():\n+        raise ConversionError(f\"{path} must be an integer\")\n+    return converted\n+\n+\n+def _shipping_method(value):\n+    return value.strip() if isinstance(value, str) and value.strip() else \"standard\"\n+\n+\n+def _drop_pii_and_count(value):\n+    \"\"\"Return unknown metadata with sensitive keys removed and a drop count.\"\"\"\n+    if not isinstance(value, dict):\n+        return copy.deepcopy(value), 0\n+    result = {}\n+    dropped = 0\n+    for key, item in value.items():\n+        if str(key).lower() in _PII_KEYS:\n+            dropped += 1\n+            continue\n+        cleaned, nested_dropped = _drop_pii_and_count(item)\n+        result[key] = cleaned\n+        dropped += nested_dropped\n+    return result, dropped\n+\n+\n+def _legacy_unknown_fields(payload):\n+    unknown = {key: value for key, value in payload.items()\n+               if key not in _LEGACY_FIELDS}\n+    return _drop_pii_and_count(unknown)\n+\n+\n+def _convert_v2(payload):\n+    result = copy.deepcopy(payload)\n+    if not isinstance(result, dict):\n+        raise ConversionError(\"payload must be an object\")\n+    for key in (\"orderId\", \"buyer\", \"lineItems\", \"shipping\", \"metadata\"):\n+        if key not in result:\n+            raise ConversionError(f\"missing {key}\")\n+    _required_string(result[\"orderId\"], \"orderId\")\n+    buyer = _require_mapping(result[\"buyer\"], \"buyer\")\n+    _required_string(buyer.get(\"id\"), \"buyer.id\")\n+    _required_string(buyer.get(\"displayName\"), \"buyer.displayName\")\n+    if not isinstance(result[\"lineItems\"], list):\n+        raise ConversionError(\"lineItems must be an array\")\n+    for index, item in enumerate(result[\"lineItems\"]):\n+        item = _require_mapping(item, f\"lineItems[{index}]\")\n+        _integer(item.get(\"quantity\"), f\"lineItems[{index}].quantity\")\n+        _integer(item.get(\"unitPriceCents\"), f\"lineItems[{index}].unitPriceCents\")\n+    shipping = _require_mapping(result[\"shipping\"], \"shipping\")\n+    shipping[\"method\"] = _shipping_method(shipping.get(\"method\"))\n+    address = _require_mapping(shipping.get(\"address\"), \"shipping.address\")\n+    if \"postalCode\" not in address:\n+        raise ConversionError(\"missing shipping.address.postalCode\")\n+    _required_string(address[\"postalCode\"], \"shipping.address.postalCode\")\n+    _require_mapping(result[\"metadata\"], \"metadata\")\n+    return result, 0, 0\n+\n+\n+def _convert_legacy(payload):\n+    if not isinstance(payload, dict):\n+        raise ConversionError(\"payload must be an object\")\n+    order_id = payload.get(\"id\", payload.get(\"order_ref\"))\n+    _required_string(order_id, \"orderId\")\n+\n+    customer = payload.get(\"customer\")\n+    if customer is not None:\n+        customer = _require_mapping(customer, \"customer\")\n+        buyer_id = customer.get(\"id\")\n+        display_name = customer.get(\"name\")\n+    else:\n+        buyer_id = payload.get(\"customer_id\")\n+        display_name = payload.get(\"customer_name\")\n+    _required_string(buyer_id, \"customer_id\")\n+    _required_string(display_name, \"customer_name\")\n+\n+    raw_items = payload.get(\"items\", payload.get(\"lines\"))\n+    if not isinstance(raw_items, list):\n+        raise ConversionError(\"missing items\")\n+    line_items = []\n+    for index, item in enumerate(raw_items):\n+        item = _require_mapping(item, f\"items[{index}]\")\n+        quantity = _integer(item.get(\"qty\"), f\"items[{index}].qty\")\n+        price = item.get(\"price_cents\", item.get(\"unit_price_cents\"))\n+        price = _integer(price, f\"items[{index}].price_cents\")\n+        line_items.append({\n+            \"sku\": item.get(\"sku\"),\n+            \"quantity\": quantity,\n+            \"unitPriceCents\": price,\n+        })\n+\n+    address = payload.get(\"ship_to\", payload.get(\"shipTo\"))\n+    address = _require_mapping(address, \"ship_to\")\n+    postal = address.get(\"postal\", address.get(\"postalCode\", address.get(\"postal_code\")))\n+    _required_string(postal, \"ship_to.postal\")\n+    shipping = {\n+        \"method\": _shipping_method(\n+            payload.get(\"shipping_method\", payload.get(\"shipping\"))\n+        ),\n+        \"address\": {\"country\": address.get(\"country\"), \"postalCode\": postal},\n+    }\n+    unknown, pii_dropped = _legacy_unknown_fields(payload)\n+    metadata = {\"source\": \"legacy-v1\"}\n+    if unknown:\n+        metadata[\"unknownFields\"] = unknown\n+    return {\n+        \"orderId\": order_id,\n+        \"buyer\": {\"id\": buyer_id, \"displayName\": display_name},\n+        \"lineItems\": line_items,\n+        \"shipping\": shipping,\n+        \"metadata\": metadata,\n+    }, pii_dropped, len(unknown)\n+\n+\n+def convert_order(payload):\n+    \"\"\"Convert a legacy order or normalize an already-v2 order.\"\"\"\n+    if is