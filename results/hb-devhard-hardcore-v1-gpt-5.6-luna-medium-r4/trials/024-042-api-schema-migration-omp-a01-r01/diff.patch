+
+class ConversionError(ValueError):
+    """A payload error carrying the most useful input path."""
+
+    def __init__(self, path, message):
+        self.path = path
+        super().__init__(message)
+
+
+def _require_mapping(payload, path="payload"):
+    if not isinstance(payload, dict):
+        raise ConversionError(path, "payload must be an object")
+
+
+def _required(payload, key, path=None):
+    if key not in payload or payload[key] is None:
+        raise ConversionError(path or key, f"missing required field: {path or key}")
+    return payload[key]
+
+
+def _integer(value, path):
+    if isinstance(value, bool):
+        raise ConversionError(path, "must be an integer")
+    try:
+        converted = int(value)
+    except (TypeError, ValueError):
+        raise ConversionError(path, "must be an integer") from None
+    if isinstance(value, float) and value != converted:
+        raise ConversionError(path, "must be an integer")
+    return converted
+
+
+def _convert_v2(payload):
+    result = copy.deepcopy(payload)
+    for key in ("orderId", "buyer", "lineItems", "shipping", "metadata"):
+        _required(result, key)
+    if not isinstance(result["buyer"], dict):
+        raise ConversionError("buyer", "must be an object")
+    if not isinstance(result["lineItems"], list):
+        raise ConversionError("lineItems", "must be an array")
+    if not isinstance(result["shipping"], dict):
+        raise ConversionError("shipping", "must be an object")
+    if not isinstance(result["metadata"], dict):
+        raise ConversionError("metadata", "must be an object")
+    result["shipping"]["method"] = result["shipping"].get("method") or "standard"
+    return result, 0, 0
+
+
+def _legacy_unknown_fields(payload):
+    unknown = {}
+    for key, value in payload.items():
+        if key in _LEGACY_KEYS:
+            continue
+        if key.lower() in _PII_KEYS:
+            continue
+        unknown[key] = copy.deepcopy(value)
+    return unknown
+
+
+def _count_pii(value):
+    if isinstance(value, dict):
+        return sum(
+            (1 if key.lower() in _PII_KEYS else 0) + _count_pii(child)
+            for key, child in value.items()
+        )
+    if isinstance(value, list):
+        return sum(_count_pii(child) for child in value)
+    return 0
+
+
+def _convert_legacy(payload):
+    order_id = payload.get("id", payload.get("order_ref"))
+    if order_id is None:
+        raise ConversionError("id", "missing required field: id or order_ref")
+
+    customer = payload.get("customer")
+    if customer is not None:
+        if not isinstance(customer, dict):
+            raise ConversionError("customer", "must be an object")
+        buyer_id = _required(customer, "id", "customer.id")
+        display_name = _required(customer, "name", "customer.name")
+    else:
+        buyer_id = _required(payload, "customer_id")
+        display_name = _required(payload, "customer_name")
+
+    items_key = "lines" if "lines" in payload else "items"
+    items = _required(payload, items_key)
+    if not isinstance(items, list):
+        raise ConversionError(items_key, "must be an array")
+    line_items = []
+    for index, item in enumerate(items):
+        path = f"{items_key}[{index}]"
+        if not isinstance(item, dict):
+            raise ConversionError(path, "must be an object")
+        quantity = _required(item, "qty", f"{path}.qty")
+        price = item.get("price_cents", item.get("unit_price_cents"))
+        if price is None:
+            raise ConversionError(f"{path}.price_cents", "missing required field: price_cents or unit_price_cents")
+        line_items.append({
+            "sku": _required(item, "sku", f"{path}.sku"),
+            "quantity": _integer(quantity, f"{path}.qty"),
+            "unitPriceCents": _integer(price, f"{path}.price_cents"),
+        })
+
+    address_key = "shipTo" if "shipTo" in payload else "ship_to"
+    address = _required(payload, address_key)
