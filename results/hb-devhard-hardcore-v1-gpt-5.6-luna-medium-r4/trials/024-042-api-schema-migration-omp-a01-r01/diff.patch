+    postal = address.get("postal", address.get("postalCode", address.get("postal_code")))
+    if postal is not None:
+        address_result["postalCode"] = postal
+    else:
+        raise ConversionError(f"{address_key}.postal", "missing required postal field")
+
+    method = payload.get("shipping_method", payload.get("shipping"))
+    unknown = _legacy_unknown_fields(payload)
+    pii_dropped = _count_pii(payload)
+    metadata = {"source": "legacy-v1"}
+    if unknown:
+        metadata["unknownFields"] = unknown
+    result = {
+        "orderId": order_id,
+        "buyer": {"id": buyer_id, "displayName": display_name},
+        "lineItems": line_items,
+        "shipping": {"method": method or "standard", "address": address_result},
+        "metadata": metadata,
+    }
+    return result, pii_dropped, len(unknown)
+
