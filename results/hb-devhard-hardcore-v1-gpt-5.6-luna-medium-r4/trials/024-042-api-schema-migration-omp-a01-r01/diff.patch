+
+_PII_KEYS = {
+    "ssn",
+    "credit_card",
+    "card_number",
+    "cvv",
+    "phone_number",
+    "passport_number",
+}
+_LEGACY_KEYS = {
+    "id",
+    "order_ref",
+    "customer_id",
+    "customer_name",
+    "customer",
+    "items",
+    "lines",
+    "ship_to",
+    "shipTo",
+    "shipping_method",
+    "shipping",
+}
