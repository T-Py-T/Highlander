n        \"total_cents\": 550,\n        \"currency\": \"USD\",\n    }\n\n\ndef test_reports_group_by_currency():\n    catalog = sample_catalog()\n    result = summarize_orders(\n        [\n            {\"id\": \"o1\", \"lines\": [{\"sku\": \"PEN\", \"quantity\": 2}]},","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/in/shopmono/tests/test_orders_report_integration.py","text":"import pytest\n\nfrom catalog.pricing import sample_catalog\nfrom orders.service import price_order\nfrom reports.monthly import summarize_orders\n\n\ndef test_order_prices_catalog_money_objects():\n    catalog = sample_catalog()\n    assert price_order([{\"sku\": \"PEN\", \"quantity\": 2}, {\"sku\": \"PAD\", \"quantity\": 1}], catalog) == {\n        \"total_cents\": 550,\n        \"currency\": \"USD\",\n    }\n\n\ndef test_reports_group_by_currency():\n    catalog = sample_catalog()\n    result = summarize_orders(\n        [\n            {\"id\": \"o1\", \"lines\": [{\"sku\": \"PEN\", \"quantity\": 2}]},\n            {\"id\": \"o2\", \"lines\": [{\"sku\": \"MUG\", \"quantity\": 1}]},\n        ],\n        catalog,\n    )\n    assert result == {\"order_count\": 2, \"revenue_by_currency\": {\"USD\": 250, \"EUR\": 700}}\n\n\ndef test_mixed_currency_order_is_rejected():\n    catalog = sample_catalog()\n    with pytest.raises(ValueError, match=\"mixed\"):\n        price_order([{\"sku\": \"PEN\", \"quantity\": 1}, {\"sku\": \"MUG\", \"quantity\": 1}], catalog)","lineStart":1,"lineEnd":31,"totalLines":31,"truncated":false}},"title":"workspace/in/shopmono/tests/test_orders_report_integration.py","time":{"start":1788164635460,"end":1788164635482}},"metadata":{"openai":{"itemId":"fc_0b22d9c858766c20016a953a1b2a8c87d28be9746df43ddc1e"}},"id":"prt_056eafb3e0012JgSdQES7wnR67","sessionID":"ses_fa9158e51ffe06kpEfMXBMQYJc","messageID":"msg_056eae4ad001Wn4763JLA3hA4B"}}
