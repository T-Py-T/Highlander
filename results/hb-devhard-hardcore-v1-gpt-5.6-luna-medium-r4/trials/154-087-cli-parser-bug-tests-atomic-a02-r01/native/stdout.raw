csv.DictReader(proc.stdout.splitlines())] == [\"o2\", \"o3\", \"o1\"]\n\n\ndef test_invalid_where_and_missing_fields_fail_clearly():\n    bad_where = run_cli(\"samples/orders.csv\", \"--where\", \"status\")\n    assert bad_where.returncode != 0\n    assert \"invalid --where expression\" in bad_where.stderr\n\n    missing = run_cli(\"samples/orders.csv\", \"--select\", \"unknown\")\n    assert missing.returncode != 0\n    assert \"select field not found\" in missing.stderr\n\n    missing_sort = run_cli(\"samples/orders.csv\", \"--sort\", \"unknown\")\n    assert missing_sort.returncode != 0\n    assert \"sort field not found\" in missing_sort.stderr\n\n\ndef test_quoted_comma_is_quoted_in_output():\n    proc = run_cli(\"samples/orders.csv\", \"--where\", \"id=o1\", \"--select\", \"customer\")\n    assert proc.returncode == 0, proc.stderr\n    assert proc.stdout.splitlines() == [\"customer\", '\"Ava, Inc\"']\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-luna","usage":{"input":472,"output":594,"cacheRead":22016,"cacheWrite":0,"reasoning":59,"totalTokens":23082,"cost":{"input":0.0000944,"output":0.0007128,"cacheRead":0.00044032,"cacheWrite":0,"total":0.00124752}},"stopReason":"toolUse","timestamp":1788179004026,"responseId":"resp_039fcbc4bbd79cd6016a95723c45d887d2a18de89a824649cc","rawStopReason":"completed"},{"role":"toolResult","toolCallId":"call_OiD5qSf9A496Ai13WYaWHt0K|fc_039fcbc4bbd79cd6016a95723f876087d29bed20323c240f8a","toolName":"write","content":[{"type":"text","text":"[in/csvtool/tests/test_cli_regression.py#D4AD]\nSuccessfully wrote 1690 bytes to /workspace/in/csvtool/tests/test_cli_regression.py"}],"details":{"resolvedPath":"/workspace/in/csvtool/tests/test_cli_regression.py"},"isError":false,"timestamp":1788179016883},{"role":"assistant","content":[{"type":"thinking","thinking":"**Running test suite**","thinkingSignature":"{\"id\":\"rs_039fcbc4bbd79cd6016a957249b0b087d2acc2e9fde2128557\",\"type\":\"reasoning\",\"content\":