{"type":"tool_execution_end","toolCallId":"call_B747Z8JoLSeDy7abkX1opD0y|fc_039fcbc4bbd79cd6016a95729331d087d29eebcd4e21762b51","toolName":"read","result":{"content":[{"type":"text","text":"[in/csvtool/csvtool/cli.py#16D8]\n1:from __future__ import annotations\n2:\n3:import argparse\n4:import csv\n5:import sys\n6:\n7:from csvtool.filtering import parse_where, select_fields\n8:\n9:\n10:def read_rows(path):\n11:    with open(path, newline=\"\", encoding=\"utf-8\") as stream:\n12:        reader = csv.DictReader(stream)\n13:        if reader.fieldnames is None:\n14:            raise ValueError(\"CSV file has no header\")\n15:        headers = reader.fieldnames\n16:        rows = list(reader)\n17:    return headers, rows\n18:\n19:\n20:def _sort_key(value):\n21:    try:\n22:        return (0, float(value))\n23:    except (TypeError, ValueError):\n24:        return (1, value)\n25:\n26:\n27:def main(argv=None):\n28:    parser = argparse.ArgumentParser()\n29:    parser.add_argument(\"csv_file\")\n30:    parser.add_argument(\"--where\", action=\"append\", default=[])\n31:    parser.add_argument(\"--select\")\n32:    parser.add_argument(\"--sort\")\n33:    if argv is None:\n34:        argv = sys.argv[1:]\n35:    # argparse treats a descending field (such as -created_at) as an option.\n36:    normalized = []\n37:    index = 0\n38:    while index < len(argv):\n39:        if argv[index] == \"--sort\" and index + 1 < len(argv) and argv[index + 1].startswith(\"-\"):\n40:            normalized.append(\"--sort=\" + argv[index + 1])\n41:            index += 2\n42:        else:\n43:            normalized.append(argv[index])\n44:            index += 1\n45:    args = parser.parse_args(normalized)\n46:\n47:    try:\n48:        headers, rows = read_rows(args.csv_file)\n49:        for expr in args.where:\n50:            predicate = parse_where(expr)\n51:            field = expr.split(\"=\", 1)[0].strip()\n52:            if field not in headers:\n53:                raise ValueError(f\"where field not found: {field}\")\n54:            rows = [row for row in rows if predicate(row)]\n55:\n56:        sort_field = args.sort[1:] if args.sort and args.sort.startswith(\"-\") else args.sort\n57:        if args.sort and not sort_field:\n58:            raise ValueError(\"sort field not found: (empty)\")\n59:        if sort_field:\n60:            if sort_field not in headers:\n61:                raise ValueError(f\"sort field not found: {sort_field}\")\n62:            rows.sort(key=lambda row: _sort_key(row[sort_field]), reverse=args.sort.startswith(\"-\"))\n63:\n64:        rows, selected_headers = select_fields(rows, args.select, headers)\n65:        output = csv.writer(sys.stdout, lineterminator=\"\\n\")\n66:        output.writerow(selected_headers)\n67:        output.writerows([[row.get(header, \"\") for header in selected_headers] for row in rows])\n68:        return 0\n69:    except (OSError, ValueError) as exc:\n70:        parser.error(str(exc))\n71:\n72:\n73:if __name__ == \"__main__\":\n74:    raise SystemExit(main())"}],"details":{"meta":{"source":"/workspace/in/csvtool/csvtool/cli.py","sourcePath":"/workspace/in/csvtool/csvtool/cli.py"}}},"isError":false}
