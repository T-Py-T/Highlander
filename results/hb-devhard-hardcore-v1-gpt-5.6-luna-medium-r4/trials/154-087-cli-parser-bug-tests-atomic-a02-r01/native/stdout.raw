se_branch","required":false},{"name":"git_worktree_dir","required":false},{"name":"create_pr","required":false}]},{"name":"tournament","description":"Run independent whole-task attempts through a soft-scored pivot-pairing schedule and return an auditable ranking.","inputs":[{"name":"prompt","required":true},{"name":"num_attempts","required":false},{"name":"max_concurrency","required":false},{"name":"n_evaluations","required":false},{"name":"pivots","required":false},{"name":"seed","required":false},{"name":"criteria","required":false},{"name":"models","required":false}]}]},"isError":false,"timestamp":1788178931496}]}
