f.values.pop(0)\n\nclock = FakeClock(1000.0)\ns = Scheduler(clock=clock, random_source=FakeRandom([0.3]))\ns.add('task-b', 5); s.add('task-a', 5); s.add('task-c', 9)\nassert [t.id for t in s.ready()] == ['task-c', 'task-a', 'task-b']\nassert [t.id for t in s.ready()] == ['task-c', 'task-a', 'task-b']\nt = Scheduler(clock=FakeClock(200.0), random_source=FakeRandom([0.25])).add('task-retry', 3)\nr = s = Scheduler(clock=FakeClock(200.0), random_source=FakeRandom([0.25]))\nt = s.add('task-retry', 3); retry = s.schedule_retry(t, 10.0)\nassert retry.run_at == 210.25 and retry.attempts == 1\nclock = FakeClock(200.0); s = Scheduler(clock=clock, random_source=FakeRandom([0.5])); t=s.add('task-wait',3); retry=s.schedule_retry(t,10.0)\nassert s.ready() == []\nclock.value = retry.run_at\nassert [x.id for x in s.ready()] == ['task-wait']\nprint('manual assertions: PASS')\nPY\npython3 -m compileall -q flakyqueue tests && echo compileall:PASS","cwd":"/workspace/in/flakyqueue","timeout":30}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-luna","usage":{"input":1210,"output":426,"cacheRead":20992,"cacheWrite":0,"reasoning":0,"totalTokens":22628,"cost":{"input":0.00024200000000000003,"output":0.0005112,"cacheRead":0.00041984,"cacheWrite":0,"total":0.00117304}},"stopReason":"toolUse","timestamp":1788172938345,"responseId":"resp_09f98ac3076243f0016a955a8a964487d2927c78a608919a3f","rawStopReason":"completed"},{"role":"toolResult","toolCallId":"call_HNgGSvhZM75BYhaPqwJl52lo|fc_09f98ac3076243f0016a955a8bb92087d2b9eef1a433ea0788","toolName":"bash","content":[{"type":"text","text":"manual assertions: PASS\ncompileall:PASS\n"}],"details":{"timeoutSeconds":30,"wallTimeMs":57},"isError":false,"timestamp":1788172947390},{"role":"assistant","content":[{"type":"thinking","thinking":"**Planning directory creation for exact output path**","thinkingSignature":"{\"id\":\"rs_09f98ac3076243f0016a955a946b2887d296b9ab1e80357084\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"<PROVIDER_ENCRYPTED_PAYLOAD_REDACTED>\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Planning directory creation for exact output path**\"}]}"},{"type":"toolCall","id":"call_zmO6ATFYrFsdfWekNGPwQqIm|fc_09f98ac3076243f0016a955a974fcc87d29a59c421c335209b","name":"write","arguments":{"path":"/workspace/out/root_cause.md","content":"# Flaky queue root cause\n\n## Behavior\n\n`Scheduler.add`, `Scheduler.ready`, and `Scheduler.schedule_retry` read the process-global wall clock directly. `ready` also shuffled ready tasks with the process-global random generator before sorting only by priority. Tasks with equal priority therefore kept a random order, and injected fake clocks did not control readiness or retry timestamps. Retry jitter likewise ignored the injected random source.\n\n## Root cause\n\nThe scheduler accepted `clock` and `random_source`, but production code bypassed both dependencies. It also had no total ordering for equal-priority tasks. This mixed real time/global randomness with test-controlled sources and made both ordering and retry eligibility vary by run.\n\n## Fix\n\n`flakyqueue/scheduler.py` now:\n\n- captures one `clock.now()` value when adding a task for both `created_at` and `run_at`;\n- uses `clock.now()` for readiness and retry scheduling;\n- uses the injected `random_source.random()` for retry jitter, retaining jitter behavior;\n- sorts ready tasks by priority descending, then creation time ascending, then task id ascending, giving a stable total order;\n- preserves explicitly supplied dependency objects even when they are false-y, while using system defaults only for `None`.\n\n## Verification\n\n- Required command attempted: `python -m pytest tests`; the environment has no `python` executable.\n- Equivalent interpreter attempted: `python3 -m pytest tests`; pytest is not installed in the environment.\n- `PYTHONPATH=. python3` manual assertions covering stable equal-priority ordering, injected add clock, injected retry jitter, and retry readiness: **PASS**.\n- `python3 -m compileall -q flakyqueue tests`: **PASS**.\n\nThe test files under `tests/` were not changed.\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-luna","usage":{"input":1657,"output":554,"cacheRead":20992,"cacheWrite":0,"reasoning":143,"totalTokens":23203,"cost":{"input":0.00033140000000000003,"output":0.0006648,"cacheRead":0.00041984,"cacheWrite":0,"total":0.00141604}},"stopReason":"toolUse","timestamp":1788172947391,"responseId":"resp_09f98ac3076243f0016a955a93a18487d286456cf869df9ffc","rawStopReason":"completed"},{"role":"toolResult","toolCallId":"call_zmO6ATFYrFsdfWekNGPwQqIm|fc_09f98ac3076243f0016a955a974fcc87d29a59c421c335209b","toolName":"write","content":[{"type":"text","text":"[out/root_cause.md#8BDB]\nSuccessfully wrote 1762 bytes to /workspace/out/root_cause.md"}],"details":{"resolvedPath":"/workspace/out/root_cause.md"},"isError":false,"timestamp":1788172958472},{"role":"assistant","content":[{"type":"thinking","thinking":"**Planning exact path write attempt**","thinkingSignature":"{\"id\":\"rs_09f98ac3076243f0016a955a9f9ea487d2a2ea7f8d1f1a839b\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"<PROVIDER_ENCRYPTED_PAYLOAD_REDACTED>\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Planning exact path write attempt**\"}]}"},{"type":"toolCall","id":"call_h6MsF6CcOn5zBYWLnZ2BCT3c|fc_09f98ac3076243f0016a955aa0325487d29e93d1ae26da3284","name":"bash","arguments":{"command":"target='<SOURCE_EVIDENCE_ROOT>/trials/123-085-flaky-test-root-cause-atomic-a03-r01/hb-work/atomic/gpt-5.6-luna/oc-bench-v2-085-flaky-test-root-cause-gpt-5.6-luna-20260831-064057-86ad9cb5/workspace/out/root_cause.md'; if mkdir -p \"$(dirname \"$target\")\" 2>/dev/null && cp /workspace/out/root_cause.md \"$target\" 2>/dev/null; then echo exact-output:PASS; else echo exact-output:UNAVAILABLE; fi","cwd":"/workspace","timeout":20}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-