ws1, orders2 == orders1)\nprint(rows2)\nprint('postcheck results:')\nfor r in con.executescript(postcheck) if False else []: pass\n# Execute postcheck statements individually, collecting result sets.\nfor stmt in [s.strip() for s in postcheck.split(';') if s.strip() and not s.strip().startswith('--')]:\n    try:\n        cur=con.execute(stmt)\n        if cur.description: print(cur.fetchall())\n    except Exception as e: print('POSTCHECK ERROR', e, stmt)\ncon.executescript(rollback)\nprint('rollback shape', con.execute('pragma table_info(users)').fetchall())\nprint('rollback counts', con.execute('select count(*) from users').fetchone(), con.execute('select count(*) from orders').fetchone())\nprint('rollback deps', con.execute('select id,user_id from orders order by id').fetchall())","language":"python","output":"after twice 6 4 True True\n[('u1', 'ada@example.com', 'active', '2024-01-02T10:00:00Z'), ('u2', 'lin@example.com', 'active', '2024-02-03T11:30:00Z'), ('u3', 'grace@example.com', 'active', '2024-03-04T09:15:00Z'), ('u4', 'ada+u4@example.com', 'active', '2023-12-01T08:00:00Z'), ('u5', 'missing+u5@example.invalid', 'active', '2023-11-05T12:00:00Z'), ('u6', 'missing+u6@example.invalid', 'active', '2023-10-06T07:45:00Z')]\npostcheck results:\n[('order_count', 4, 4)]\nPOSTCHECK ERROR near \"this\": syntax error this checks every original dependency.\nWITH expected(id, user_id) AS (\n    VALUES ('o1','u1'), ('o2','u4'), ('o3','u5'), ('o4','u6')\n)\nSELECT 'order_user_id_mismatches' AS check_name,\n       COUNT(*) AS observed, 0 AS expected\nFROM expected e\nLEFT JOIN orders o ON o.id = e.id AND o.user_id = e.user_id\nWHERE o.id IS NULL\n[('dirty_email_mismatches', 0, 0)]\n[('null_emails', 0, 0)]\n[('blank_emails', 0, 0)]\n[('duplicate_emails', 0, 0)]\n[('non_active_or_null_status', 0, 0)]\n[('users_status_not_null', 1, 1)]\n[('users_email_unique_constraint', 1, 1)]\nrollback shape [(0, 'id', 'TEXT', 0, None, 1), (1, 'email', 'TEXT', 0, None, 0), (2, 'name', 'TEXT', 