('__postcheck_null__', NULL, 'constraint probe', 'active', '2000-01-01T00:00:00Z');\nROLLBACK TO constraint_probes;\nINSERT INTO users (id, email, name, status, created_at)\nVALUES ('__postcheck_duplicate__', 'ada@example.com', 'constraint probe', 'active', '2000-01-01T00:00:00Z');\nROLLBACK TO constraint_probes;\nRELEASE constraint_probes;"},"intent":"Create postcheck queries"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-luna","usage":{"input":453,"output":621,"cacheRead":20224,"cacheWrite":0,"totalTokens":21298,"cost":{"input":0.0000906,"output":0.0007452,"cacheRead":0.00040448000000000003,"cacheWrite":0,"total":0.00124028}},"stopReason":"toolUse","timestamp":1788155994975,"responseId":"resp_0fbb107c215ce5d4016a95185bcc3887d2a031ea2e87e1c984","duration":12680.196984000002,"ttft":1598.8028049999994}}
