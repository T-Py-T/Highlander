ql in [\"insert into users(id,email,name,created_at) values ('x',null,'x','x')\", \"insert into users(id,email,name,created_at) values ('x','ada@example.com','x','x')\"]:\n try: c.execute(sql); print('BAD accepted')\n except Exception as e: print('expected',e)\nc.executescript(pathlib.Path(base+'/rollback.sql').read_text())\nprint('rollback cols', [r[1] for r in c.execute('pragma table_info(users)')])\nprint('rollback counts', c.execute('select count(*) from users').fetchone()[0], c.execute('select count(*) from orders').fetchone()[0])\nPY","timeout":30}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-luna","usage":{"input":1294,"output":426,"cacheRead":22016,"cacheWrite":0,"reasoning":15,"totalTokens":23736,"cost":{"input":0.0002588,"output":0.0005112,"cacheRead":0.00044032,"cacheWrite":0,"total":0.00121032}},"stopReason":"toolUse","timestamp":1788157398233,"responseId":"resp_070ce35a7ebde320016a951dd6c48c87d2a70fbdc9b9cf6d02","rawStopReason":"completed"},{"role":"toolResult","toolCallId":"call_a68RyhwH67OEnE6CbYFbdQ9u|fc_070ce35a7ebde320016a951dd860dc87d299aafca85f89f28d","toolName":"bash","content":[{"type":"text","text":"counts 6 4\nusers [('u1', 'ada@example.com', 'active', '2024-01-02T10:00:00Z'), ('u2', 'lin@example.com', 'active', '2024-02-03T11:30:00Z'), ('u3', 'grace@example.com', 'active', '2024-03-04T09:15:00Z'), ('u4', 'ada+u4@example.com', 'active', '2023-12-01T08:00:00Z'), ('u5', 'missing+u5@example.invalid', 'active', '2023-11-05T12:00:00Z'), ('u6', 'missing+u6@example.invalid', 'active', '2023-10-06T07:45:00Z')]\norders [('o1', 'u1'), ('o2', 'u4'), ('o3', 'u5'), ('o4', 'u6')]\nselect count(*) from users where email is null 0\nselect count(*) from users where trim(email)='' 0\nselect count(*) from users a join users b on a.email=b.email and a.id<b.id 0\nselect count(*) from users where status is null 0\nexpected NOT NULL constraint failed: users.email\nexpected UNIQUE constraint failed: users.email\nrollback cols ['id', 'e