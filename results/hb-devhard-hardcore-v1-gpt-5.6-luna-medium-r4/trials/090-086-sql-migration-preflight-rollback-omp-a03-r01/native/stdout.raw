{"type":"message_update","assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":";\n"}}
{"type":"message_update","assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":"+\n"}}
