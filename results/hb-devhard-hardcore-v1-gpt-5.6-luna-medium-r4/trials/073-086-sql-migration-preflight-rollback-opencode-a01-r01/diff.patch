@@ -0,0 +1,27 @@
+# Billing Migration Preflight
+
+## Source snapshot
+
+The supplied `schema.sql` contains:
+
+- `invoices`: 3 rows (`inv1`, `inv2`, `inv3`)
+- `payments`: 4 rows (`p1`, `p2`, `p3`, `p4`)
+- orphan payments: 1 (`p4`, referencing `missing-invoice`, amount 700)
+
+`p4` is a historical import issue and must be copied to `payment_orphans`, not deleted.
+
+## Preconditions
+
+Run the following checks against the target database before applying `migration.sql`:
+
+```sql
+SELECT COUNT(*) AS invoice_count FROM invoices;
+SELECT COUNT(*) AS payment_count FROM payments;
+SELECT p.id, p.invoice_id, p.amount_cents, p.created_at
+FROM payments AS p
+LEFT JOIN invoices AS i ON i.id = p.invoice_id
+WHERE i.id IS NULL;
+PRAGMA foreign_keys;
+```
+
+The migration takes an immediate write lock, keeps all DDL and data movement in one explicit transaction, preserves invoice timestamps, archives orphans, and enables foreign-key enforcement after commit.
--- a/in/billingdb/rollback.sql
+++ b/in/billingdb/rollback.sql
@@ -0,0 +1,37 @@
+-- Restore the pre-migration table shapes. Existing orphan rows are returned
+-- to payments because the old schema had no foreign-key constraint.
+PRAGMA foreign_keys = OFF;
+BEGIN IMMEDIATE;
+
+DROP TABLE IF EXISTS invoices_old;
+CREATE TABLE invoices_old (
+  id TEXT PRIMARY KEY,
+  customer_id TEXT NOT NULL,
+  total_cents INTEGER NOT NULL,
+  created_at TEXT NOT NULL
+);
+INSERT INTO invoices_old(id, customer_id, total_cents, created_at)
+SELECT id, customer_id, total_cents, created_at FROM invoices;
+DROP TABLE invoices;
+ALTER TABLE invoices_old RENAME TO invoices;
+
+DROP TABLE IF EXISTS payments_old;
+CREATE TABLE payments_old (
+  id TEXT PRIMARY KEY,
+  invoice_id TEXT NOT NULL,
+  amount_cents INTEGER NOT NULL,
+  created_at TEXT NOT NULL
+);
+INSERT OR IGNORE INTO payments_old(id, invoice_id, amount_cents, created_at)
+SELECT id, invoice_id, amount_cents, created_at FROM payments;
+INSERT OR IGNORE INTO payments_old(id, invoice_id, amount_cents, created_at)
+SELECT id, invoice_id, amount_cents, created_at FROM payment_orphans;
+DROP TABLE payments;
+ALTER TABLE payments_old RENAME TO payments;
+
+DROP TABLE IF EXISTS payment_orphans;
+DROP TABLE IF EXISTS billing_invoice_status;
+DROP TRIGGER IF EXISTS billing_invoice_status_sync;
+
+COMMIT;
+PRAGMA foreign_keys = ON;
