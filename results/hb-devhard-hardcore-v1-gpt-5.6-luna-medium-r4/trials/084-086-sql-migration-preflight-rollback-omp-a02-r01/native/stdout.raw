ULL,\n16:  created_at TEXT NOT NULL,\n17:  reason TEXT NOT NULL\n18:);\n19:INSERT OR IGNORE INTO payment_orphans (id, invoice_id, amount_cents, created_at, reason)\n20:SELECT p.id, p.invoice_id, p.amount_cents, p.created_at,\n21:       'invoice_id did not match an invoice during migration'\n22:FROM payments_old AS p\n23:LEFT JOIN invoices AS i ON i.id = p.invoice_id\n24:WHERE i.id IS NULL;\n25:\n26:-- Rebuild invoices with the new required column. Existing invoice fields,\n27:-- including historical created_at values, are copied unchanged.\n28:DROP TABLE IF EXISTS invoices_old;\n29:ALTER TABLE invoices RENAME TO invoices_old;\n30:CREATE TABLE invoices (\n31:  id TEXT PRIMARY KEY,\n32:  customer_id TEXT NOT NULL,\n33:  total_cents INTEGER NOT NULL,\n34:  created_at TEXT NOT NULL,\n35:  status TEXT NOT NULL DEFAULT 'open'\n36:);\n37:INSERT INTO invoices (id, customer_id, total_cents, created_at, status)\n38:SELECT id, customer_id, total_cents, created_at, 'open'\n39:FROM invoices_old;\n40:DROP TABLE invoices_old;\n41:\n42:-- Rebuild payments with an enforced parent reference. Quarantined rows are\n43:-- deliberately excluded; they remain intact in payment_orphans.\n44:CREATE TABLE payments (\n45:  id TEXT PRIMARY KEY,\n46:  invoice_id TEXT NOT NULL,\n47:  amount_cents INTEGER NOT NULL,\n48:  created_at TEXT NOT NULL,\n…\n50:);\n\n[Showing lines 6-48 of 59. Use :49 to continue]"}],"details":{"truncation":{"content":"\n-- Keep the source payments available while invoices and the FK are rebuilt.\nDROP TABLE IF EXISTS payments_old;\nALTER TABLE payments RENAME TO payments_old;\n\n-- Quarantine invalid historical payments before enforcing the new FK.\nCREATE TABLE IF NOT EXISTS payment_orphans (\n  id TEXT PRIMARY KEY,\n  invoice_id TEXT NOT NULL,\n  amount_cents INTEGER NOT NULL,\n  created_at TEXT NOT NULL,\n  reason TEXT NOT NULL\n);\nINSERT OR IGNORE INTO payment_orphans (id, invoice_id, amount_cents, created_at, reason)\nSELECT p.id, p.invoice_id, p.amount_cents, p.cr