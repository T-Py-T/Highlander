\n65:\n66:    def __iter__(self) -> Iterator[list[dict[str, Any]]]:\n67:        yield self.converted\n68:        yield self.errors\n69:\n70:    def __len__(self) -> int:\n71:        return 2\n72:\n73:    def __getitem__(self, index: int | slice) -> Any:\n74:        values = (self.converted, self.errors, self.warnings)\n75:        return values[index]\n76:\n77:\n78:def _required(mapping: Mapping[str, Any], key: str, path: str) -> Any:\n79:    if key not in mapping:\n80:        raise ConversionError(path, f\"missing required field: {path}\")\n81:    return mapping[key]\n82:\n83:\n84:def _as_mapping(value: Any, path: str) -> Mapping[str, Any]:\n85:    if not isinstance(value, Mapping):\n86:        raise ConversionError(path, f\"expected object at {path}\")\n87:    return value\n88:\n89:\n90:def _as_list(value: Any, path: str) -> list[Any]:\n91:    if not isinstance(value, list):\n92:        raise ConversionError(path, f\"expected array at {path}\")\n93:    return value\n94:\n95:\n96:def _as_integer(value: Any, path: str) -> int:\n97:    try:\n98:        return int(value)\n99:    except (TypeError, ValueError, OverflowError) as exc:\n100:        raise ConversionError(path, f\"expected integer at {path}\") from exc\n101:\n102:\n103:def _is_blank_shipping_method(value: Any) -> bool:\n104:    return value is None or (isinstance(value, str) and not value.strip())\n105:\n106:\n107:def _legacy_value(\n108:    payload: Mapping[str, Any], first: str, second: str, path: str\n109:) -> Any:\n110:    if first in payload:\n111:        return payload[first]\n112:    if second in payload:\n113:        return payload[second]\n114:    raise ConversionError(path, f\"missing required field: {path}\")\n115:\n116:\n117:def _convert_v2(payload: Mapping[str, Any]) -> dict[str, Any]:\n118:    converted = copy.deepcopy(dict(payload))\n119:    shipping = _as_mapping(converted[\"shipping\"], \"shipping\")\n120:    shipping_copy = dict(shipping)\n121:    if _is_blank_shipping_method(shipping_copy.get(\"method\")):\n122:        shipping_copy[\"method\"] = \"standard\"\n123:    converted[\"shipping\"] = shipping_copy\n124:    return converted\n125:\n126:\n127:def _convert_legacy(payload: Mapping[str, Any]) -> tuple[dict[str, Any], int, int]:\n128:    order_id = _legacy_value(payload, \"id\", \"order_ref\", \"id\")\n129:\n130:    if \"customer\" in payload:\n131:        customer = _as_mapping(payload[\"customer\"], \"customer\")\n132:        customer_id = _required(customer, \"id\", \"customer.id\")\n133:        customer_name = _required(customer, \"name\", \"customer.name\")\n134:    else:\n135:        customer_id = _required(payload, \"customer_id\", \"customer_id\")\n136:        customer_name = _required(payload, \"customer_name\", \"customer_name\")\n137:\n138:    item_key = \"items\" if \"items\" in payload else \"lines\"\n139:    raw_items = _as_list(\n140:        _legacy_value(payload, \"items\", \"lines\", item_key), item_key\n141:    )\n142:    line_items: list[dict[str, Any]] = []\n143:    for index, raw_item in enumerate(raw_items):\n144:        item_path = f\"{item_key}[{index}]\"\n145:        item = _as_mapping(raw_item, item_path)\n146:        sku = _required(item, \"sku\", f\"{item_path}.sku\")\n147:        quantity = _as_integer(\n148:            _required(item, \"qty\", f\"{item_path}.qty\"), f\"{item_path}.qty\"\n149:        )\n150:        price_key = \"price_cents\" if \"price_cents\" in item else \"unit_price_cents\"\n151:        price = _as_integer(\n152:            _required(item, price_key, f\"{item_path}.{price_key}\"),\n153:            f\"{item_path}.{price_key}\",\n154:        )\n155:        line_items.append(\n156:            {\"sku\": copy.deepcopy(sku), \"quantity\": quantity, \"unitPriceCents\": price}\n157:        )\n158:\n159:    address_key = \"ship_to\" if \"ship_to\" in payload else \"shipTo\"\n160:    address = _as_mapping(\n161:        _legacy_value(payload, \"ship_to\", \"shipTo\", address_key), address_key\n162:    )\n163:    country = _required(address, \"country\", f\"{address_key}.country\")\n164:    if \"postal\" in address:\n165:        postal_code = address[\"postal\"]\n166:    elif \"postalCode\" in address:\n167:        postal_code = address[\"postalCode\"]\n168:    elif \"postal_code\" in address:\n169:        postal_code = address[\"postal_code\"]\n170:    else:\n171:        raise ConversionError(\n172:            f\"{address_key}.postalCode\",\n173:            f\"missing required field: {address_key}.postalCode\",\n174:        )\n175:\n176:    if \"shipping_method\" in payload:\n177:        shipping_method = payload[\"shipping_method\"]\n178:    else:\n179:        shipping_method = payload.get(\"shipping\")\n180:    if _is_blank_shipping_method(shipping_method):\n181:        shipping_method = \"standard\"\n182:\n183:    unknown_fields: dict[str, Any] = {}\n184:    pii_dropped_count = 0\n185:    for key, value in payload.items():\n186:        if key in PII_KEYS:\n187:            pii_dropped_count += 1\n188:        elif key not in _LEGACY_KEYS:\n189:            unknown_fields[key] = copy.deepcopy(value)\n190:\n191:    metadata: dict[str, Any] = {\"source\": \"legacy-v1\"}\n192:    if unknown_fields:\n193:        metadata[\"unknownFields\"] = unknown_fields\n194:\n195:    converted = {\n196:        \"orderId\": copy.deepcopy(order_id),\n197:        \"buyer\": {\n198:            \"id\": copy.deepcopy(customer_id),\n199:            \"displayName\": copy.deepcopy(customer_name),\n200:        },\n201:        \"lineItems\": line_items,\n202:        \"shipping\": {\n203:            \"method\": copy.deepcopy(shipping_method),\n204:            \"address\": {\n205:                \"country\": copy.deepcopy(country),\n206:                \"postalCode\": copy.deepcopy(postal_code),\n207:            },\n208:        },\n209:        \"metadata\": metadata,\n210:    }\n211:    return converted, pii_dropped_count, len(unknown_fields)\n212:\n213:\n214:def _convert_order_with_counts(\n215:    payload: Mapping[str, Any],\n216:) -> tuple[dict[str, Any], int, int]:\n217:    if not isinstance(payload, Mapping):\n218:        raise ConversionError(\"\", \"expected order payload object\")\n219:\n220:    v2_keys = {\"orderId\", \"buyer\", \"lineItems\", \"shipping\", \"metadata\"}\n221:    if v2_keys.issubset(payload):\n222:        return _convert_v2(payload), 0, 0\n223:    return _convert_legacy(payload)\n224:\n225:\n226:def convert_order(payload: Mapping[str, Any]) -> dict[str, Any]:\n227:    \"\"\"Convert a supported legacy order payload to the public v2 shape.\"\"\"\n228:\n229:    converted, _, _ = _convert_order_with_counts(payload)\n230:    return converted\n231:\n232:\n233:def _write_audit(audit: Mapping[str, int]) -> None:\n234:    _AUDIT_PATH.write_text(json.dumps(dict(audit), sort_keys=True) + \"\\n\", encoding=\"utf-8\")\n235:\n236:\n237:def convert_many(payloads: Iterable[Mapping[str, Any]]) -> ConversionBatchResult:\n238:    \"\"\"Convert orders in sequence, retaining successes after individual errors.\"\"\"\n239:\n240:    converted: list[dict[str, Any]] = []\n241:    errors: list[dict[str, Any]] = []\n242:    warnings: list[dict[str, Any]] = []\n243:    pii_dropped_count = 0\n244:    unknown_fields_count = 0\n245:\n246:    for index, payload in enumerate(payloads):\n247:        try:\n248:            order, pii_count, unknown_count = _convert_order_with_counts(payload)\n249:        except ConversionError as exc:\n250:            errors.append({\"index\": index, \"path\": exc.path, \"error\": str(exc)})\n251:        except Exception as exc:\n252:            errors.append({\"index\": index, \"path\": \"\", \"error\": str(exc)})\n253:        else:\n254:            converted.append(order)\n255:            pii_dropped_count += pii_count\n256:            unknown_fields_count += unknown_count\n257:\n258:    _write_audit(\n259:        {\n260:            \"converted_count\": len(converted),\n261:            \"error_count\": len(errors),\n262:            \"wa