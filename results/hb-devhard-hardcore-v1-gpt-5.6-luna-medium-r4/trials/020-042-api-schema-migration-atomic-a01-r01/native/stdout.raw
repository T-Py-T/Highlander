warning_count\": len(warnings),\n263:            \"pii_dropped_count\": pii_dropped_count,\n264:            \"unknown_fields_count\": unknown_fields_count,\n265:        }\n266:    )\n267:    return ConversionBatchResult(converted, errors, warnings)\n268:\n269:\n270:def summarize_order(v2_payload: Mapping[str, Any]) -> str:\n271:    return f\"{v2_payload['orderId']}:{len(v2_payload['lineItems'])}\"\n272:\n273:\n274:def _main(argv: list[str]) -> int:\n275:    if len(argv) != 3:\n276:        print(f\"usage: {argv[0]} input.jsonl output.json\", file=sys.stderr)\n277:        return 2\n278:\n279:    input_path = Path(argv[1])\n280:    output_path = Path(argv[2])\n281:    payloads: list[Any] = []\n282:    with input_path.open(encoding=\"utf-8\") as source:\n283:        for line_number, line in enumerate(source, 1):\n284:            if not line.strip():\n285:                continue\n286:            try:\n287:                payloads.append(json.loads(line))\n288:            except json.JSONDecodeError as exc:\n289:                print(f\"{input_path}:{line_number}: {exc}\", file=sys.stderr)\n290:                return 1\n291:\n292:    result = convert_many(payloads)\n293:    with output_path.open(\"w\", encoding=\"utf-8\") as destination:\n294:        for order in result.converted:\n295:            destination.write(json.dumps(order, separators=(\",\", \":\")) + \"\\n\")\n296:\n297:    for error in result.errors:\n298:        print(\n299:            f\"record {error['index']} {error['path']}: {error['error']}\",\n300:            file=sys.stderr,\n301:        )\n302:    return 1 if result.errors else 0\n303:\n304:\n305:if __name__ == \"__main__\":\n306:    raise SystemExit(_main(sys.argv))"}],"details":{"meta":{"source":"/workspace/in/schema_migration/client.py","sourcePath":"/workspace/in/schema_migration/client.py"}},"isError":false,"timestamp":1788150265161}}
