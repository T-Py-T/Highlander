{"type":"tool_use","timestamp":1788173202147,"sessionID":"ses_fa8934456ffeMwhVt4xNG16hV3","part":{"type":"tool","tool":"bash","callID":"call_IAOs2wsg96aqmNOtDa5DnGjy","state":{"status":"completed","input":{"command":"python3 - <<'PY'\nfrom flakyqueue.scheduler import Scheduler\n\nclass FakeClock:\n    def __init__(self, value):\n        self.value = value\n    def now(self):\n        return self.value\n\nclass FakeRandom:\n    def __init__(self, values):\n        self.values = list(values)\n    def random(self):\n        return self.values.pop(0)\n\nclock = FakeClock(1000.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.3]))\nscheduler.add('task-b', 5)\nscheduler.add('task-a', 5)\nscheduler.add('task-c', 9)\nassert [task.id for task in scheduler.ready()] == ['task-c', 'task-a', 'task-b']\nassert [task.id for task in scheduler.ready()] == ['task-c', 'task-a', 'task-b']\n\ntask = scheduler.add('task-retry', 3)\nretry = scheduler.schedule_retry(task, base_delay=10.0)\nassert retry.attempts == 1\nassert retry.run_at == 1010.3\n\nclock = FakeClock(200.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.5]))\ntask = scheduler.add('task-wait', 3)\nretry = scheduler.schedule_retry(task, base_delay=10.0)\nassert scheduler.ready() == []\nclock.value = retry.run_at\nassert [task.id for task in scheduler.ready()] == ['task-wait']\nprint('direct test assertions: 3 passed')\nPY\npython3 -m compileall -q flakyqueue","workdir":"/workspace/in/flakyqueue","timeout":120000},"output":"direct test assertions: 3 passed\n","metadata":{"output":"direct test assertions: 3 passed\n","exit":0,"truncated":false},"title":"python3 - <<'PY'\nfrom flakyqueue.scheduler import Scheduler\n\nclass FakeClock:\n    def __init__(self, value):\n        self.value = value\n    def now(self):\n        return self.value\n\nclass FakeRandom:\n    def __init__(self, values):\n        self.values = list(values)\n    def random(self):\n        return self.values.pop(0)\n\nclock = FakeClock(1000.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.3]))\nscheduler.add('task-b', 5)\nscheduler.add('task-a', 5)\nscheduler.add('task-c', 9)\nassert [task.id for task in scheduler.ready()] == ['task-c', 'task-a', 'task-b']\nassert [task.id for task in scheduler.ready()] == ['task-c', 'task-a', 'task-b']\n\ntask = scheduler.add('task-retry', 3)\nretry = scheduler.schedule_retry(task, base_delay=10.0)\nassert retry.attempts == 1\nassert retry.run_at == 1010.3\n\nclock = FakeClock(200.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.5]))\ntask = scheduler.add('task-wait', 3)\nretry = scheduler.schedule_retry(task, base_delay=10.0)\nassert scheduler.ready() == []\nclock.value = retry.run_at\nassert [task.id for task in scheduler.ready()] == ['task-wait']\nprint('direct test assertions: 3 passed')\nPY\npython3 -m compileall -q flakyqueue","time":{"start":1788173202116,"end":1788173202142}},"metadata":{"openai":{"itemId":"fc_0687865b4c38707a016a955b8aec2087d282a2395dbe4ced13"}},"id":"prt_0576d96dd001l2SJy4LYI3n0Ug","sessionID":"ses_fa8934456ffeMwhVt4xNG16hV3","messageID":"msg_0576d9228001sBQAOOpvYy9d5T"}}
