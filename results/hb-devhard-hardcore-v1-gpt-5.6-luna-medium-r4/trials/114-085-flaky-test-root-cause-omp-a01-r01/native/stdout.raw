scheduler.ready()] == ['task-c', 'task-a', 'task-b']\nassert scheduler.add('task-1', 1).run_at == 1000.0\n\nclock = FakeClock(200.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.25]))\ntask = scheduler.add('task-retry', 3)\nretry = scheduler.schedule_retry(task, base_delay=10.0)\nassert retry.attempts == 1 and retry.run_at == 210.25\n\nclock = FakeClock(200.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.5]))\ntask = scheduler.add('task-wait', 3)\nretry = scheduler.schedule_retry(task, base_delay=10.0)\nassert scheduler.ready() == []\nclock.value = retry.run_at\nassert [task.id for task in scheduler.ready()] == ['task-wait']\nprint('all scheduler contract checks passed')\nPY\npython3 -m compileall -q flakyqueue","cwd":"/workspace/in/flakyqueue","timeout":30},"intent":"Run deterministic scheduler checks"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-luna","usage":{"input":820,"output":450,"cacheRead":21248,"cacheWrite":0,"totalTokens":22518,"reasoningTokens":12,"cost":{"input":0.000164,"output":0.00054,"cacheRead":0.00042496,"cacheWrite":0,"total":0.00112896}},"stopReason":"toolUse","timestamp":1788171121227,"responseId":"resp_00f6826facb8103b016a955371700487d2abf0589167cbfc3b","duration":8929.480751000003,"ttft":801.5193020000079},{"role":"toolResult","toolCallId":"call_po6tuf6oIdSWonYqk2iZ6VE6|fc_00f6826facb8103b016a9553726b1c87d2b446de269537885f","toolName":"bash","content":[{"type":"text","text":"all scheduler contract checks passed\n\n\nWall time: 0.06 seconds"}],"details":{"timeoutSeconds":30,"wallTimeMs":61.15171200000623},"isError":false,"timestamp":1788171130225},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_00f6826facb8103b016a95537b081887d2bedac186cfdca6fc\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"<PROVIDER_ENCRYPTED_PAYLOAD_REDACTED>\",\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"862107da-17b0-4665-