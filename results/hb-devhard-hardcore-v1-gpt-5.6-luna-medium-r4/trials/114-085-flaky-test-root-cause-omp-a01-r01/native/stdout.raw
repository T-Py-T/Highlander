etry(self, task: Task, base_delay: float = 5.0) -> Task:\n        jitter = random.random()\n        updated = replace(task, attempts=task.attempts + 1, run_at=time.time() + base_delay + jitter)\n        self.store.save(updated)\n        return updated\n","newText":"from __future__ import annotations\n\nimport random\nimport time\nfrom dataclasses import dataclass, replace\n\nfrom flakyqueue.clock import SystemClock\nfrom flakyqueue.store import MemoryStore\n\n\n@dataclass(frozen=True)\nclass Task:\n    id: str\n    priority: int\n    created_at: float\n    attempts: int = 0\n    run_at: float = 0.0\n\n\nclass Scheduler:\n    def __init__(self, clock=None, store=None, random_source=None) -> None:\n        self.clock = clock if clock is not None else SystemClock()\n        self.store = store if store is not None else MemoryStore()\n        self.random_source = random_source if random_source is not None else random\n\n    def add(self, task_id: str, priority: int) -> Task:\n        now = self.clock.now()\n        task = Task(id=task_id, priority=priority, created_at=now, run_at=now)\n        self.store.save(task)\n        return task\n\n    def ready(self):\n        now = self.clock.now()\n        items = [task for task in self.store.all() if task.run_at <= now]\n        return sorted(items, key=lambda task: (-task.priority, task.id))\n\n    def schedule_retry(self, task: Task, base_delay: float = 5.0) -> Task:\n        jitter = self.random_source.random()\n        updated = replace(\n            task,\n            attempts=task.attempts + 1,\n            run_at=self.clock.now() + base_delay + jitter,\n        )\n        self.store.save(updated)\n        return updated\n\n    def add(self, task_id: str, priority: int) -> Task:\n        task = Task(id=task_id, priority=priority, created_at=time.time(), run_at=time.time())\n        self.store.save(task)\n        return task\n\n    def ready(self):\n        now = time.time()\n        items = [task for task in self.store.all() if task.run_at <= now]\n        random.shuffle(items)\n        return sorted(items, key=lambda task: task.priority, reverse=True)\n\n    def schedule_retry(self, task: Task, base_delay: float = 5.0) -> Task:\n        jitter = random.random()\n        updated = replace(task, attempts=task.attempts + 1, run_at=time.time() + base_delay + jitter)\n        self.store.save(updated)\n        return updated\n"},"isError":false,"timestamp":1788171113146},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_00f6826facb8103b016a95536a1ca487d2a30a046d284fd44f\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"<PROVIDER_ENCRYPTED_PAYLOAD_REDACTED>\",\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"862107da-17b0-4665-ac38-7fb219b5d8da\"},\"summary\":[],\"metadata\":{\"turn_id\":\"862107da-17b0-4665-ac38-7fb219b5d8da\"}}"},{"type":"toolCall","id":"call_pHuab8eKiRpGWY9R8N7VqKv7|fc_00f6826facb8103b016a95536ae0a887d2b4c27fc7e6efa2f0","name":"read","arguments":{"i":"Inspect edited scheduler","path":"/workspace/in/flakyqueue/flakyqueue/scheduler.py"},"intent":"Inspect edited scheduler"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-luna","usage":{"input":1605,"output":69,"cacheRead":19200,"cacheWrite":0,"totalTokens":20874,"reasoningTokens":33,"cost":{"input":0.00032100000000000005,"output":0.0000828,"cacheRead":0.000384,"cacheWrite":0,"total":0.0007878000000000001}},"stopReason":"toolUse","timestamp":1788171113172,"responseId":"resp_00f6826facb8103b016a9553696d4887d2981cfc6940a24a50","duration":2288.101650000004,"ttft":1077.525112000003},{"role":"toolResult","toolCallId":"call_pHuab8eKiRpGWY9R8N7VqKv7|fc_00f6826facb8103b016a95536ae0a887d2b4c27fc7e6efa2f0","toolName":"read","content":[{"type":"text","text":"[scheduler.py#6B48]\n1:from __future__ import annotations\n2:\n3:import random\n4:import time\n5:from dataclasses import dataclass, replace\n6:\n7:from flakyqueue.clock import Sy