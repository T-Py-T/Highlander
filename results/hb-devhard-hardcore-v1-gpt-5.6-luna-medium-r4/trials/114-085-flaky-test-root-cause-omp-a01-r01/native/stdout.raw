{"type":"message_update","assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"call_po6tuf6oIdSWonYqk2iZ6VE6|fc_00f6826facb8103b016a9553726b1c87d2b446de269537885f","name":"bash","arguments":{"i":"Run deterministic scheduler checks","command":"python3 - <<'PY'\nfrom flakyqueue.scheduler import Scheduler\n\nclass FakeClock:\n    def __init__(self, value): self.value = value\n    def now(self): return self.value\n\nclass FakeRandom:\n    def __init__(self, values): self.values = list(values)\n    def random(self): return self.values.pop(0)\n\nclock = FakeClock(1000.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.3]))\nscheduler.add('task-b', 5)\nscheduler.add('task-a', 5)\nscheduler.add('task-c', 9)\nassert [task.id for task in scheduler.ready()] == ['task-c', 'task-a', 'task-b']\nassert [task.id for task in scheduler.ready()] == ['task-c', 'task-a', 'task-b']\nassert scheduler.add('task-1', 1).run_at == 1000.0\n\nclock = FakeClock(200.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.25]))\ntask = scheduler.add('task-retry', 3)\nretry = scheduler.schedule_retry(task, base_delay=10.0)\nassert retry.attempts == 1 and retry.run_at == 210.25\n\nclock = FakeClock(200.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.5]))\ntask = scheduler.add('task-wait', 3)\nretry = scheduler.schedule_retry(task, base_delay=10.0)\nassert scheduler.ready() == []\nclock.value = retry.run_at\nassert [task.id for task in scheduler.ready()] == ['task-wait']\nprint('all scheduler contract checks passed')\nPY\npython3 -m compileall -q flakyqueue","cwd":"/workspace/in/flakyqueue","timeout":30}}}}
