egister_routes\\\", \\\"to\\\": \\\"minisvc.api.handlers:create_order\\\", \\\"type\\\": \\\"calls\\\"},\\n    {\\\"from\\\": \\\"minisvc.api.routes:register_routes\\\", \\\"to\\\": \\\"minisvc.api.handlers:get_order\\\", \\\"type\\\": \\\"calls\\\"},\\n    {\\\"from\\\": \\\"minisvc.api.handlers:create_order\\\", \\\"to\\\": \\\"minisvc.models:Order\\\", \\\"type\\\": \\\"instantiates\\\"},\\n    {\\\"from\\\": \\\"minisvc.api.handlers:create_order\\\", \\\"to\\\": \\\"minisvc.storage.repo:OrderRepository.save\\\", \\\"type\\\": \\\"calls\\\"},\\n    {\\\"from\\\": \\\"minisvc.api.handlers:create_order\\\", \\\"to\\\": \\\"minisvc.audit:order_event\\\", \\\"type\\\": \\\"calls\\\"},\\n    {\\\"from\\\": \\\"minisvc.api.handlers:get_order\\\", \\\"to\\\": \\\"minisvc.storage.repo:OrderRepository.get\\\", \\\"type\\\": \\\"calls\\\"},\\n    {\\\"from\\\": \\\"minisvc.api.handlers:get_order\\\", \\\"to\\\": \\\"minisvc.audit:order_event\\\", \\\"type\\\": \\\"calls\\\"},\\n    {\\\"from\\\": \\\"minisvc.storage.repo:OrderRepository.save\\\", \\\"to\\\": \\\"SQLite orders table\\\", \\\"type\\\": \\\"persists_to\\\"},\\n    {\\\"from\\\": \\\"minisvc.storage.repo:OrderRepository.get\\\", \\\"to\\\": \\\"SQLite orders table\\\", \\\"type\\\": \\\"reads_config\\\"}\\n  ],\\n  \\\"key_functions\\\": [\\n    {\\\"identifier\\\": \\\"minisvc.cli:main\\\", \\\"description\\\": \\\"Loads settings, constructs OrderRepository, initializes schema, prints readiness, and returns 0; it does not start an HTTP server.\\\"},\\n    {\\\"identifier\\\": \\\"minisvc.config:load_settings\\\", \\\"description\\\": \\\"Returns Settings(database_path, readonly) from environment values, defaulting to orders.sqlite and false.\\\"},\\n    {\\\"identifier\\\": \\\"minisvc.api.routes:register_routes\\\", \\\"description\\\": \\\"Binds POST /orders and GET /orders/<order_id> using lambdas that delegate to handlers.\\\"},\\n    {\\\"identifier\\\": \\\"minisvc.api.handlers:create_order\\\", \\\"description\\\": \\\"Reads required payload keys, converts total_cents with int(), saves the Order, and returns a created response with an in-memory event.\\\"},\\n    {\\\"identifier\\\": \\\"minisvc.api.handlers:get_order\\\", \\\"description\\\": \\\"Looks up an order and returns either missing or ok plus a read event.\\\"},\\n    {\\\"identifier\\\": \\\"minisvc.storage.repo:OrderRepository.init_schema\\\", \\\"description\\\": \\\"Creates the orders table if absent using a short-lived SQLite connection.\\\"},\\n    {\\\"identifier\\\": \\\"minisvc.storage.repo:OrderRepository.save\\\", \\\"description\\\": \\\"Inserts one order with parameterized SQL; duplicate IDs or other SQLite errors propagate.\\\"},\\n    {\\\"identifier\\\": \\\"minisvc.storage.repo:OrderRepository.get\\\", \\\"description\\\": \\\"Queries one order by parameterized order_id and reconstructs Order or returns None.\\\"},\\n    {\\\"identifier\\\": \\\"minisvc.audit:order_event\\\", \\\"description\\\": \\\"Formats an order action event as a dictionary; it performs no persistence.\\\"}\\n  ],\\n  \\\"runtime_flows\\\": [\\n    {\\n      \\\"name\\\": \\\"CLI startup\\\",\\n      \\\"steps\\\": [\\n        \\\"Console script minisvc resolves to minisvc.cli:main.\\\",\\n        \\\"main reads os.environ via config.load_settings.\\\",\\n        \\\"main constructs OrderRepository(settings.database_path).\\\",\\n        \\\"main calls repo.init_schema(), creating SQLite orders if needed.\\\",\\n        \\\"main prints the database path and returns 0; no HTTP listener is launched by this function.\\\"\\n      ]\\n    },\\n    {\\n      \\\"name\\\": \\\"HTTP create-order\\\",\\n      \\\"steps\\\": [\\n        \\\"An application calls register_routes(app, repo).\\\",\\n        \\\"POST /orders dispatches to create_order(payload, repo) through a registered lambda.\\\",\\n        \\\"create_order reads order_id, customer, and total_cents and converts total_cents to int.\\\",\\n        \\\"create_order constructs Order and calls OrderRepository.save, inserting into SQLite orders.\\\",\\n        \\\"create_order calls order_event(order, 'created') and returns status, order_id, and the event; no audit row is written.\\\"\\n      ]\\n    }\\n  ]\\n}\\n\"}"}}], "timestamp": "2026-08-31T03:45:00.538040"}
