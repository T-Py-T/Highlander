{"type":"tool_execution_end","toolCallId":"call_5dRlzqk1lzNymbC2nYzCFctS|fc_0b7bf0eb711d5210016a951943eec887d2b4e8328398827bf4","toolName":"read","result":{"content":[{"type":"text","text":"[in/db/postcheck.sql#B0C1]\n1:-- Run after migration. Every query should return the stated result.\n2:\n3:-- Row counts: 6 users and 4 orders for the supplied preflight data.\n4:SELECT 'users_count' AS check_name, COUNT(*) AS actual, 6 AS expected\n5:FROM users;\n6:SELECT 'orders_count' AS check_name, COUNT(*) AS actual, 4 AS expected\n7:FROM orders;\n8:\n9:-- Every order still points to an existing user; dirty-user dependents remain.\n10:SELECT 'orphan_orders' AS check_name, COUNT(*) AS actual\n11:FROM orders o LEFT JOIN users u ON u.id = o.user_id\n12:WHERE u.id IS NULL;\n13:SELECT 'dirty_user_orders' AS check_name, GROUP_CONCAT(id, ',') AS order_ids\n14:FROM orders\n15:WHERE user_id IN ('u4', 'u5', 'u6');\n16:\n17:-- Deterministic cleanup values; mismatch count must be zero.\n18:SELECT 'dirty_email_mismatches' AS check_name, COUNT(*) AS actual\n19:FROM users\n20:WHERE (id = 'u4' AND email <> 'ada+u4@example.com')\n21:   OR (id = 'u5' AND email <> 'missing+u5@example.invalid')\n22:   OR (id = 'u6' AND email <> 'missing+u6@example.invalid');\n23:SELECT id, email FROM users WHERE id IN ('u4', 'u5', 'u6') ORDER BY id;\n24:\n25:-- Constraint checks: both counts must be zero.\n26:SELECT 'null_emails' AS check_name, COUNT(*) AS actual\n27:FROM users WHERE email IS NULL;\n28:SELECT 'blank_emails' AS check_name, COUNT(*) AS actual\n29:FROM users WHERE trim(email) = '';\n30:SELECT 'duplicate_emails' AS check_name, COUNT(*) AS actual\n31:FROM (SELECT email FROM users GROUP BY email HAVING COUNT(*) > 1);\n32:\n33:-- Schema checks: users.email is NOT NULL and UNIQUE; status is NOT NULL with\n34:-- an active default (table_info columns: name, type, notnull, dflt_value).\n35:SELECT name, type, \"notnull\", dflt_value\n36:FROM pragma_table_info('users')\n37:WHERE name IN ('email', 'status')\n38:ORDER BY name;\n39:SELECT 'email_unique_index_count' AS check_name, COUNT(*) AS actual\n40:FROM pragma_index_list('users')\n41:WHERE [unique] = 1;\n42:\n43:-- Foreign-key integrity.\n44:PRAGMA foreign_key_check;"}],"details":{"meta":{"source":"/workspace/in/db/postcheck.sql","sourcePath":"/workspace/in/db/postcheck.sql"}}},"isError":false}
