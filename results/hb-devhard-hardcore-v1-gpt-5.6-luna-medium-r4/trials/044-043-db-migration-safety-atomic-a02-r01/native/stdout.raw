{"type":"tool_execution_end","toolCallId":"call_ln9YYdLDKrMxF4zGJJke2R88|fc_0b7bf0eb711d5210016a95193c22c087d2be6638915eb50e64","toolName":"read","result":{"content":[{"type":"text","text":"[in/db/postcheck.sql#8452]\n1:-- Run after migration. Every query should return the stated result.\n2:\n3:-- Row counts: 6 users and 4 orders for the supplied preflight data.\n4:SELECT 'users_count' AS check_name, COUNT(*) AS actual, 6 AS expected\n5:FROM users;\n6:SELECT 'orders_count' AS check_name, COUNT(*) AS actual, 4 AS expected\n7:FROM orders;\n8:\n9:-- Every order still points to an existing user; dirty-user dependents remain.\n10:SELECT 'orphan_orders' AS check_name, COUNT(*) AS actual\n11:FROM orders o LEFT JOIN users u ON u.id = o.user_id\n12:WHERE u.id IS NULL;\n13:SELECT 'dirty_user_orders' AS check_name, GROUP_CONCAT(id, ',') AS order_ids\n14:FROM orders\n15:WHERE user_id IN ('u4', 'u5', 'u6');\n16:\n17:-- Deterministic cleanup values.\n18:SELECT id, email FROM users WHERE id IN ('u4', 'u5', 'u6') ORDER BY id;\n19:\n20:-- Constraint checks: both counts must be zero.\n21:SELECT 'null_emails' AS check_name, COUNT(*) AS actual\n22:FROM users WHERE email IS NULL;\n23:SELECT 'blank_emails' AS check_name, COUNT(*) AS actual\n24:FROM users WHERE trim(email) = '';\n25:SELECT 'duplicate_emails' AS check_name, COUNT(*) AS actual\n26:FROM (SELECT email FROM users GROUP BY email HAVING COUNT(*) > 1);\n27:\n28:-- Schema checks: users.email is NOT NULL and UNIQUE; status is NOT NULL with\n29:-- an active default (table_info columns: name, type, notnull, dflt_value).\n30:SELECT name, type, \"notnull\", dflt_value\n31:FROM pragma_table_info('users')\n32:WHERE name IN ('email', 'status')\n33:ORDER BY name;\n34:SELECT 'email_unique_index_count' AS check_name, COUNT(*) AS actual\n35:FROM pragma_index_list('users')\n36:WHERE [unique] = 1;\n37:\n38:-- Foreign-key integrity.\n39:PRAGMA foreign_key_check;"}],"details":{"meta":{"source":"/workspace/in/db/postcheck.sql","sourcePath":"/workspace/in/db/postcheck.sql"}}},"isError":false}
