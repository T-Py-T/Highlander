uage":"py","code":"import sqlite3, pathlib, tempfile, os\nbase=pathlib.Path('/workspace/in/db')\ndbpath='/tmp/migration-check.db'\ntry: os.remove(dbpath)\nexcept FileNotFoundError: pass\ncon=sqlite3.connect(dbpath)\ncon.executescript((base/'schema.sql').read_text())\ncon.executescript((base/'migration.sql').read_text())\nprint('after migration', con.execute(\"select id,email,status,created_at from users order by id\").fetchall())\nprint('orders', con.execute('select id,user_id from orders order by id').fetchall())\nprint('fk', con.execute('pragma foreign_key_check').fetchall())\ncon.executescript((base/'migration.sql').read_text())\nprint('after rerun counts', con.execute('select count(*) from users').fetchone(), con.execute('select count(*) from orders').fetchone())\nprint('after rerun', con.execute(\"select id,email,status from users order by id\").fetchall())\ncon.executescript((base/'rollback.sql').read_text())\nprint('rollback columns', con.execute('pragma table_info(users)').fetchall())\nprint('rollback counts', con.execute('select count(*) from users').fetchone(), con.execute('select count(*) from orders').fetchone())\nprint('rollback fk', con.execute('pragma foreign_key_check').fetchall())\ncon.close()","title":"Smoke test SQLite migration","timeout":20,"reset":true},"intent":"Smoke test SQLite migration"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.6-luna","usage":{"input":345,"output":378,"cacheRead":22272,"cacheWrite":0,"totalTokens":22995,"reasoningTokens":30,"cost":{"input":0.00006900000000000001,"output":0.00045359999999999997,"cacheRead":0.00044544,"cacheWrite":0,"total":0.0009680400000000001}},"stopReason":"toolUse","timestamp":1788157855080,"responseId":"resp_0c7af19cfa8a603f016a951f9f587887d2aaaa543ef6ad10c5","duration":7510.917155000003,"ttft":661.3940580000053},{"role":"toolResult","toolCallId":"call_fe6ay10DBxGpw2B20GCCwGZR|fc_0c7af19cfa8a603f016a951fa06d8887d2bf15ac79016b958e","toolName":"eval","content":[{"type":"t