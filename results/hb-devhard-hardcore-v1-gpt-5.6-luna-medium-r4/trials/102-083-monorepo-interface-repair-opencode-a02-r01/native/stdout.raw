{"type":"tool_use","timestamp":1788168029353,"sessionID":"ses_fa8e24490ffe6DSQasHP6TF9R8","part":{"type":"tool","tool":"bash","callID":"call_zFHQ8KdLk6aGWip6op3chPWz","state":{"status":"completed","input":{"command":"git diff -- packages/orders/orders/adapter.py packages/orders/orders/service.py && git status --short","workdir":"/workspace/in/shopmono","timeout":120000},"output":"diff --git a/packages/orders/orders/adapter.py b/packages/orders/orders/service.py\nindex 4aa0f88..c738065 100644\n--- a/packages/orders/orders/adapter.py\n+++ b/packages/orders/orders/service.py\n@@ -1,27 +1,20 @@\n from __future__ import annotations\n \n+from orders.adapter import currency, price_cents\n \n-def price_cents(product) -> int:\n-    \"\"\"Return cents from either the current or legacy catalog shape.\"\"\"\n-    if isinstance(product, dict):\n-        if \"price_cents\" in product:\n-            return int(product[\"price_cents\"])\n-        return int(product[\"price\"].amount_cents)\n \n-    price = getattr(product, \"price\", None)\n-    if price is not None:\n-        return int(price.amount_cents)\n-    return int(product.price_cents)\n-\n-\n-def currency(product) -> str:\n-    if isinstance(product, dict):\n-        price = product.get(\"price\")\n-        if price is not None:\n-            return price.currency\n-        return product.get(\"currency\", \"USD\")\n-\n-    price = getattr(product, \"price\", None)\n-    if price is not None:\n-        return price.currency\n-    return getattr(product, \"currency\", \"USD\")\n+def price_order(lines: list[dict], catalog: dict) -> dict:\n+    total = 0\n+    order_currency = None\n+    for line in lines:\n+        product = catalog[line[\"sku\"]]\n+        line_currency = currency(product)\n+        if order_currency is None:\n+            order_currency = line_currency\n+        elif order_currency != line_currency:\n+            raise ValueError(\n+                f\"mixed currencies are not supported in one order: \"\n+                f\"{order_currency} and {line_currency}\"\n+            )\n+        total += price_cents(product) * int(line[\"quantity\"])\n+    return {\"total_cents\": total, \"currency\": order_currency or \"USD\"}\n","metadata":{"output":"diff --git a/packages/orders/orders/adapter.py b/packages/orders/orders/service.py\nindex 4aa0f88..c738065 100644\n--- a/packages/orders/orders/adapter.py\n+++ b/packages/orders/orders/service.py\n@@ -1,27 +1,20 @@\n from __future__ import annotations\n \n+from orders.adapter import currency, price_cents\n \n-def price_cents(product) -> int:\n-    \"\"\"Return cents from either the current or legacy catalog shape.\"\"\"\n-    if isinstance(product, dict):\n-        if \"price_cents\" in product:\n-            return int(product[\"price_cents\"])\n-        return int(product[\"price\"].amount_cents)\n \n-    price = getattr(product, \"price\", None)\n-    if price is not None:\n-        return int(price.amount_cents)\n-    return int(product.price_cents)\n-\n-\n-def currency(product) -> str:\n-    if isinstance(product, dict):\n-        price = product.get(\"price\")\n-        if price is not None:\n-            return price.currency\n-        return product.get(\"currency\", \"USD\")\n-\n-    price = getattr(product, \"price\", None)\n-    if price is not None:\n-        return price.currency\n-    return getattr(product, \"currency\", \"USD\")\n+def price_order(lines: list[dict], catalog: dict) -> dict:\n+    total = 0\n+    order_currency = None\n+    for line in lines:\n+        product = catalog[line[\"sku\"]]\n+        line_currency = currency(product)\n+        if order_currency is None:\n+            order_currency = line_currency\n+        elif order_currency != line_currency:\n+            raise ValueError(\n+                f\"mixed currencies are not supported in one order: \"\n+                f\"{order_currency} and {line_currency}\"\n+            )\n+        total += price_cents(product) * int(line[\"quantity\"])\n+    return {\"total_cents\": total, \"currency\": order_currency or \"USD\"}\n","exit":1,"truncated":false},"title":"git diff -- packages/orders/orders/adapter.py packages/orders/orders/service.py && git status --short","time":{"start":1788168029350,"end":1788168029352}},"metadata":{"openai":{"itemId":"fc_083a84803e0271a7016a95475d302c87d2a7ac1387635f3a3a"}},"id":"prt_0571ec497001w3Wpy8gQkvs01G","sessionID":"ses_fa8e24490ffe6DSQasHP6TF9R8","messageID":"msg_0571ea8ea001NcqQGY5gKqAJtE"}}
