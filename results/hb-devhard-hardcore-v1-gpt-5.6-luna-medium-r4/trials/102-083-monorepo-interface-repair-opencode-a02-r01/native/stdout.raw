ency, price_cents\n\n\ndef price_order(lines: list[dict], catalog: dict) -> dict:\n    total = 0\n    order_currency = None\n    for line in lines:\n        product = catalog[line[\"sku\"]]\n        line_currency = currency(product)\n        if order_currency is None:\n            order_currency = line_currency\n        elif order_currency != line_currency:\n            raise ValueError(\"mixed currencies are not supported\")\n        total += price_cents(product) * int(line[\"quantity\"])\n    return {\"total_cents\": total, \"currency\": order_currency or \"USD\"}","lineStart":1,"lineEnd":17,"totalLines":17,"truncated":false}},"title":"workspace/in/shopmono/packages/orders/orders/service.py","time":{"start":1788167990921,"end":1788167990931}},"metadata":{"openai":{"itemId":"fc_0f9bd25a0b6bf209016a954736a54087d298ff7729c771ccd7"}},"id":"prt_0571e2e83001kBuNZLDTPb9Dnk","sessionID":"ses_fa8e24490ffe6DSQasHP6TF9R8","messageID":"msg_0571e0f5e001P1bU4AT8Gszz1P"}}
