+class ConversionError(ValueError):
+    """An input validation error with a useful payload-relative path."""
+
+    def __init__(self, path, message):
+        self.path = path
+        super().__init__(message)
+
+
+def _required(mapping, key, path):
+    if not isinstance(mapping, dict) or key not in mapping or mapping[key] is None:
+        raise ConversionError(path, "missing required field")
+    return mapping[key]
+
+
+def _integer(value, path):
+    if isinstance(value, bool):
+        raise ConversionError(path, "must be an integer")
+    try:
+        converted = int(value)
+    except (TypeError, ValueError):
+        raise ConversionError(path, "must be an integer") from None
+    if isinstance(value, float) and converted != value:
+        raise ConversionError(path, "must be an integer")
+    if isinstance(value, str) and str(converted) != value.strip():
+        raise ConversionError(path, "must be an integer")
+    return converted
+
+
+def _legacy_customer(payload):
+    if "customer" in payload:
+        customer = _required(payload, "customer", "customer")
+        if not isinstance(customer, dict):
+            raise ConversionError("customer", "must be an object")
+        return _required(customer, "id", "customer.id"), _required(
+            customer, "name", "customer.name"
+        )
+    return _required(payload, "customer_id", "customer_id"), _required(
+        payload, "customer_name", "customer_name"
+    )
+
+
+def _legacy_lines(payload):
+    key = "lines" if "lines" in payload else "items"
+    lines = _required(payload, key, key)
+    if not isinstance(lines, list):
+        raise ConversionError(key, "must be an array")
+    converted = []
+    for index, line in enumerate(lines):
+        path = f"{key}[{index}]"
+        if not isinstance(line, dict):
+            raise ConversionError(path, "must be an object")
+        sku = _required(line, "sku", f"{path}.sku")
+        price_key = "unit_price_cents" if "unit_price_cents" in line else "price_cents"
+        converted.append(
+            {
+                "sku": sku,
+                "quantity": _integer(_required(line, "qty", f"{path}.qty"), f"{path}.qty"),
+                "unitPriceCents": _integer(
+                    _required(line, price_key, f"{path}.{price_key}"),
+                    f"{path}.{price_key}",
+                ),
+            }
+        )
+    return converted
+
+
+def _legacy_shipping(payload):
+    address_key = "shipTo" if "shipTo" in payload else "ship_to"
+    address = _required(payload, address_key, address_key)
+    if not isinstance(address, dict):
+        raise ConversionError(address_key, "must be an object")
+    output_address = {}
+    if "country" in address:
+        output_address["country"] = address["country"]
+    for postal_key in ("postal", "postalCode", "postal_code"):
+        if postal_key in address:
+            output_address["postalCode"] = address[postal_key]
+            break
+    method = payload.get("shipping_method", payload.get("shipping"))
+    if method is None or (isinstance(method, str) and not method.strip()):
+        method = "standard"
+    return {"method": method, "address": output_address}
+
+
+def _legacy_unknown_fields(payload):
+    unknown = {}
+    dropped = 0
+    for key, value in payload.items():
+        if key in _LEGACY_KEYS:
+            continue
+        if str(key).lower() in _PII_KEYS:
+            dropped += 1
+            continue
+        unknown[key] = copy.deepcopy(value)
+    return unknown, dropped
+
+
+def _convert_legacy(payload):
+    order_id = payload.get("order_ref", payload.get("id"))
+    if order_id is None:
+        raise ConversionError("order_ref" if "order_ref" in payload else "id", "missing required field")
+    customer_id, customer_name = _legacy_customer(payload)
+    unknown, dropped = _legacy_unknown_fields(payload)
