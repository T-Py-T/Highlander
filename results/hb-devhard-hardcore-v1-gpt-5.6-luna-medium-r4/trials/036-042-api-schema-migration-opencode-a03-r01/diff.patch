+        metadata["unknownFields"] = unknown
+    return {
+        "orderId": order_id,
+        "buyer": {"id": customer_id, "displayName": customer_name},
+        "lineItems": _legacy_lines(payload),
+        "shipping": _legacy_shipping(payload),
+        "metadata": metadata,
+    }, dropped, len(unknown)
+
+
+def _convert_v2(payload):
+    result = copy.deepcopy(payload)
+    for key in ("orderId", "buyer", "lineItems", "shipping", "metadata"):
+        _required(result, key, key)
