+CREATE TABLE IF NOT EXISTS users__status_shadow (
     id TEXT PRIMARY KEY,
-    email TEXT UNIQUE,
+    status TEXT NOT NULL
+);
+
+INSERT OR IGNORE INTO users__status_shadow (id, status)
+SELECT id, 'active'
+FROM users;
+
+DELETE FROM users__status_shadow
