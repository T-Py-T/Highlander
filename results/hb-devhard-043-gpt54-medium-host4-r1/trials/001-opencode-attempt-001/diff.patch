 DROP TABLE users;
 
 CREATE TABLE users (
     id TEXT PRIMARY KEY,
-    email TEXT UNIQUE,
+    email TEXT NOT NULL UNIQUE CHECK (length(trim(email)) > 0),
     name TEXT NOT NULL,
     status TEXT NOT NULL DEFAULT 'active',
