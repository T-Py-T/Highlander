:\n        return self.values.pop(0)\n\nclock = FakeClock(1000.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.25]))\nscheduler.add('task-b', priority=5)\nscheduler.add('task-a', priority=5)\nscheduler.add('task-c', priority=9)\nfirst = [task.id for task in scheduler.ready()]\nsecond = [task.id for task in scheduler.ready()]\nretry = scheduler.schedule_retry(scheduler.ready()[1], base_delay=10.0)\nclock.value = 1000.0\nbefore = [task.id for task in scheduler.ready()]\nclock.value = retry.run_at\nafter = [task.id for task in scheduler.ready()]\ndisplay({'first': first, 'second': second, 'retry_run_at': retry.run_at, 'before': before, 'after': after})","language":"python","output":"{'first': ['task-c', 'task-a', 'task-b'], 'second': ['task-c', 'task-a', 'task-b'], 'retry_run_at': 1010.25, 'before': ['task-c', 'task-b'], 'after': ['task-c', 'task-b', 'task-a']}\n\ndisplay[1]:\n{\n  \"first\": [\n    \"task-c\",\n    \"task-a\",\n    \"task-b\"\n  ],\n  \"second\": [\n    \"task-c\",\n    \"task-a\",\n    \"task-b\"\n  ],\n  \"retry_run_at\": 1010.25,\n  \"before\": [\n    \"task-c\",\n    \"task-b\"\n  ],\n  \"after\": [\n    \"task-c\",\n    \"task-b\",\n    \"task-a\"\n  ]\n}","status":"complete","exitCode":0,"durationMs":10}],"jsonOutputs":[{"first":["task-c","task-a","task-b"],"second":["task-c","task-a","task-b"],"retry_run_at":1010.25,"before":["task-c","task-b"],"after":["task-c","task-b","task-a"]}]},"isError":false,"timestamp":1788199327965}]}
