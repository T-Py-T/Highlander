{"type":"tool_execution_start","toolCallId":"call_GJ3i3zCo0FjBsciRgKhkPQY9|fc_02882f0bf381b985016a95c19f424087d2a7f5f77a103c6064","toolName":"eval","args":{"language":"py","code":"import sys\nsys.path.insert(0, '/workspace/in/flakyqueue')\nfrom flakyqueue.scheduler import Scheduler\n\nclass FakeClock:\n    def __init__(self, value):\n        self.value = value\n    def now(self):\n        return self.value\n\nclass FakeRandom:\n    def __init__(self, values):\n        self.values = list(values)\n    def random(self):\n        return self.values.pop(0)\n\nclock = FakeClock(1000.0)\nscheduler = Scheduler(clock=clock, random_source=FakeRandom([0.25]))\nscheduler.add('task-b', priority=5)\nscheduler.add('task-a', priority=5)\nscheduler.add('task-c', priority=9)\nfirst = [task.id for task in scheduler.ready()]\nsecond = [task.id for task in scheduler.ready()]\nretry = scheduler.schedule_retry(scheduler.ready()[1], base_delay=10.0)\nclock.value = 1000.0\nbefore = [task.id for task in scheduler.ready()]\nclock.value = retry.run_at\nafter = [task.id for task in scheduler.ready()]\ndisplay({'first': first, 'second': second, 'retry_run_at': retry.run_at, 'before': before, 'after': after})","title":"Exercising deterministic scheduler","timeout":120,"reset":false},"intent":"Exercising deterministic scheduler"}
