t == 1000.0\n 35:    assert task.run_at == 1000.0"}],"details":{"scopePath":"in/flakyqueue","searchPath":"/workspace/in/flakyqueue","cwd":"/workspace","matchCount":17,"fileCount":3,"files":["in/flakyqueue/flakyqueue/scheduler.py","in/flakyqueue/tests/test_retry_order.py","in/flakyqueue/tests/test_scheduler.py"],"fileMatches":[{"path":"in/flakyqueue/flakyqueue/scheduler.py","count":1},{"path":"in/flakyqueue/tests/test_retry_order.py","count":8},{"path":"in/flakyqueue/tests/test_scheduler.py","count":8}],"truncated":false,"displayContent":"# in/flakyqueue/\n\n## flakyqueue/\n### scheduler.py#3A57\n 36│\n*37│    def schedule_retry(self, task: Task, base_delay: float = 5.0) -> Task:\n 38│        jitter = random.random()\n 39│        updated = replace(task, attempts=task.attempts + 1, run_at=time.time() + base_delay + jitter)\n 40│        self.store.save(updated)\n\n## tests/\n### test_retry_order.py#8127\n 20│def test_retry_jitter_uses_injected_random_source():\n*21│    scheduler = Scheduler(clock=FakeClock(), random_source=FakeRandom([0.25]))\n*22│    task = scheduler.add(\"task-retry\", priority=3)\n*23│    retry = scheduler.schedule_retry(task, base_delay=10.0)\n 24│    assert retry.attempts == 1\n 25│    assert retry.run_at == 210.25\n 26│\n   │...\n 29│    clock = FakeClock()\n*30│    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.5]))\n*31│    task = scheduler.add(\"task-wait\", priority=3)\n*32│    retry = scheduler.schedule_retry(task, base_delay=10.0)\n*33│    assert scheduler.ready() == []\n 34│    clock.value = retry.run_at\n*35│    assert [task.id for task in scheduler.ready()] == [\"task-wait\"]\n### test_scheduler.py#C35B\n 21│    clock = FakeClock()\n*22│    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.3]))\n*23│    scheduler.add(\"task-b\", priority=5)\n*24│    scheduler.add(\"task-a\", priority=5)\n*25│    scheduler.add(\"task-c\", priority=9)\n*26│    assert [task.id for task in scheduler.ready()] == [\"task-c\", \"task-a\", \"task-b\"]\n*27│    assert [task.id for task in scheduler.ready()] == [\"task-c\", \"task-a\", \"task-b\"]\n 28│\n 29│\n 30│def test_add_uses_injected_clock():\n 31│    clock = FakeClock()\n*32│    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.1]))\n*33│    task = scheduler.add(\"task-1\", priority=1)\n 34│    assert task.created_at == 1000.0\n 35│    assert task.run_at == 1000.0"}},"isError":false}
