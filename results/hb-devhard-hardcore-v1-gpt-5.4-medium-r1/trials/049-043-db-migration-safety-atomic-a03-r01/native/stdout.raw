ted_at) values ('u7', null, 'x', 'active', '2024-01-01T00:00:00Z')\",\n    \"insert into users (id,email,name,status,created_at) values ('u7', '', 'x', 'active', '2024-01-01T00:00:00Z')\",\n    \"insert into users (id,email,name,status,created_at) values ('u7', 'ada@example.com', 'x', 'active', '2024-01-01T00:00:00Z')\",\n]:\n    try:\n        con.execute(sql)\n    except sqlite3.IntegrityError as e:\n        print('expected reject:', e)\n    else:\n        raise AssertionError(f'constraint did not reject: {sql}')\n\n# Roll back and verify old shape.\ncon.executescript(rollback)\ncols = con.execute(\"pragma table_info('users')\").fetchall()\nprint('rollback cols', cols)\nassert [c[1] for c in cols] == ['id', 'email', 'name', 'created_at']\nassert con.execute('select count(*) from users').fetchone()[0] == before_users\nassert con.execute('select count(*) from orders').fetchone()[0] == before_orders\nprint('rollback users', con.execute('select id,email,name,created_at from users order by id').fetchall())\nprint('ok')\nPY","timeout":20},"partialResult":{"content":[]}}
