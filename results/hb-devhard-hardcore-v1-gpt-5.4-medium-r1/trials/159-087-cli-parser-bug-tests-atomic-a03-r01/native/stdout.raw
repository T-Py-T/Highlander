sv\", \"--where\", \"id=o1\", \"--select\", \"id,customer\")\n 23:    assert proc.returncode == 0, proc.stderr\n 24:    rows = list(csv.DictReader(proc.stdout.splitlines()))\n 27:\n*28:def test_empty_result_keeps_header():\n 29:    proc = run_cli(\"samples/orders.csv\", \"--where\", \"status=refunded\", \"--select\", \"id,total\")\n 30:    assert proc.returncode == 0, proc.stderr\n 31:    assert proc.stdout.strip() == \"id,total\""}],"details":{"scopePath":"/workspace/in/csvtool/tests","searchPath":"/workspace/in/csvtool/tests","cwd":"/workspace","matchCount":12,"fileCount":2,"files":["in/csvtool/tests/test_cli_regression.py","in/csvtool/tests/test_cli_existing.py"],"fileMatches":{"in/csvtool/tests/test_cli_regression.py":9,"in/csvtool/tests/test_cli_existing.py":3},"displayContent":"# in/csvtool/tests/\n[in/csvtool/tests/test_cli_regression.py#A2EC]\n 13:\n*14:def write_csv(tmp_path, name, rows):\n*15:    path = tmp_path / name\n 16:    path.write_text(rows, encoding=\"utf-8\")\n 17:    return path\n 18:\n 19:\n*20:def test_repeated_where_uses_and_semantics():\n 21:    proc = run_cli(\n 22:        \"samples/orders.csv\",\n 23:        \"--where\",\n 34:\n*35:def test_descending_sort_uses_numeric_order(tmp_path):\n 36:    csv_file = write_csv(\n*37:        tmp_path,\n 38:        \"numbers.csv\",\n 39:        \"id,total\\na,2\\nb,10\\nc,1\\n\",\n 40:    )\n 50:\n*51:def test_quoted_commas_round_trip_in_output(tmp_path):\n 52:    csv_file = write_csv(\n*53:        tmp_path,\n 54:        \"quoted.csv\",\n 55:        'id,customer,total\\n1,\"North, West\",10\\n',\n 56:    )\n 61:\n*62:def test_invalid_where_exits_non_zero_with_clear_message():\n 63:    proc = run_cli(\"samples/orders.csv\", \"--where\", \"status\")\n 64:    assert proc.returncode != 0\n 65:    assert \"Invalid --where expression\" in proc.stderr\n 67:\n*68:def test_missing_field_errors_are_clear():\n 69:    for args, expected in [\n 70:        ((\"samples/orders.csv\", \"--where\", \"missing=x\"), \"Unkn