ed\": true\n        },\n        {\n          \"name\": \"acceptance_criteria\",\n          \"required\": false\n        },\n        {\n          \"name\": \"max_loops\",\n          \"required\": false\n        },\n        {\n          \"name\": \"base_branch\",\n          \"required\": false\n        },\n        {\n          \"name\": \"git_worktree_dir\",\n          \"required\": false\n        },\n        {\n          \"name\": \"create_pr\",\n          \"required\": false\n        }\n      ]\n    },\n    {\n      \"name\": \"tournament\",\n      \"description\": \"Run independent whole-task attempts through a soft-scored pivot-pairing schedule and return an auditable ranking.\",\n      \"inputs\": [\n        {\n          \"name\": \"prompt\",\n          \"required\": true\n        },\n        {\n          \"name\": \"num_attempts\",\n          \"required\": false\n        },\n        {\n          \"name\": \"max_concurrency\",\n          \"required\": false\n        },\n        {\n          \"name\": \"n_evaluations\",\n          \"required\": false\n        },\n        {\n          \"name\": \"pivots\",\n          \"required\": false\n        },\n        {\n          \"name\": \"seed\",\n          \"required\": false\n        },\n        {\n          \"name\": \"criteria\",\n          \"required\": false\n        },\n        {\n          \"name\": \"models\",\n          \"required\": false\n        }\n      ]\n    }\n  ]\n}"}],"details":{"action":"list","items":[{"name":"adversarial-verification","description":"Produce a candidate, score independent per-criterion verifier reports, and apply a deterministic mean-and-veto gate with bounded repairs.","inputs":[{"name":"task","required":true},{"name":"verifier_count","required":false},{"name":"max_repairs","required":false},{"name":"criteria","required":false},{"name":"accept_mean","required":false},{"name":"reask_limit","required":false}]},{"name":"classify-and-act","description":"Classify a task with structured co