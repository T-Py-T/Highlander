oney = getattr(product, \"price\", None)\n14:    if money is not None:\n15:        return int(money.amount_cents), str(money.currency)\n16:\n17:    return int(product.price_cents), str(getattr(product, \"currency\", \"USD\"))\n18:\n19:\n20:def price_cents(product) -> int:\n21:    \"\"\"Return the product price in cents for new and legacy product shapes.\"\"\"\n22:    amount_cents, _ = _money_parts(product)\n23:    return amount_cents\n24:\n25:\n26:def currency(product) -> str:\n27:    _, code = _money_parts(product)\n28:    return code"}],"details":{"meta":{"source":"/workspace/in/shopmono/packages/orders/orders/adapter.py","sourcePath":"/workspace/in/shopmono/packages/orders/orders/adapter.py"}},"isError":false,"timestamp":1788212904154},{"role":"toolResult","toolCallId":"call_h1esiYwJbZzoX9QVpWKGuWKj|fc_068f288fef89be08016a95f6a7f92887d2864a72365b0f1e8f","toolName":"read","content":[{"type":"text","text":"[in/shopmono/packages/orders/orders/service.py#FF73]\n1:from __future__ import annotations\n2:\n3:from orders.adapter import currency, price_cents\n4:\n5:\n6:def price_order(lines: list[dict], catalog: dict) -> dict:\n7:    total = 0\n8:    order_currency = None\n9:    for line in lines:\n10:        product = catalog[line[\"sku\"]]\n11:        line_currency = currency(product)\n12:        if order_currency is None:\n13:            order_currency = line_currency\n14:        elif order_currency != line_currency:\n15:            raise ValueError(\n16:                f\"mixed currencies are not supported: {order_currency} and {line_currency}\"\n17:            )\n18:        total += price_cents(product) * int(line[\"quantity\"])\n19:    return {\"total_cents\": total, \"currency\": order_currency or \"USD\"}"}],"details":{"meta":{"source":"/workspace/in/shopmono/packages/orders/orders/service.py","sourcePath":"/workspace/in/shopmono/packages/orders/orders/service.py"}},"isError":false,"timestamp":1788212904154},{"role":"toolResult","toolCallId":"call_LIdtZ4MwAQcCF7ZFd