  conn.executescript(schema)\n    conn.executescript(migration)\n    summary['after_first_migration'] = {\n        'foreign_keys_pragma': conn.execute('PRAGMA foreign_keys').fetchone()[0],\n        'invoices': conn.execute('SELECT COUNT(*) FROM invoices').fetchone()[0],\n        'payments': conn.execute('SELECT COUNT(*) FROM payments').fetchone()[0],\n        'payment_orphans': conn.execute('SELECT COUNT(*) FROM payment_orphans').fetchone()[0],\n        'status_nulls': conn.execute('SELECT COUNT(*) FROM invoices WHERE status IS NULL').fetchone()[0],\n        'p4_orphans': conn.execute(\"SELECT COUNT(*) FROM payment_orphans WHERE id='p4' AND invoice_id='missing-invoice' AND amount_cents=700 AND created_at='2024-01-07T10:00:00Z'\").fetchone()[0],\n        'fk_check': conn.execute('PRAGMA foreign_key_check').fetchall(),\n    }\n    conn.executescript(migration)\n    summary['after_second_migration'] = {\n        'invoices': conn.execute('SELECT COUNT(*) FROM invoices').fetchone()[0],\n        'payments': conn.execute('SELECT COUNT(*) FROM payments').fetchone()[0],\n        'payment_orphans': conn.execute('SELECT COUNT(*) FROM payment_orphans').fetchone()[0],\n        'p4_orphans': conn.execute(\"SELECT COUNT(*) FROM payment_orphans WHERE id='p4'\").fetchone()[0],\n    }\n    try:\n        conn.execute(\"INSERT INTO payments(id, invoice_id, amount_cents, created_at) VALUES ('px', 'does-not-exist', 1, '2024-01-08T00:00:00Z')\")\n    except sqlite3.IntegrityError as exc:\n        summary['future_fk_enforcement'] = {'rejected': True, 'error': str(exc)}\n    else:\n        summary['future_fk_enforcement'] = {'rejected': False, 'error': None}\n    conn.rollback()\n    conn.executescript(rollback)\n    summary['after_rollback'] = {\n        'foreign_keys_pragma': conn.execute('PRAGMA foreign_keys').fetchone()[0],\n        'tables': conn.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name IN ('invoices','payments','payment_orphans') ORDER BY name\").fetchall()