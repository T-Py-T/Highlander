fk_enforcement'] = {'rejected': True, 'error': str(exc)}\n    else:\n        summary['future_fk_enforcement'] = {'rejected': False, 'error': None}\n    conn.rollback()\n    conn.executescript(rollback)\n    summary['after_rollback'] = {\n        'foreign_keys_pragma': conn.execute('PRAGMA foreign_keys').fetchone()[0],\n        'tables': conn.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name IN ('invoices','payments','payment_orphans') ORDER BY name\").fetchall(),\n        'invoice_columns': [row[1] for row in conn.execute('PRAGMA table_info(invoices)').fetchall()],\n        'payment_columns': [row[1] for row in conn.execute('PRAGMA table_info(payments)').fetchall()],\n        'invoices': conn.execute('SELECT COUNT(*) FROM invoices').fetchone()[0],\n        'payments': conn.execute('SELECT COUNT(*) FROM payments').fetchone()[0],\n        'p4_in_payments': conn.execute(\"SELECT COUNT(*) FROM payments WHERE id='p4' AND invoice_id='missing-invoice' AND amount_cents=700 AND created_at='2024-01-07T10:00:00Z'\").fetchone()[0],\n    }\nfinally:\n    conn.close()\n    os.unlink(db_path)\ndisplay(summary)","language":"python","output":"{'after_first_migration': {'foreign_keys_pragma': 1, 'invoices': 3, 'payments': 3, 'payment_orphans': 1, 'status_nulls': 0, 'p4_orphans': 1, 'fk_check': []}, 'after_second_migration': {'invoices': 3, 'payments': 3, 'payment_orphans': 1, 'p4_orphans': 1}, 'future_fk_enforcement': {'rejected': True, 'error': 'FOREIGN KEY constraint failed'}, 'after_rollback': {'foreign_keys_pragma': 1, 'tables': [('invoices',), ('payments',)], 'invoice_columns': ['id', 'customer_id', 'total_cents', 'created_at'], 'payment_columns': ['id', 'invoice_id', 'amount_cents', 'created_at'], 'invoices': 3, 'payments': 4, 'p4_in_payments': 1}}\n\ndisplay[1]:\n{\n  \"after_first_migration\": {\n    \"foreign_keys_pragma\": 1,\n    \"invoices\": 3,\n    \"payments\": 3,\n    \"payment_orphans\": 1,\n    \"status_nulls\": 0,\n    \"p4_orphans\": 1,\n    \"fk_check\": []\n  },\n  \"after_second_migration\": {\n    \"invoices\": 3,\n    \"payments\": 3,\n    \"payment_orphans\": 1,\n    \"p4_orphans\": 1\n  },\n  \"future_fk_enforcement\": {\n    \"rejected\": true,\n    \"error\": \"FOREIGN KEY constraint failed\"\n  },\n  \"after_rollback\": {\n    \"foreign_keys_pragma\": 1,\n    \"tables\": [\n      [\n        \"invoices\"\n      ],\n      [\n        \"payments\"\n      ]\n    ],\n    \"invoice_columns\": [\n      \"id\",\n      \"customer_id\",\n      \"total_cents\",\n      \"created_at\"\n    ],\n    \"payment_columns\": [\n      \"id\",\n      \"invoice_id\",\n      \"amount_cents\",\n      \"created_at\"\n    ],\n    \"invoices\": 3,\n    \"payments\": 4,\n    \"p4_in_payments\": 1\n  }\n}","status":"complete","exitCode":0,"durationMs":11}],"jsonOutputs":[{"after_first_migration":{"foreign_keys_pragma":1,"invoices":3,"payments":3,"payment_orphans":1,"status_nulls":0,"p4_orphans":1,"fk_check":[]},"after_second_migration":{"invoices":3,"payments":3,"payment_orphans":1,"p4_orphans":1},"future_fk_enforcement":{"rejected":true,"error":"FOREIGN KEY constraint failed"},"after_rollback":{"foreign_keys_pragma":1,"tables":[["invoices"],["payments"]],"invoice_columns":["id","customer_id","total_cents","created_at"],"payment_columns":["id","invoice_id","amount_cents","created_at"],"invoices":3,"payments":4,"p4_in_payments":1}}]},"isError":false,"timestamp":1788195860882}]}
