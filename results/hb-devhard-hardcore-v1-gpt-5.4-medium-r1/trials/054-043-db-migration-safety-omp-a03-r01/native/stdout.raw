{"type":"message_update","assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":"{\"i\":\"Writing rollback script\",\"path\":\"/workspace/in/db/rollback.sql\",\"content\":\"PRAGMA foreign_keys = OFF;\\n\\nBEGIN IMMEDIATE;\\n\\nDROP TABLE IF EXISTS users__rollback_old;\\n\\nALTER TABLE users RENAME TO users__rollback_old;\\n\\nCREATE TABLE users (\\n    id TEXT PRIMARY KEY,\\n    email TEXT,\\n    name TEXT NOT NULL,\\n    created_at TEXT NOT NULL\\n);\\n\\nINSERT INTO users (id, email, name, created_at)\\nSELECT id, email, name, created_at\\nFROM users__rollback_old;\\n\\nDROP TABLE users__rollback_old;\\n\\nCOMMIT;\\n\\nPRAGMA foreign_keys = ON;\\n\"}"}}
{"type":"message_update","assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"call_YOa6M1SU7SJyRhPL5caT0EGM|fc_006495ab90240cb6016a95a66c917087d28fa7854340e0363c","name":"write","arguments":{"i":"Writing rollback script","path":"/workspace/in/db/rollback.sql","content":"PRAGMA foreign_keys = OFF;\n\nBEGIN IMMEDIATE;\n\nDROP TABLE IF EXISTS users__rollback_old;\n\nALTER TABLE users RENAME TO users__rollback_old;\n\nCREATE TABLE users (\n    id TEXT PRIMARY KEY,\n    email TEXT,\n    name TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nINSERT INTO users (id, email, name, created_at)\nSELECT id, email, name, created_at\nFROM users__rollback_old;\n\nDROP TABLE users__rollback_old;\n\nCOMMIT;\n\nPRAGMA foreign_keys = ON;\n"}}}}
