\",\n        \"dflt_value\",\n        \"ok\"\n      ],\n      \"rows\": [\n        [\n          \"status_column_definition\",\n          \"status\",\n          \"TEXT\",\n          1,\n          \"'active'\",\n          1\n        ]\n      ]\n    },\n    {\n      \"columns\": [\n        \"check_name\",\n        \"name\",\n        \"notnull\",\n        \"ok\"\n      ],\n      \"rows\": [\n        [\n          \"email_column_not_null\",\n          \"email\",\n          1,\n          1\n        ]\n      ]\n    },\n    {\n      \"columns\": [\n        \"check_name\",\n        \"actual_count\",\n        \"ok\"\n      ],\n      \"rows\": [\n        [\n          \"email_unique_index_present\",\n          1,\n          1\n        ]\n      ]\n    },\n    {\n      \"columns\": [\n        \"check_name\",\n        \"id\",\n        \"created_at\",\n        \"ok\"\n      ],\n      \"rows\": [\n        [\n          \"created_at_preserved_for_dirty_users\",\n          \"u4\",\n          \"2023-12-01T08:00:00Z\",\n          1\n        ],\n        [\n          \"created_at_preserved_for_dirty_users\",\n          \"u5\",\n          \"2023-11-05T12:00:00Z\",\n          1\n        ],\n        [\n          \"created_at_preserved_for_dirty_users\",\n          \"u6\",\n          \"2023-10-06T07:45:00Z\",\n          1\n        ]\n      ]\n    }\n  ],\n  \"rollback_columns\": [\n    [\n      \"id\"\n    ],\n    [\n      \"email\"\n    ],\n    [\n      \"name\"\n    ],\n    [\n      \"created_at\"\n    ]\n  ],\n  \"rollback_users\": [\n    [\n      \"u1\",\n      \"ada@example.com\",\n      \"Ada\",\n      \"2024-01-02T10:00:00Z\"\n    ],\n    [\n      \"u2\",\n      \"lin@example.com\",\n      \"Lin\",\n      \"2024-02-03T11:30:00Z\"\n    ],\n    [\n      \"u3\",\n      \"grace@example.com\",\n      \"Grace\",\n      \"2024-03-04T09:15:00Z\"\n    ],\n    [\n      \"u4\",\n      \"ada+u4@example.com\",\n      \"Ada Legacy\",\n      \"2023-12-01T08:00:00Z\"\n    ],\n    [\n      \"u5\",\n      \"missing+u5@example.invalid\",\n      \"Null Email Legacy\",\n      \"2023-11-05T12:00:00Z\"\n    ],\n    [\n      \"u6\",\n      \"missing+u6@example.invalid\",\n      \"Blank Email Legacy\",\n      \"2023-10-06T07:45:00Z\"\n    ]\n  ],\n  \"rollback_orders\": [\n    [\n      \"o1\",\n      \"u1\"\n    ],\n    [\n      \"o2\",\n      \"u4\"\n    ],\n    [\n      \"o3\",\n      \"u5\"\n    ],\n    [\n      \"o4\",\n      \"u6\"\n    ]\n  ]\n}\n\n[Some lines truncated to 768 chars]"}],"details":{"language":"python","languages":["python"],"cells":[{"index":0,"title":"Verifying migration scripts","code":"import sqlite3, tempfile, pathlib, json\nbase = pathlib.Path('/workspace/in/db')\nschema_sql = read(str(base / 'schema.sql'))\nmigration_sql = read(str(base / 'migration.sql'))\nrollback_sql = read(str(base / 'rollback.sql'))\npostcheck_sql = read(str(base / 'postcheck.sql'))\n\ndef fetch_all(conn, sql):\n    cur = conn.cursor()\n    rows = []\n    for stmt in [s.strip() for s in sql.split(';') if s.strip()]:\n        cur.execute(stmt)\n        if cur.description:\n            cols = [d[0] for d in cur.description]\n            rows.append({'sql': stmt, 'columns': cols, 'rows': cur.fetchall()})\n    return rows\n\nfd, db_path = tempfile.mkstemp(suffix='.sqlite3')\npathlib.Path(db_path).unlink(missing_ok=True)\nconn = sqlite3.connect(db_path)\nconn.row_factory = sqlite3.Row\nsummary = {}\ntry:\n    conn.executescript(schema_sql)\n    summary['before_users'] = conn.execute('SELECT id, email, name, created_at FROM users ORDER BY id').fetchall()\n    summary['before_orders'] = conn.execute('SELECT id, user_id FROM orders ORDER BY id').fetchall()\n    conn.executescript(migration_sql)\n    first_users = conn.execute('SELECT id, email, name, status, created_at FROM users ORDER BY id').fetchall()\n    first_orders = conn.execute('SELECT id, user_id FROM orders ORDER BY id').fetchall()\n    conn.executescript(migration_sql)\n    second_users = conn.execute('SELECT id, email, name, status, created_at FROM users ORDER BY id').fetchall()\n    second_orders = conn.execute('SELECT id, user_id FROM orders ORDER BY id').fetchall()\n    summary['rerun_same_users'] = [tuple(r) for r in first_users] == [tuple(r) for r in second_users]\n    summary['rerun_same_orders'] = [tuple(r) for r in first_orders] == [tuple(r) for r in second_orders]\n    summary['postcheck'] = fetch_all(conn, postcheck_sql)\n    conn.executescript(rollback_sql)\n    summary['rollback_columns'] = conn.execute(\"SELECT name FROM pragma_table_info('users') ORDER BY cid\").fetchall()\n    summary['rollback_users'] = conn.execute('SELECT id, email, name, created_at FROM users ORDER BY id').fetchall()\n    summary['rollback_orders'] = conn.execute('SELECT id, user_id FROM orders ORDER BY id').fetchall()\nfinally:\n    conn.close()\n\ndef norm(rows):\n    out = []\n    for row in rows:\n        if isinstance(row, sqlite3.Row):\n            out.append(dict(row))\n        else:\n            out.append([dict(x) if isinstance(x, sqlite3.Row) else x for x in row] if isinstance(row, list) else row)\n    return out\n\nserial = {\n    'rerun_same_users': summary['rerun_same_users'],\n    'rerun_same_orders': summary['rerun_same_orders'],\n    'postcheck': [\n        {'columns': item['columns'], 'rows': [tuple(r) for r in item['rows']]}\n        for item in summary['postcheck']\n    ],\n    'rollback_columns': [tuple(r) for r in summary['rollback_columns']],\n    'rollback_users': [tuple(r) for r in summary['rollback_users']],\n    'rollback_orders': [tuple(r) for r in summary['rollback_orders']],\n}\ndisplay(serial)","language":"python","output":"{'rerun_same_users': True, 'rerun_same_orders': True, 'postcheck': [{'columns': ['check_name', 'actual_count', 'expected_count', 'ok'], 'rows': [('user_row_count', 6, 6, 1)]}, {'columns': ['check_name', 'actual_count', 'expected_count', 'ok'], 'rows': [('order_row_count', 4, 4, 1)]}, {'columns': ['check_name', 'actual_count', 'expected_count', 'ok'], 'rows': [('dirty_user_order_count', 3, 3, 1)]}, {'columns': ['check_name', 'order_id', 'user_id', 'total_cents', 'created_at'], 'rows': [('dirty_user_orders', 'o2', 'u4', 4599, '2024-04-02T10:30:00Z'), ('dirty_user_orders', 'o3', 'u5', 799, '2024-04-03T11:45:00Z'), ('dirty_user_orders', 'o4', 'u6', 1599, '2024-04-04T12:10:00Z')]}, {'columns': ['check_name', 'id', 'email', 'ok'], 'rows': [('cleaned_dirty_email…\n\ndisplay[1]:\n{\n  \"rerun_same_users\": true,\n  \"rerun_same_orders\": true,\n  \"postcheck\": [\n    {\n      \"columns\": [\n        \"check_name\",\n        \"actual_count\",\n        \"expected_count\",\n        \"ok\"\n      ],\n      \"rows\": [\n        [\n          \"user_row_count\",\n          6,\n          6,\n          1\n        ]\n      ]\n    },\n    {\n      \"columns\": [\n        \"check_name\",\n        \"actual_count\",\n        \"expected_count\",\n        \"ok\"\n      ],\n      \"rows\": [\n        [\n          \"order_row_count\",\n          4,\n          4,\n          1\n        ]\n      ]\n    },\n    {\n      \"columns\": [\n        \"check_name\",\n        \"actual_count\",\n        \"expected_count\",\n        \"ok\"\n      ],\n      \"rows\": [\n        [\n          \"dirty_user_order_count\",\n          3,\n          3,\n          1\n        ]\n      ]\n    },\n    {\n      \"columns\": [\n        \"check_name\",\n        \"order_id\",\n        \"user_id\",\n        \"total_cents\",\n        \"created_at\"\n      ],\n      \"rows\": [\n        [\n          \"dirty_user_orders\",\n          \"o2\",\n          \"u4\",\n          4599,\n          \"2024-04-02T10:30:00Z\"\n        ],\n        [\n          \"dirty_user_orders\",\n          \"o3\",\n          \"u5\",\n          799,\n          \"2024-04-03T11:45:00Z\"\n        ],\n        [\n          \"dirty_user_orders\",\n          \"o4\",\n          \"u6\",\n          1599,\n          \"2024-04-04T12:10:00Z\"\n        ]\n      ]\n    },\n    {\n      \"columns\": [\n     