ECT COUNT(*) FROM payment_orphans WHERE id='p4'\").fetchone())\n    print('fk_check', conn.execute(\"PRAGMA foreign_key_check\").fetchall())\n\n    print('\\n== rollback ==')\n    conn.executescript((base/'rollback.sql').read_text())\n    print('invoices_schema', conn.execute(\"PRAGMA table_info(invoices)\").fetchall())\n    print('payments_schema', conn.execute(\"PRAGMA table_info(payments)\").fetchall())\n    print('invoices', conn.execute(\"SELECT COUNT(*) FROM invoices\").fetchone())\n    print('payments', conn.execute(\"SELECT COUNT(*) FROM payments\").fetchone())\n    print('p4_in_payments', conn.execute(\"SELECT COUNT(*) FROM payments WHERE id='p4' AND invoice_id='missing-invoice' AND amount_cents=700 AND created_at='2024-01-07T10:00:00Z'\").fetchone())\n    print('payment_orphans_table', conn.execute(\"SELECT name FROM sqlite_master WHERE type='table' AND name='payment_orphans'\").fetchall())\nfinally:\n    conn.close()\nPY","timeout":20}}}}
