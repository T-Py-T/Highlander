{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,320p' /workspace/in/schema_migration/client.py\"","aggregated_output":"def convert_order(payload):\n    \"\"\"Convert a legacy v1 order payload to the v2 public API shape.\"\"\"\n    return {\n        \"orderId\": payload[\"id\"],\n        \"customer\": payload[\"customer_name\"],\n        \"items\": payload[\"items\"],\n        \"address\": payload[\"ship_to\"],\n    }\n\n\ndef summarize_order(v2_payload):\n    return f\"{v2_payload['orderId']}:{len(v2_payload['lineItems'])}\"\n","exit_code":0,"status":"completed"}}
