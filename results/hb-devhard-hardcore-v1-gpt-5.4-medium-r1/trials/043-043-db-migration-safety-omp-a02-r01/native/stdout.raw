{"type":"message_update","assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":"{\"i\":\"Writing rollback script\",\"path\":\"in/db/rollback.sql\",\"content\":\"BEGIN IMMEDIATE;\\n\\nPRAGMA foreign_keys = OFF;\\n\\nDROP TABLE IF EXISTS users__rollback;\\n\\nCREATE TABLE users__rollback (\\n    id TEXT PRIMARY KEY,\\n    email TEXT,\\n    name TEXT NOT NULL,\\n    created_at TEXT NOT NULL\\n);\\n\\nINSERT INTO users__rollback (id, email, name, created_at)\\nSELECT id, email, name, created_at\\nFROM users;\\n\\nDROP TABLE users;\\nALTER TABLE users__rollback RENAME TO users;\\n\\nDROP INDEX IF EXISTS idx_users_email;\\nDROP TABLE IF EXISTS _migration_meta;\\nDROP TABLE IF EXISTS _migration_users_v1_source;\\n\\nPRAGMA foreign_keys = ON;\\n\\nCOMMIT;\\n\"}"}}
{"type":"message_update","assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"call_fOMNCHyDSXNsjzoaj7ofsvnD|fc_05c07d1a95d865f8016a959fcd928087d292d2718078d15ca1","name":"write","arguments":{"i":"Writing rollback script","path":"in/db/rollback.sql","content":"BEGIN IMMEDIATE;\n\nPRAGMA foreign_keys = OFF;\n\nDROP TABLE IF EXISTS users__rollback;\n\nCREATE TABLE users__rollback (\n    id TEXT PRIMARY KEY,\n    email TEXT,\n    name TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nINSERT INTO users__rollback (id, email, name, created_at)\nSELECT id, email, name, created_at\nFROM users;\n\nDROP TABLE users;\nALTER TABLE users__rollback RENAME TO users;\n\nDROP INDEX IF EXISTS idx_users_email;\nDROP TABLE IF EXISTS _migration_meta;\nDROP TABLE IF EXISTS _migration_users_v1_source;\n\nPRAGMA foreign_keys = ON;\n\nCOMMIT;\n"}}}}
