tion_meta (\n+    name TEXT PRIMARY KEY,\n+    applied_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP\n+);\n+\n+INSERT OR IGNORE INTO _migration_meta (name)\n+VALUES ('users_status_email_v1');\n+\n+PRAGMA foreign_keys = ON;\n+\n+COMMIT;\n*** End Patch\n"},"customWireName":"edit"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":1210,"output":4007,"cacheRead":17920,"cacheWrite":0,"totalTokens":23137,"reasoningTokens":3553,"cost":{"input":0.0030250000000000003,"output":0.060105,"cacheRead":0.00448,"cacheWrite":0,"total":0.06761}},"stopReason":"toolUse","timestamp":1788190559406,"responseId":"resp_05c07d1a95d865f8016a959f5fb97487d2b6168ab8ffcb6ece","duration":74285.44696599999,"ttft":2125.2177679999986}}
