read","content":[{"type":"text","text":"[in/shopmono/pyproject.toml#57BB]\n1:[tool.pytest.ini_options]\n2:pythonpath = [\"packages/catalog\", \"packages/orders\", \"packages/reports\"]\n3:testpaths = [\"tests\"]"}],"details":{"meta":{"source":"/workspace/in/shopmono/pyproject.toml","sourcePath":"/workspace/in/shopmono/pyproject.toml"}},"isError":false,"timestamp":1788198306419},{"role":"toolResult","toolCallId":"call_EjyHMRonJ9a6GIn7AxP5l1qN|fc_067ccd0f23a21abe016a95bda24c8487d285b7b106321c29b8","toolName":"read","content":[{"type":"text","text":"[in/shopmono/tests/test_orders_report_integration.py#6F1F]\n1:import pytest\n2:\n3:from catalog.pricing import sample_catalog\n4:from orders.service import price_order\n5:from reports.monthly import summarize_orders\n6:\n7:\n8:def test_order_prices_catalog_money_objects():\n9:    catalog = sample_catalog()\n10:    assert price_order([{\"sku\": \"PEN\", \"quantity\": 2}, {\"sku\": \"PAD\", \"quantity\": 1}], catalog) == {\n11:        \"total_cents\": 550,\n12:        \"currency\": \"USD\",\n13:    }\n14:\n15:\n16:def test_reports_group_by_currency():\n17:    catalog = sample_catalog()\n18:    result = summarize_orders(\n19:        [\n20:            {\"id\": \"o1\", \"lines\": [{\"sku\": \"PEN\", \"quantity\": 2}]},\n21:            {\"id\": \"o2\", \"lines\": [{\"sku\": \"MUG\", \"quantity\": 1}]},\n22:        ],\n23:        catalog,\n24:    )\n25:    assert result == {\"order_count\": 2, \"revenue_by_currency\": {\"USD\": 250, \"EUR\": 700}}\n26:\n27:\n28:def test_mixed_currency_order_is_rejected():\n29:    catalog = sample_catalog()\n30:    with pytest.raises(ValueError, match=\"mixed\"):\n31:        price_order([{\"sku\": \"PEN\", \"quantity\": 1}, {\"sku\": \"MUG\", \"quantity\": 1}], catalog)"}],"details":{"meta":{"source":"/workspace/in/shopmono/tests/test_orders_report_integration.py","sourcePath":"/workspace/in/shopmono/tests/test_orders_report_integration.py"}},"isError":false,"timestamp":1788198306420},{"role":"tool