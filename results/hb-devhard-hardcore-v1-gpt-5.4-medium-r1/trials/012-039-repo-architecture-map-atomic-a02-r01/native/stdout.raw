{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"call_fX9fhfVdYhxwBg4hTQMNxkCA|fc_0ddc587a4ab35b08016a9586b2328887d281861b470934bbc6","name":"write","arguments":{"path":"/workspace/out/module_map.json","content":"{\n  \"modules\": [\n    {\n      \"name\": \"minisvc.cli\",\n      \"path\": \"minisvc/cli.py\",\n      \"purpose\": \"CLI bootstrap that loads settings, builds the repository, initializes the SQLite schema, and prints readiness.\"\n    },\n    {\n      \"name\": \"minisvc.config\",\n      \"path\": \"minisvc/config.py\",\n      \"purpose\": \"Defines immutable runtime settings and loads MINISVC_DB and MINISVC_READONLY from the environment.\"\n    },\n    {\n      \"name\": \"minisvc.models\",\n      \"path\": \"minisvc/models.py\",\n      \"purpose\": \"Holds the Order data model used across handlers, audit code, and storage.\"\n    },\n    {\n      \"name\": \"minisvc.audit\",\n      \"path\": \"minisvc/audit.py\",\n      \"purpose\": \"Builds lightweight audit event dictionaries for API responses; it does not persist them.\"\n    },\n    {\n      \"name\": \"minisvc.api.handlers\",\n      \"path\": \"minisvc/api/handlers.py\",\n      \"purpose\": \"Maps request payloads and repository calls to response dictionaries for order create and read operations.\"\n    },\n    {\n      \"name\": \"minisvc.api.routes\",\n      \"path\": \"minisvc/api/routes.py\",\n      \"purpose\": \"Registers HTTP route callbacks on an injected app object.\"\n    },\n    {\n      \"name\": \"minisvc.storage.repo\",\n      \"path\": \"minisvc/storage/repo.py\",\n      \"purpose\": \"SQLite-backed repository that creates the orders table, inserts orders, and fetches orders by id.\"\n    }\n  ],\n  \"entry_points\": [\n    {\n      \"identifier\": \"minisvc.cli:main\",\n      \"kind\": \"cli\",\n      \"exposed_via\": \"pyproject.toml [project.scripts].minisvc\",\n      \"notes\": \"Bootstraps local storage and prints the selected database path.\"\n    },\n    {\n      \"identifier\": \"minisvc.api.routes:register_routes\",\n      \"kind\": \"http_route_registration\",\n      \"exposed_via\": \"Called by an external HTTP app bootstrap not present in this repo\",\n      \"notes\": \"Binds POST /orders and GET /orders/<order_id> handlers to the provided app and repository.\"\n    },\n    {\n      \"identifier\": \"minisvc.api.handlers:create_order\",\n      \"kind\": \"request_handler\",\n      \"exposed_via\": \"POST /orders via minisvc.api.routes:register_routes\",\n      \"notes\": \"Constructs an Order from request payload, saves it, and returns an event in the response body.\"\n    },\n    {\n      \"identifier\": \"minisvc.api.handlers:get_order\",\n      \"kind\": \"request_handler\",\n      \"exposed_via\": \"GET /orders/<order_id> via minisvc.api.routes:register_routes\",\n      \"notes\": \"Loads an order by id and returns either a missing response or the order plus a read event.\"\n    }\n  ],\n  \"dependency_edges\": [\n    {\n      \"from\": \"minisvc.cli\",\n      \"to\": \"minisvc.config\",\n      \"type\": \"imports\"\n    },\n    {\n      \"from\": \"minisvc.cli\",\n      \"to\": \"minisvc.storage.repo\",\n      \"type\": \"imports\"\n    },\n    {\n      \"from\": \"minisvc.cli:main\",\n      \"to\": \"environment:MINISVC_DB,MINISVC_READONLY\",\n      \"type\": \"reads_config\"\n    },\n    {\n      \"from\": \"minisvc.cli:main\",\n      \"to\": \"minisvc.config:load_settings\",\n      \"type\": \"calls\"\n    },\n    {\n      \"from\": \"minisvc.cli:main\",\n      \"to\": \"minisvc.storage.repo:OrderRepository\",\n      \"type\": \"instantiates\"\n    },\n    {\n      \"from\": \"minisvc.cli:main\",\n      \"to\": \"minisvc.storage.repo:OrderRepository.init_schema\",\n      \"type\": \"calls\"\n    },\n    {\n      \"from\": \"minisvc.api.routes\",\n      \"to\": \"minisvc.api.handlers\",\n      \"type\": \"imports\"\n    },\n    {\n      \"from\": \"minisvc.api.routes:register_routes\",\n      \"to\": \"minisvc.api.handlers:create_order\",\n      \"type\": \"calls\"\n    },\n    {\n      \"from\": \"minisvc.api.routes:register_routes\",\n      \"to\": \"minisvc.api.handlers:get_order\",\n      \"type\": \"calls\"\n    },\n    {\n      \"from\": \"minisvc.api.handlers\",\n      \"to\": \"minisvc.audit\",\n      \"type\": \"imports\"\n    },\n    {\n      \"from\": \"minisvc.api.handlers\",\n      \"to\": \"minisvc.models\",\n      \"type\": \"imports\"\n    },\n    {\n      \"from\": \"minisvc.api.handlers\",\n      \"to\": \"minisvc.storage.repo\",\n      \"type\": \"imports\"\n    },\n    {\n      \"from\": \"minisvc.api.handlers:create_order\",\n      \"to\": \"minisvc.models:Order\",\n      \"type\": \"instantiates\"\n    },\n    {\n      \"from\": \"minisvc.api.handlers:create_order\",\n      \"to\": \"minisvc.storage.repo:OrderRepository.save\",\n      \"type\": \"calls\"\n    },\n    {\n      \"from\": \"minisvc.api.handlers:create_order\",\n      \"to\": \"minisvc.audit:order_event\",\n      \"type\": \"calls\"\n    },\n    {\n      \"from\": \"minisvc.api.handlers:get_order\",\n      \"to\": \"minisvc.storage.repo:OrderRepository.get\",\n      \"type\": \"calls\"\n    },\n    {\n      \"from\": \"minisvc.api.handlers:get_order\",\n      \"to\": \"minisvc.audit:order_event\",\n      \"type\": \"calls\"\n    },\n    {\n      \"from\": \"minisvc.audit\",\n      \"to\": \"minisvc.models\",\n      \"type\": \"imports\"\n    },\n    {\n      \"from\": \"minisvc.storage.repo\",\n      \"to\": \"minisvc.models\",\n      \"type\": \"imports\"\n    },\n    {\n      \"from\": \"minisvc.storage.repo:OrderRepository.init_schema\",\n      \"to\": \"sqlite:orders\",\n      \"type\": \"persists_to\"\n    },\n    {\n      \"from\": \"minisvc.storage.repo:OrderRepository.save\",\n      \"to\": \"sqlite:orders\",\n      \"type\": \"persists_to\"\n    },\n    {\n      \"from\": \"minisvc.config:load_settings\",\n      \"to\": \"environment:MINISVC_DB,MINISVC_READONLY\",\n      \"type\": \"reads_config\"\n    }\n  ],\n  \"key_functions\": [\n    {\n      \"identifier\": \"minisvc.cli:main\",\n      \"kind\": \"function\",\n      \"summary\": \"Main CLI entry point.\",\n      \"details\": \"Loads Settings from os.environ, builds OrderRepository with settings.database_path, initializes the orders table, prints the selected DB path, and returns 0.\",\n      \"inputs\": [\n        \"argv=None (unused)\"\n      ],\n      \"outputs\": [\n        \"int exit code\"\n      ],\n      \"important_notes\": [\n        \"Reads readonly config but does not enforce it.\"\n      ]\n    },\n    {\n      \"identifier\": \"minisvc.config:load_settings\",\n      \"kind\": \"function\",\n      \"summary\": \"Creates runtime Settings from environment variables.\",\n      \"details\": \"Uses MINISVC_DB with default orders.sqlite and sets readonly when MINISVC_READONLY == \\\"1\\\".\",\n      \"inputs\": [\n        \"env: dict[str, str]\"\n      ],\n      \"outputs\": [\n        \"Settings\"\n      ],\n      \"important_notes\": [\n        \"Only this module reads the env vars.\"\n      ]\n    },\n    {\n      \"identifier\": \"minisvc.api.handlers:create_order\",\n      \"kind\": \"function\",\n      \"summary\": \"Create-order request handler.\",\n      \"details\": \"Pulls order_id, customer, and total_cents from payload, coerces total_cents to int, saves the Order, and returns a created response with an embedded audit event.\",\n      \"inputs\": [\n        \"payload: dict\",\n        \"repo: OrderRepository\"\n      ],\n      \"outputs\": [\n        \"dict response\"\n      ],\n      \"important_notes\": [\n        \"No validation layer, retry loop, or readonly guard is present.\"\n      ]\n    },\n    {\n      \"identifier\": \"minisvc.api.handlers:get_order\",\n      \"kind\": \"function\",\n      \"summary\": \"Read-order request handler.\",\n      \"details\": \"Fetches an order by id and returns either a missing response or the order payload plus a read event.\",\n      \"inputs\": [\n        \"order_id: str\",\n        \"repo: OrderRepository\"\n      ],\n      \"outputs\": [\n        \"dict response\"\n      ],\n      \"important_notes\": [\n        \"Returns order.__dict__ directly.\"\n      ]\n    },\n    {\n      \"identifier\": \"minisvc.api.routes:register_routes\",\n      \"kind\": \"function\",\n      \"summary\": \"HTTP route registration hook.\",\n      \"details\": \"Registers POST /orders and GET /orders/<order_id> callbacks on an injected app instance.\",\n      \"inputs\": [\n        \"app\",\n        \"repo\"\n      ],\n      \"outputs\": [\n        \"None\"\n      ],\n      \"important_notes\": [\n        \"The actual web framework and app bootstrap live outside this fixture.\"\n      ]\n    },\n    {\n      \"identifier\": \"minisvc.storage.repo:OrderRepository.init_schema\",\n      \"kind\": \"method\",\n      \"summary\": \"Schema bootstrap.\",\n      \"details\": \"Creates the orders table if it does not exist.\",\n      \"inputs\": [\n        \"self\"\n      ],\n      \"outputs\": [\n        \"None\"\n      ],\n      \"important_notes\": [\n        \"No audit table is created.\"\n      ]\n    },\n    {\n      \"identifier\": \"minisvc.storage.repo:OrderRepository.save\",\n      \"kind\": \"method\",\n      \"summary\": \"Persist a new order.\",\n      \"details\": \"Opens a fresh sqlite3 connection and issues a plain INSERT into orders.\",\n      \"inputs\": [\n        \"self\",\n        \"order: Order\"\n      ],\n      \"outputs\": [\n        \"None\"\n      ],\n      \"important_notes\": [\n        \"No retry, readonly, or duplicate-key handling is present.\"\n      ]\n    },\n    {\n      \"identifier\": \"minisvc.storage.repo:OrderRepository.get\",\n      \"kind\": \"method\",\n      \"summary\": \"Load an order by id.\",\n      \"details\": \"Selects one row from orders and returns Order(*row) when found.\",\n      \"inputs\": [\n        \"self\",\n        \"order_id: str\"\n      ],\n      \"outputs\": [\n        \"Order | None\"\n      ],\n      \"important_notes\": [\n        \"A missing row yields None.\"\n      ]\n    },\n    {\n      \"identifier\": \"minisvc.audit:order_event\",\n      \"kind\": \"function\",\n      \"summary\": \"Build an audit event payload.\",\n      \"details\": \"Returns a dictionary with type, action, order_id, and total_cents fields.\",\n      \"inputs\": [\n        \"order: Order\",\n        \"action: str\"\n      ],\n      \"outputs\": [\n        \"dict\"\n      ],\n      \"important_notes\": [\n        \"Pure formatter only; no storage side effects.\"\n      ]\n    }\n  ],\n  \"runtime_flows\": [\n    {\n      \"name\": \"cli_startup\",\n      \"trigger\": \"minisvc.cli:main via the minisvc console script\",\n      \"steps\": [\n        {\n          \"order\": 1,\n          \"component\": \"minisvc.cli:main\",\n          \"action\": \"Read process environment and call minisvc.config:load_settings.\"\n        },\n        {\n          \"order\": 2,\n          \"component\": \"minisvc.config:load_settings\",\n          \"action\": \"Resolve database_path from MINISVC_DB or default to orders.sqlite; parse readonly from MINISVC_READONLY.\"\n        },\n        {\n          \"order\": 3,\n          \"component\": \"minisvc.cli:main\",\n          \"action\": \"Instantiate minisvc.storage.repo:OrderRepository with settings.database_path.\"\n        },\n        {\n          \"order\": 4,\n          \"component\": \"minisvc.storage.repo:OrderRepository.init_schema\",\n          \"action\": \"Open sqlite3 connection and create the orders table if missing.\"\n        },\n        {\n          \"order\": 5,\n          \"component\": \"minisvc.cli:main\",\n          \"action\": \"Print readiness message and exit with code 0.\"\n        }\n      ]\n    },\n    {\n      \"name\": \"http_create_order\",\n      \"trigger\": \"POST /orders after an external app calls minisvc.api.routes:register_routes\",\n      \"steps\": [\n        {\n          \"order\": 1,\n          \"component\": \"minisvc.api.routes:register_routes\",\n          \"action\": \"Bind POST /orders to a lambda that forwards payload and repo to minisvc.api.handlers:create_order.\"\n        },\n        {\n          \"order\": 2,\n          \"component\": \"minisvc.api.handlers:create_order\",\n          \"action\": \"Read order_id, customer, and total_cents from the request payload and build an Order dataclass.\"\n        },\n        {\n          \"order\": 3,\n          \"component\": \"minisvc.storage.repo:OrderRepository.save\",\n          \"action\": \"Open sqlite3 connection and insert the order row into the orders table.\"\n        },\n        {\n          \"order\": 4,\n          \"component\": \"minisvc.audit:order_event\",\n          \"action\": \"Build a created-event dictionary from the saved order.\"\n        },\n        {\n          \"order\": 5,\n          \"component\": \"minisvc.api.handlers:create_order\",\n          \"action\": \"Return a response dict with status=created, order_id, and the event payload.\"\n        }\n      ]\n    },\n    {\n      \"name\": \"http_get_order\",\n      \"trigger\": \"GET /orders/<order_id> after an external app calls minisvc.api.routes:register_routes\",\n      \"steps\": [\n        {\n          \"order\": 1,\n          \"component\": \"minisvc.api.routes:register_routes\",\n          \"action\": \"Bind GET /orders/<order_id> to a lambda that forwards the path parameter and repo to minisvc.api.handlers:get_order.\"\n        },\n        {\n          \"order\": 2,\n          \"component\": \"minisvc.api.handlers:get_order\",\n          \"action\": \"Call repo.get(order_id) to load an Order or None.\"\n        },\n        {\n          \"order\": 3,\n          \"component\": \"minisvc.storage.repo:OrderRepository.get\",\n          \"action\": \"Select the row from sqlite and materialize Order(*row) when present.\"\n        },\n        {\n          \"order\": 4,\n          \"component\": \"minisvc.api.handlers:get_order\",\n          \"action\": \"Return a missing response when no row exists, else return order.__dict__ plus a read event.\"\n        }\n      ]\n    }\n  ]\n}\n"}}}}
