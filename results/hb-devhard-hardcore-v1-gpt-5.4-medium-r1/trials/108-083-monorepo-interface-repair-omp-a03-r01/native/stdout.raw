ec(spec)\n25:    spec.loader.exec_module(module)\n26:    return module\n27:\n28:\n29:def main(argv: list[str]) -> int:\n30:    test_files = iter_test_files(argv[1:])\n31:    total = 0\n32:    failed = 0\n33:    for index, path in enumerate(test_files):\n34:        module = load_module(path, index)\n35:        for name, fn in sorted(inspect.getmembers(module, inspect.isfunction)):\n36:            if not name.startswith(\"test_\"):\n37:                continue\n38:            total += 1\n39:            try:\n40:                fn()\n41:                sys.stdout.write('.')\n42:                sys.stdout.flush()\n43:            except Exception as exc:\n44:                failed += 1\n45:                sys.stdout.write('F')\n46:                sys.stdout.flush()\n47:                sys.stdout.write(f\"\\n\\nFAIL {path}::{name}\\n{type(exc).__name__}: {exc}\\n\")\n48:    sys.stdout.write(f\"\\n{total - failed} passed, {failed} failed\\n\")\n49:    return 1 if failed else 0\n50:\n51:\n52:if __name__ == \"__main__\":\n53:    raise SystemExit(main(sys.argv))\n54:"}],"details":{"totalLines":54,"displayContent":{"text":"from __future__ import annotations\n\nimport importlib.util\nimport inspect\nimport sys\nfrom pathlib import Path\n\n\ndef iter_test_files(paths: list[str]) -> list[Path]:\n    files: list[Path] = []\n    for raw_path in paths or [\"tests\"]:\n        path = Path(raw_path)\n        if path.is_dir():\n            files.extend(sorted(path.rglob(\"test_*.py\")))\n        elif path.is_file() and path.name.startswith(\"test_\") and path.suffix == \".py\":\n            files.append(path)\n    return files\n\n\ndef load_module(path: Path, index: int):\n    spec = importlib.util.spec_from_file_location(f\"_pytest_{index}\", path)\n    if spec is None or spec.loader is None:\n        raise RuntimeError(f\"Unable to load {path}\")\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef main(argv: list[str]) 