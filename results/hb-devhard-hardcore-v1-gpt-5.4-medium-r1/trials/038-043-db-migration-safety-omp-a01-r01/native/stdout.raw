COUNT(*) AS actual, 4 AS expected\\nFROM orders\", 'columns': ['check_name', 'actual', 'expected'], 'rows': [('orders_count', 4, 4)]}, {'sql': \"-- Dirty-user orders must still reference the same user ids.\\nSELECT o.id AS order_id, o.user_id, u.email, u.status\\nFROM orders AS o\\nJOIN users AS u ON u.id = o.user_id\\nWHERE o.user_id IN ('u4', 'u5', 'u6')\\nORDER BY o.id\", 'columns': ['order_id', 'user_id', 'email', 'status'], 'rows': [('o2', 'u4', 'ada+u4@example.com', 'active'), ('o3', 'u5', 'missing+u5@example.invalid', 'active'), ('o4', 'u6', 'missing+u6@example.invalid', 'active')]}, {'sql': \"-- Dirty emails must be cleaned to deterministic values.\\nSELECT id, email\\nFROM users\\nWHERE id IN ('u4', 'u5', 'u6')\\nORDER BY id\", 'columns': ['id', 'email'], 'rows': [('u4', 'ada+u4@example.com'), ('u5', 'missing+u5@example.invalid'), ('u6', 'missing+u6@example.invalid')]}, {'sql': \"-- Historical timestamps must remain unchanged for migrated rows.\\nSELECT id, created_at\\nFROM users\\nWHERE id IN ('u4', 'u5', 'u6')\\nORDER BY id\", 'columns': ['id', 'created_at'], 'rows': [('u4', '2023-12-01T08:00:00Z'), ('u5', '2023-11-05T12:00:00Z'), ('u6', '2023-10-06T07:45:00Z')]}, {'sql': \"-- All users must have non-null, non-blank, unique emails and active status after migration.\\nSELECT\\n    SUM(CASE WHEN email IS NULL THEN 1 ELSE 0 END) AS null_emails,\\n    SUM(CASE WHEN trim(email) = '' THEN 1 ELSE 0 END) AS blank_emails,\\n    COUNT(*) - COUNT(DISTINCT email) AS duplicate_emails,\\n    SUM(CASE WHEN status IS NULL THEN 1 ELSE 0 END) AS null_statuses,\\n    SUM(CASE WHEN status <> 'active' THEN 1 ELSE 0 END) AS non_active_statuses\\nFROM users\", 'columns': ['null_emails', 'blank_emails', 'duplicate_emails', 'null_statuses', 'non_active_statuses'], 'rows': [(0, 0, 0, 0, 0)]}, {'sql': \"-- Schema-level checks for post-migration constraints.\\nSELECT sql\\nFROM sqlite_master\\nWHERE type = 'table'\\n  AND name = 'users'\", 'columns': ['sql'], 'rows': [(\"CREATE TABLE users (\\n    id TEXT PRIMARY KEY,\\n    email TEXT NOT NULL UNIQUE,\\n    name TEXT NOT NULL,\\n    status TEXT NOT NULL DEFAULT 'active',\\n    created_at TEXT NOT NULL,\\n    CONSTRAINT users_email_not_blank CHECK (trim(email) <> '')\\n)\",)]}, {'sql': \"PRAGMA index_list('users')\", 'columns': ['seq', 'name', 'unique', 'origin', 'partial'], 'rows': [(0, 'sqlite_autoindex_users_2', 1, 'u', 0), (1, 'sqlite_autoindex_users_1', 1, 'pk', 0)]}, {'sql': 'PRAGMA foreign_key_check', 'columns': ['table', 'rowid', 'parent', 'fkid'], 'rows': [('orders', 1, 'users__migration_old', 0), ('orders', 2, 'users__migration_old', 0), ('orders', 3, 'users__migration_old', 0), ('orders', 4, 'users__migration_old', 0)]}], 'rollback_table_info': [(0, 'id', 'TEXT', 0, None, 1), (1, 'email', 'TEXT', 0, None, 0), (2, 'name', 'TEXT', 1, None, 0), (3, 'created_at', 'TEXT', 1, None, 0)], 'after_rollback_users': [('u1', 'ada@example.com', 'Ada', '2024-01-02T10:00:00Z'), ('u2', 'lin@example.com', 'Lin', '2024-02-03T11:30:00Z'), ('u3', 'grace@example.com', 'Grace', '2024-03-04T09:15:00Z'), ('u4', 'ada+u4@example.com', 'Ada Legacy', '2023-12-01T08:00:00Z'), ('u5', 'missing+u5@example.invalid', 'Null Email Legacy', '2023-11-05T12:00:00Z'), ('u6', 'missing+u6@example.invalid', 'Blank Email Legacy', '2023-10-06T07:45:00Z')], 'after_rollback_orders': 4, 'after_rollback_fk': [('orders', 1, 'users__migration_old', 0), ('orders', 2, 'users__migration_old', 0), ('orders', 3, 'users__migration_old', 0), ('orders', 4, 'users__migration_old', 0)]}\n"}],"details":{"language":"python","languages":["python"],"cells":[{"index":0,"title":"verify migration offline","code":"import sqlite3, tempfile, pathlib\nbase = pathlib.Path('/workspace/in/db')\nschema_sql = base.joinpath('schema.sql').read_text()\nmigration_sql = base.joinpath('migration.sql').read_text()\npostcheck_sql = base.joinpath('postcheck.sql').read_text()\nrollback_sql = base.joinpath('rollback.sql').read_text()\n\ndef run_script(conn, sql):\n    c