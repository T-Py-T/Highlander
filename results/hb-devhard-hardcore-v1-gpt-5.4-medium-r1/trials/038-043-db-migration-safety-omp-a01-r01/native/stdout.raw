{"type":"message_update","assistantMessageEvent":{"type":"toolcall_delta","contentIndex":2,"delta":"{\"i\":\"Writing rollback script\",\"path\":\"in/db/rollback.sql\",\"content\":\"PRAGMA foreign_keys = OFF;\\n\\nBEGIN IMMEDIATE;\\n\\nDROP TABLE IF EXISTS users__rollback_old;\\n\\nALTER TABLE users RENAME TO users__rollback_old;\\n\\nCREATE TABLE users (\\n    id TEXT PRIMARY KEY,\\n    email TEXT,\\n    name TEXT NOT NULL,\\n    created_at TEXT NOT NULL\\n);\\n\\nINSERT INTO users (id, email, name, created_at)\\nSELECT id, email, name, created_at\\nFROM users__rollback_old;\\n\\nDROP TABLE users__rollback_old;\\n\\nCOMMIT;\\n\\nPRAGMA foreign_keys = ON;\\n\"}"}}
{"type":"message_update","assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"call_1B0WKdn2CjwtOFnzjOzGN8Xu|fc_0379b9feef091598016a959c62af3c87d2b14150226058984d","name":"write","arguments":{"i":"Writing rollback script","path":"in/db/rollback.sql","content":"PRAGMA foreign_keys = OFF;\n\nBEGIN IMMEDIATE;\n\nDROP TABLE IF EXISTS users__rollback_old;\n\nALTER TABLE users RENAME TO users__rollback_old;\n\nCREATE TABLE users (\n    id TEXT PRIMARY KEY,\n    email TEXT,\n    name TEXT NOT NULL,\n    created_at TEXT NOT NULL\n);\n\nINSERT INTO users (id, email, name, created_at)\nSELECT id, email, name, created_at\nFROM users__rollback_old;\n\nDROP TABLE users__rollback_old;\n\nCOMMIT;\n\nPRAGMA foreign_keys = ON;\n"}}}}
