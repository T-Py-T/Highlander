      \"o4\",\n      \"u6\",\n      \"missing+u6@example.invalid\"\n    ]\n  ],\n  \"after_first_fk\": [],\n  \"after_second_users\": [\n    [\n      \"u1\",\n      \"ada@example.com\",\n      \"active\",\n      \"2024-01-02T10:00:00Z\"\n    ],\n    [\n      \"u2\",\n      \"lin@example.com\",\n      \"active\",\n      \"2024-02-03T11:30:00Z\"\n    ],\n    [\n      \"u3\",\n      \"grace@example.com\",\n      \"active\",\n      \"2024-03-04T09:15:00Z\"\n    ],\n    [\n      \"u4\",\n      \"ada+u4@example.com\",\n      \"active\",\n      \"2023-12-01T08:00:00Z\"\n    ],\n    [\n      \"u5\",\n      \"missing+u5@example.invalid\",\n      \"active\",\n      \"2023-11-05T12:00:00Z\"\n    ],\n    [\n      \"u6\",\n      \"missing+u6@example.invalid\",\n      \"active\",\n      \"2023-10-06T07:45:00Z\"\n    ]\n  ],\n  \"after_second_fk\": [],\n  \"postcheck\": [\n    {\n      \"sql\": \"-- Row counts should remain unchanged.\\nSELECT 'users_count' AS check_name, COUNT(*) AS actual, 6 AS expected\\nFROM users\",\n      \"columns\": [\n        \"check_name\",\n        \"actual\",\n        \"expected\"\n      ],\n      \"rows\": [\n        [\n          \"users_count\",\n          6,\n          6\n        ]\n      ]\n    },\n    {\n      \"sql\": \"SELECT 'orders_count' AS check_name, COUNT(*) AS actual, 4 AS expected\\nFROM orders\",\n      \"columns\": [\n        \"check_name\",\n        \"actual\",\n        \"expected\"\n      ],\n      \"rows\": [\n        [\n          \"orders_count\",\n          4,\n          4\n        ]\n      ]\n    },\n    {\n      \"sql\": \"-- Dirty-user orders must still reference the same user ids.\\nSELECT o.id AS order_id, o.user_id, u.email, u.status\\nFROM orders AS o\\nJOIN users AS u ON u.id = o.user_id\\nWHERE o.user_id IN ('u4', 'u5', 'u6')\\nORDER BY o.id\",\n      \"columns\": [\n        \"order_id\",\n        \"user_id\",\n        \"email\",\n        \"status\"\n      ],\n      \"rows\": [\n        [\n          \"o2\",\n          \"u4\",\n          \"ada+u4@example.com\",\n          \"active\"\n        ],\n        [\n          \"o3\",\n          \"u5\",\n          \"missing+u5@example.invalid\",\n          \"active\"\n        ],\n        [\n          \"o4\",\n          \"u6\",\n          \"missing+u6@example.invalid\",\n          \"active\"\n        ]\n      ]\n    },\n    {\n      \"sql\": \"-- Dirty emails must be cleaned to deterministic values.\\nSELECT id, email\\nFROM users\\nWHERE id IN ('u4', 'u5', 'u6')\\nORDER BY id\",\n      \"columns\": [\n        \"id\",\n        \"email\"\n      ],\n      \"rows\": [\n        [\n          \"u4\",\n          \"ada+u4@example.com\"\n        ],\n        [\n          \"u5\",\n          \"missing+u5@example.invalid\"\n        ],\n        [\n          \"u6\",\n          \"missing+u6@example.invalid\"\n        ]\n      ]\n    },\n    {\n      \"sql\": \"-- Historical timestamps must remain unchanged for migrated rows.\\nSELECT id, created_at\\nFROM users\\nWHERE id IN ('u4', 'u5', 'u6')\\nORDER BY id\",\n      \"columns\": [\n        \"id\",\n        \"created_at\"\n      ],\n      \"rows\": [\n        [\n          \"u4\",\n          \"2023-12-01T08:00:00Z\"\n        ],\n        [\n          \"u5\",\n          \"2023-11-05T12:00:00Z\"\n        ],\n        [\n          \"u6\",\n          \"2023-10-06T07:45:00Z\"\n        ]\n      ]\n    },\n    {\n      \"sql\": \"-- All users must have non-null, non-blank, unique emails and active status after migration.\\nSELECT\\n    SUM(CASE WHEN email IS NULL THEN 1 ELSE 0 END) AS null_emails,\\n    SUM(CASE WHEN trim(email) = '' THEN 1 ELSE 0 END) AS blank_emails,\\n    COUNT(*) - COUNT(DISTINCT email) AS duplicate_emails,\\n    SUM(CASE WHEN status IS NULL THEN 1 ELSE 0 END) AS null_statuses,\\n    SUM(CASE WHEN status <> 'active' THEN 1 ELSE 0 END) AS non_active_statuses\\nFROM users\",\n      \"columns\": [\n        \"null_emails\",\n        \"blank_emails\",\n        \"duplicate_emails\",\n        \"null_statuses\",\n        \"non_active_statuses\"\n      ],\n      \"rows\": [\n        [\n          0,\n          0,\n          0,\n          0,\n          0\n        ]\n      ]\n    },\n    {\n      \"sql\": \"-- Schema-level checks for post-migration constraints.\\nSELECT sql\\nFROM sqlite_master\\nWHERE type = 'table'\\n  AND name = 'users'\",\n      \"columns\": [\n        \"sql\"\n      ],\n      \"rows\": [\n        [\n          \"CREATE TABLE users (\\n    id TEXT PRIMARY KEY,\\n    email TEXT NOT NULL UNIQUE,\\n    name TEXT NOT NULL,\\n    status TEXT NOT NULL DEFAULT 'active',\\n    created_at TEXT NOT NULL,\\n    CONSTRAINT users_email_not_blank CHECK (trim(email) <> '')\\n)\"\n        ]\n      ]\n    },\n    {\n      \"sql\": \"PRAGMA index_list('users')\",\n      \"columns\": [\n        \"seq\",\n        \"name\",\n        \"unique\",\n        \"origin\",\n        \"partial\"\n      ],\n      \"rows\": [\n        [\n          0,\n          \"sqlite_autoindex_users_2\",\n          1,\n          \"u\",\n          0\n        ],\n        [\n          1,\n          \"sqlite_autoindex_users_1\",\n          1,\n          \"pk\",\n          0\n        ]\n      ]\n    },\n    {\n      \"sql\": \"PRAGMA foreign_key_check\",\n      \"columns\": [\n        \"table\",\n        \"rowid\",\n        \"parent\",\n        \"fkid\"\n      ],\n      \"rows\": []\n    }\n  ],\n  \"rollback_table_info\": [\n    [\n      0,\n      \"id\",\n      \"TEXT\",\n      0,\n      null,\n      1\n    ],\n    [\n      1,\n      \"email\",\n      \"TEXT\",\n      0,\n      null,\n      0\n    ],\n    [\n      2,\n      \"name\",\n      \"TEXT\",\n      1,\n      null,\n      0\n    ],\n    [\n      3,\n      \"created_at\",\n      \"TEXT\",\n      1,\n      null,\n      0\n    ]\n  ],\n  \"after_rollback_users\": [\n    [\n      \"u1\",\n      \"ada@example.com\",\n      \"Ada\",\n      \"2024-01-02T10:00:00Z\"\n    ],\n    [\n      \"u2\",\n      \"lin@example.com\",\n      \"Lin\",\n      \"2024-02-03T11:30:00Z\"\n    ],\n    [\n      \"u3\",\n      \"grace@example.com\",\n      \"Grace\",\n      \"2024-03-04T09:15:00Z\"\n    ],\n    [\n      \"u4\",\n      \"ada+u4@example.com\",\n      \"Ada Legacy\",\n      \"2023-12-01T08:00:00Z\"\n    ],\n    [\n      \"u5\",\n      \"missing+u5@example.invalid\",\n      \"Null Email Legacy\",\n      \"2023-11-05T12:00:00Z\"\n    ],\n    [\n      \"u6\",\n      \"missing+u6@example.invalid\",\n      \"Blank Email Legacy\",\n      \"2023-10-06T07:45:00Z\"\n    ]\n  ],\n  \"after_rollback_orders\": 4,\n  \"after_rollback_fk\": []\n}\n\n[Some lines truncated to 768 chars]"}],"details":{"language":"python","languages":["python"],"cells":[{"index":0,"title":"reverify migration offline","code":"import sqlite3, tempfile, pathlib, json\nbase = pathlib.Path('/workspace/in/db')\nschema_sql = base.joinpath('schema.sql').read_text()\nmigration_sql = base.joinpath('migration.sql').read_text()\npostcheck_sql = base.joinpath('postcheck.sql').read_text()\nrollback_sql = base.joinpath('rollback.sql').read_text()\n\ndef run_script(conn, sql):\n    conn.executescript(sql)\n\ndef run_postcheck(conn, sql):\n    out = []\n    for stmt in [s.strip() for s in sql.split(';') if s.strip()]:\n        cur = conn.execute(stmt)\n        if cur.description:\n            cols = [d[0] for d in cur.description]\n            rows = cur.fetchall()\n            out.append({'sql': stmt, 'columns': cols, 'rows': rows})\n    return out\n\ntmpdir = pathlib.Path(tempfile.mkdtemp())\ndb = tmpdir / 'test.db'\nconn = sqlite3.connect(db)\nrun_script(conn, schema_sql)\ninitial_counts = {\n    'users': conn.execute('select count(*) from users').fetchone()[0],\n    'orders': conn.execute('select count(*) from orders').fetchone()[0],\n}\nrun_script(conn, migration_sql)\nafter_first_users = conn.execute('select id, email, status, created_at from users order by id').fetchall()\nafter_first_orders = conn.execute(\"select o.id, o.user_id, u.email from orders o join users u on u.id = o.user_id where o.user_id in ('u4','u5','u6') order by o.id\").fetchall()\nafter_first_fk = conn.execute('pragma foreign_key_check').fetchall()\nrun_script(conn, migration_sql)\nafter_second_users = conn.execute('select id, email, status, created_at from users order by id').fetchall()\nafter_second_fk = conn.execute('pragma foreign_key_check').fetchall()\npostcheck = run_postcheck(conn, postcheck_sql)\nrun_script(conn, rollback_sql)\nrollback_table_info = conn.execute('pragma table_info(users)').fetchall()\nafter_rollback_users = conn.execute('select id, email, name, created_at from users order by id').fetchall()\nafter_rollback_orders = conn.execute('select count(*) from orders').fetchone()[0]\nafter_rollback_fk = conn.execute('pragma foreign_key_check').fetchall()\nconn.close()\ndisplay({\n    'db': str(db),\n    'initial_counts': initial_counts,\n    'after_first_users': after_first_users,\n    'after_first_dirty_orders': after_first_orders,\n    'after_first_fk': after_first_fk,\n    'after_second_users': after_second_users,\n    'after_second_fk': after_second_fk,\n    'postcheck': postcheck,\n    'rollback_table_info': rollback_table_info,\n    'after_rollback_users': after_rollback_users,\n    'after_rollback_orders': after_rollback_orders,\n    'after_rollback_fk': after_rollback_fk,\n})","language":"python","output":"{'db': '/tmp/tmpxs9ynwn4/test.db', 'initial_counts': {'users': 6, 'orders': 4}, 'after_first_users': [('u1', 'ada@example.com', 'active', '2024-01-02T10:00:00Z'), ('u2', 'lin@example.com', 'active', '2024-02-03T11:30:00Z'), ('u3', 'grace@example.com', 'active', '2024-03-04T09:15:00Z'), ('u4', 'ada+u4@example.com', 'active', '2023-12-01T08:00:00Z'), ('u5', 'missing+u5@example.invalid', 'active', '2023-11-05T12:00:00Z'), ('u6', 'missing+u6@example.invalid', 'active', '2023-10-06T07:45:00Z')], 'after_first_dirty_orders': [('o2', 'u4', 'ada+u4@example.com'), ('o3', 'u5', 'missing+u5@example.invalid'), ('o4', 'u6', 'missing+u6@example.i