COUNT(*) AS actual, 4 AS expected\\nFROM orders\", 'columns': ['check_name', 'actual', 'expected'], 'rows': [('orders_count', 4, 4)]}, {'sql': \"-- Dirty-user orders must still reference the same user ids.\\nSELECT o.id AS order_id, o.user_id, u.email, u.status\\nFROM orders AS o\\nJOIN users AS u ON u.id = o.user_id\\nWHERE o.user_id IN ('u4', 'u5', 'u6')\\nORDER BY o.id\", 'columns': ['order_id', 'user_id', 'email', 'status'], 'rows': [('o2', 'u4', 'ada+u4@example.com', 'active'), ('o3', 'u5', 'missing+u5@example.invalid', 'active'), ('o4', 'u6', 'missing+u6@example.invalid', 'active')]}, {'sql': \"-- Dirty emails must be cleaned to deterministic values.\\nSELECT id, email\\nFROM users\\nWHERE id IN ('u4', 'u5', 'u6')\\nORDER BY id\", 'columns': ['id', 'email'], 'rows': [('u4', 'ada+u4@example.com'), ('u5', 'missing+u5@example.invalid'), ('u6', 'missing+u6@example.invalid')]}, {'sql': \"-- Historical timestamps must remain unchanged for migrated rows.\\nSELECT id, created_at\\nFROM users\\nWHERE id IN ('u4', 'u5', 'u6')\\nORDER BY id\", 'columns': ['id', 'created_at'], 'rows': [('u4', '2023-12-01T08:00:00Z'), ('u5', '2023-11-05T12:00:00Z'), ('u6', '2023-10-06T07:45:00Z')]}, {'sql': \"-- All users must have non-null, non-blank, unique emails and active status after migration.\\nSELECT\\n    SUM(CASE WHEN email IS NULL THEN 1 ELSE 0 END) AS null_emails,\\n    SUM(CASE WHEN trim(email) = '' THEN 1 ELSE 0 END) AS blank_emails,\\n    COUNT(*) - COUNT(DISTINCT email) AS duplicate_emails,\\n    SUM(CASE WHEN status IS NULL THEN 1 ELSE 0 END) AS null_statuses,\\n    SUM(CASE WHEN status <> 'active' THEN 1 ELSE 0 END) AS non_active_statuses\\nFROM users\", 'columns': ['null_emails', 'blank_emails', 'duplicate_emails', 'null_statuses', 'non_active_statuses'], 'rows': [(0, 0, 0, 0, 0)]}, {'sql': \"-- Schema-level checks for post-migration constraints.\\nSELECT sql\\nFROM sqlite_master\\nWHERE type = 'table'\\n  AND name = 'users'\", 'columns': ['sql'], 'rows': [(\"CREATE TAB