{"type":"tool_execution_end","toolCallId":"call_lIm6mPI1l9wJ0gL0UcjoQse5|fc_086b1e7df4a595ff016a95fcb7934c87d2b5cedd088e8801ee","toolName":"read","result":{"content":[{"type":"text","text":"[in/composeapp/tools/validate_compose.py#AA73]\n1:from __future__ import annotations\n2:\n3:from pathlib import Path\n4:\n5:import yaml\n6:\n7:\n8:ROOT = Path(__file__).resolve().parents[1]\n9:compose = yaml.safe_load((ROOT / \"compose.yaml\").read_text(encoding=\"utf-8\"))\n10:policy = yaml.safe_load((ROOT / \"config\" / \"service-policy.yml\").read_text(encoding=\"utf-8\"))\n11:\n12:services = compose.get(\"services\", {})\n13:required_services = {\"api\", \"worker\", \"db\", \"redis\"}\n14:missing = required_services.difference(services)\n15:assert not missing, f\"missing services: {sorted(missing)}\"\n16:assert \"cache\" not in services, \"service must be named redis, not cache\"\n17:\n18:for name, expected in policy[\"services\"].items():\n19:    svc = services[name]\n20:    assert svc.get(\"image\") == expected[\"image\"], f\"{name} image mismatch\"\n21:    assert \":latest\" not in svc.get(\"image\", \"\"), f\"{name} must not use latest\"\n22:    if \"required_env\" in expected:\n23:        env = svc.get(\"environment\", {})\n24:        for key in expected[\"required_env\"]:\n25:            assert key in env, f\"{name} missing env {key}\"\n26:    if \"depends_on\" in expected:\n27:        deps = svc.get(\"depends_on\", {})\n28:        assert isinstance(deps, dict), f\"{name} depends_on must use conditions\"\n29:        for dep, condition in expected[\"depends_on\"].items():\n30:            assert deps.get(dep, {}).get(\"condition\") == condition, f\"{name} dependency {dep} must be {condition}\"\n31:\n32:api = services[\"api\"]\n33:assert api.get(\"ports\") == [\"${API_PORT:-8080}:8000\"], \"api port mapping must use API_PORT and container 8000\"\n34:health = api.get(\"healthcheck\", {}).get(\"test\", [])\n35:assert any(\"/healthz\" in str(part) for part in health), \"api healthcheck must call /healthz\"\n36:assert api[\"environment\"][\"REDIS_URL\"].endswith(\"redis:6379/0}\"), \"api redis URL must point at redis service\"\n37:assert api[\"environment\"][\"APP_DATA_DIR\"] == \"/data\", \"api data dir must match mounted target\"\n38:assert api[\"environment\"][\"QUEUE_NAME\"] == policy[\"services\"][\"worker\"][\"queue_name\"], \"api queue mismatch\"\n39:assert any(str(item) in {\"api-data:/data\", \"api-data:/data:rw\"} for item in api.get(\"volumes\", [])), \"api volume must mount api-data to /data\"\n40:assert services[\"worker\"][\"environment\"][\"QUEUE_NAME\"] == policy[\"services\"][\"worker\"][\"queue_name\"], \"worker queue mismatch\"\n41:db_health = services[\"db\"].get(\"healthcheck\", {}).get(\"test\", [])\n42:redis_health = services[\"redis\"].get(\"healthcheck\", {}).get(\"test\", [])\n43:assert any(\"pg_isready\" in str(part) for part in db_health), \"db healthcheck must use pg_isready\"\n44:assert any(\"redis-cli\" in str(part) for part in redis_health) and any(\"ping\" in str(part).lower() for part in redis_health), \"redis healthcheck must use redis-cli ping\"\n45:assert \"api-data\" in compose.get(\"volumes\", {}), \"top-level api-data volume must exist\"\n46:\n47:env_example = {}\n48:for line in (ROOT / \".env.example\").read_text(encoding=\"utf-8\").splitlines():\n49:    if \"=\" in line and not line.lstrip().startswith(\"#\"):\n50:        key, value = line.split(\"=\", 1)\n51:        env_example[key] = value\n52:assert env_example.get(\"API_PORT\") == \"8080\", \".env.example must document API_PORT=8080\"\n53:assert env_example.get(\"REDIS_URL\") == \"redis://redis:6379/0\", \".env.example must document redis service URL\"\n54:assert env_example.get(\"QUEUE_NAME\") == policy[\"services\"][\"worker\"][\"queue_name\"], \".env.example must document critical queue\"\n55:assert env_example.get(\"APP_DATA_DIR\") == \"/data\", \".env.example must document /data mount\"\n56:print(\"compose contract ok\")"}],"details":{"m