nes[i]\n        while len(stack)>1 and indent <= stack[-1][0]:\n            stack.pop()\n        parent=stack[-1][1]\n        if content.startswith('- '):\n            item=content[2:]\n            if not isinstance(parent, list):\n                raise TypeError(('list item in non-list', indent, content, type(parent)))\n            if ': ' in item or item.endswith(':'):\n                key, rest = item.split(':',1)\n                obj={}\n                parent.append(obj)\n                if rest.strip():\n                    obj[key]=parse_scalar(rest.strip())\n                else:\n                    obj[key]={}\n                    stack.append((indent, obj))\n                    stack.append((indent+1, obj[key]))\n            else:\n                parent.append(parse_scalar(item))\n            i+=1\n            continue\n        key, sep, rest = content.partition(':')\n        if not sep:\n            raise ValueError(content)\n        rest=rest.strip()\n        if rest:\n            val=parse_scalar(rest)\n            parent[key]=val\n        else:\n            # infer child type from next line\n            next_indent = lines[i+1][0] if i+1 < len(lines) else None\n            next_content = lines[i+1][1] if i+1 < len(lines) else None\n            if next_content is not None and next_indent > indent and next_content.startswith('- '):\n                val=[]\n            else:\n                val={}\n            parent[key]=val\n            stack.append((indent, val))\n        i+=1\n    return root\n\nfor p in ['compose.yaml','config/service-policy.yml']:\n    print(p, parse_yaml(Path('/workspace/in/composeapp')/p if '/' not in p else Path('/workspace/in/composeapp')/p))\nPY","timeout":20}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":164,"output":832,"cacheRead":23040,"cacheWrite":0,"reasoning":122,"totalTokens":24036,"cost":{"input":0.00041000000000000005,"output":0.01248,"cacheRead":0.0057599999999999995