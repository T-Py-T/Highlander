{"type":"tool_execution_end","toolCallId":"call_DdFDDBSKhgewVoeekanqVSXu|fc_035e5edbe17ce7e1016a95f6d6d17487d2bbc5dd6e6b5ecb4c","toolName":"read","result":{"content":[{"type":"text","text":"[in/shopmono/tests/test_catalog_contract.py#823E]\n1:from catalog.models import Money, Product\n2:from orders.adapter import currency, price_cents\n3:\n4:\n5:def test_new_money_product_contract():\n6:    product = Product(\"PEN\", \"Pen\", Money(125, \"USD\"))\n7:    assert price_cents(product) == 125\n8:    assert currency(product) == \"USD\"\n9:\n10:\n11:def test_legacy_product_dict_contract():\n12:    product = {\"sku\": \"PAD\", \"name\": \"Pad\", \"price_cents\": \"300\", \"currency\": \"USD\"}\n13:    assert price_cents(product) == 300\n14:    assert currency(product) == \"USD\""}],"details":{"meta":{"source":"/workspace/in/shopmono/tests/test_catalog_contract.py","sourcePath":"/workspace/in/shopmono/tests/test_catalog_contract.py"}}},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_INsOQf43bFPagniuhRuke9Bw|fc_035e5edbe17ce7e1016a95f6d6d16487d2a0b4ec9493d873c7","toolName":"read","result":{"content":[{"type":"text","text":"[in/shopmono/docs/interface_change.md#909A]\n1:# Catalog Price Interface Change\n2:\n3:Catalog product records now expose `price` as a `Money` object with `amount_cents` and `currency`.\n4:\n5:Legacy import jobs may still pass dictionaries with `price_cents`. Downstream packages should adapt both shapes at their own boundary and must reject mixed-currency orders."}],"details":{"meta":{"source":"/workspace/in/shopmono/docs/interface_change.md","sourcePath":"/workspace/in/shopmono/docs/interface_change.md"}}},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_q2vqqpv4YH0GEurirBKOmzWM|fc_035e5edbe17ce7e1016a95f6d6d16c87d29933aa3edbdcfe6f","toolName":"read","result":{"content":[{"type":"text","text":"[in/shopmono/tests/test_orders_report_integration.py#6F1F]\n1:import pytest\n2:\n3:from catalog.pricing import sample_catalog\n4:from orders.service import price_order\n5:from reports.monthly import summarize_orders\n6:\n7:\n8:def test_order_prices_catalog_money_objects():\n9:    catalog = sample_catalog()\n10:    assert price_order([{\"sku\": \"PEN\", \"quantity\": 2}, {\"sku\": \"PAD\", \"quantity\": 1}], catalog) == {\n11:        \"total_cents\": 550,\n12:        \"currency\": \"USD\",\n13:    }\n14:\n15:\n16:def test_reports_group_by_currency():\n17:    catalog = sample_catalog()\n18:    result = summarize_orders(\n19:        [\n20:            {\"id\": \"o1\", \"lines\": [{\"sku\": \"PEN\", \"quantity\": 2}]},\n21:            {\"id\": \"o2\", \"lines\": [{\"sku\": \"MUG\", \"quantity\": 1}]},\n22:        ],\n23:        catalog,\n24:    )\n25:    assert result == {\"order_count\": 2, \"revenue_by_currency\": {\"USD\": 250, \"EUR\": 700}}\n26:\n27:\n28:def test_mixed_currency_order_is_rejected():\n29:    catalog = sample_catalog()\n30:    with pytest.raises(ValueError, match=\"mixed\"):\n31:        price_order([{\"sku\": \"PEN\", \"quantity\": 1}, {\"sku\": \"MUG\", \"quantity\": 1}], catalog)"}],"details":{"meta":{"source":"/workspace/in/shopmono/tests/test_orders_report_integration.py","sourcePath":"/workspace/in/shopmono/tests/test_orders_report_integration.py"}}},"isError":false}
