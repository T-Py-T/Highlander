:    assert price_order([{\"sku\": \"PEN\", \"quantity\": 2}, {\"sku\": \"PAD\", \"quantity\": 1}], catalog) == {\n11:        \"total_cents\": 550,\n12:        \"currency\": \"USD\",\n13:    }\n14:\n15:\n16:def test_reports_group_by_currency():\n17:    catalog = sample_catalog()\n18:    result = summarize_orders(\n19:        [\n20:            {\"id\": \"o1\", \"lines\": [{\"sku\": \"PEN\", \"quantity\": 2}]},\n21:            {\"id\": \"o2\", \"lines\": [{\"sku\": \"MUG\", \"quantity\": 1}]},\n22:        ],\n23:        catalog,\n24:    )\n25:    assert result == {\"order_count\": 2, \"revenue_by_currency\": {\"USD\": 250, \"EUR\": 700}}\n26:\n27:\n28:def test_mixed_currency_order_is_rejected():\n29:    catalog = sample_catalog()\n30:    with pytest.raises(ValueError, match=\"mixed\"):\n31:        price_order([{\"sku\": \"PEN\", \"quantity\": 1}, {\"sku\": \"MUG\", \"quantity\": 1}], catalog)"}],"details":{"meta":{"source":"/workspace/in/shopmono/tests/test_orders_report_integration.py","sourcePath":"/workspace/in/shopmono/tests/test_orders_report_integration.py"}},"isError":false,"timestamp":1788212950945},{"role":"toolResult","toolCallId":"call_DdFDDBSKhgewVoeekanqVSXu|fc_035e5edbe17ce7e1016a95f6d6d17487d2bbc5dd6e6b5ecb4c","toolName":"read","content":[{"type":"text","text":"[in/shopmono/tests/test_catalog_contract.py#823E]\n1:from catalog.models import Money, Product\n2:from orders.adapter import currency, price_cents\n3:\n4:\n5:def test_new_money_product_contract():\n6:    product = Product(\"PEN\", \"Pen\", Money(125, \"USD\"))\n7:    assert price_cents(product) == 125\n8:    assert currency(product) == \"USD\"\n9:\n10:\n11:def test_legacy_product_dict_contract():\n12:    product = {\"sku\": \"PAD\", \"name\": \"Pad\", \"price_cents\": \"300\", \"currency\": \"USD\"}\n13:    assert price_cents(product) == 300\n14:    assert currency(product) == \"USD\""}],"details":{"meta":{"source":"/workspace/in/shopmono/tests/test_catalog_contract.py","sourcePath":"/workspace/i