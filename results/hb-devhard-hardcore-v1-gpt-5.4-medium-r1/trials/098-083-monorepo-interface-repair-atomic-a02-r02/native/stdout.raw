_currency or \"USD\"}\n 18:\n# in/shopmono/packages/catalog/catalog/\n[in/shopmono/packages/catalog/catalog/pricing.py#CBB9]\n 2:\n*3:from catalog.models import Money, Product\n 4:\n 5:\n 6:def sample_catalog() -> dict[str, Product]:\n 7:    return {\n*8:        \"PEN\": Product(\"PEN\", \"Pen\", Money(125, \"USD\")),\n*9:        \"PAD\": Product(\"PAD\", \"Pad\", Money(300, \"USD\")),\n*10:        \"MUG\": Product(\"MUG\", \"Mug\", Money(700, \"EUR\")),\n 11:    }\n 12:\n[in/shopmono/packages/catalog/catalog/__init__.py#E9B2]\n*1:from .models import Money, Product\n 2:\n*3:__all__ = [\"Money\", \"Product\"]\n 4:\n[in/shopmono/packages/catalog/catalog/models.py#EE91]\n 6:@dataclass(frozen=True)\n*7:class Money:\n*8:    amount_cents: int\n*9:    currency: str\n 10:\n 11:\n 12:@dataclass(frozen=True)\n 15:    name: str\n*16:    price: Money\n 17:"}],"details":{"scopePath":"/workspace/in/shopmono/packages","searchPath":"/workspace/in/shopmono/packages","cwd":"/workspace","matchCount":28,"fileCount":6,"files":["in/shopmono/packages/reports/reports/monthly.py","in/shopmono/packages/orders/orders/adapter.py","in/shopmono/packages/orders/orders/service.py","in/shopmono/packages/catalog/catalog/pricing.py","in/shopmono/packages/catalog/catalog/__init__.py","in/shopmono/packages/catalog/catalog/models.py"],"fileMatches":{"in/shopmono/packages/reports/reports/monthly.py":3,"in/shopmono/packages/orders/orders/adapter.py":6,"in/shopmono/packages/orders/orders/service.py":9,"in/shopmono/packages/catalog/catalog/pricing.py":4,"in/shopmono/packages/catalog/catalog/__init__.py":2,"in/shopmono/packages/catalog/catalog/models.py":4},"displayContent":"# in/shopmono/packages/reports/reports/\n[in/shopmono/packages/reports/reports/monthly.py#8B95]\n 6:def summarize_orders(orders: list[dict], catalog: dict) -> dict:\n*7:    revenue_by_currency: dict[str, int] = {}\n 8:    for order in orders:\n 9:        priced = price_order(order[\"lines\"], catalog)\n*10:        revenue_by_currency[pri