s/\n[in/shopmono/packages/orders/orders/adapter.py#13FB]\n 5:    if isinstance(product, dict):\n*6:        if \"price\" in product:\n*7:            return product[\"price\"]\n 8:        return None\n*9:    return getattr(product, \"price\", None)\n 10:\n 11:\n*12:def price_cents(product) -> int:\n*13:    \"\"\"Return the product price in cents for both new and legacy shapes.\"\"\"\n 14:    money = _money_from_product(product)\n 15:    if money is not None:\n 16:        if isinstance(money, dict):\n 19:    if isinstance(product, dict):\n*20:        return int(product[\"price_cents\"])\n*21:    return int(product.price_cents)\n 22:\n 23:\n*24:def currency(product) -> str:\n 25:    money = _money_from_product(product)\n 26:    if money is not None:\n 27:        if isinstance(money, dict):\n*28:            return str(money[\"currency\"])\n*29:        return str(money.currency)\n 30:    if isinstance(product, dict):\n*31:        return str(product.get(\"currency\", \"USD\"))\n*32:    return str(getattr(product, \"currency\", \"USD\"))\n 33:\n[in/shopmono/packages/orders/orders/service.py#6932]\n 2:\n*3:from orders.adapter import currency, price_cents\n 4:\n 5:\n 6:def price_order(lines: list[dict], catalog: dict) -> dict:\n 7:    total = 0\n*8:    order_currency = None\n 9:    for line in lines:\n 10:        product = catalog[line[\"sku\"]]\n*11:        line_currency = currency(product)\n*12:        if order_currency is None:\n*13:            order_currency = line_currency\n*14:        elif order_currency != line_currency:\n 15:            raise ValueError(\"mixed currencies are not supported\")\n*16:        total += price_cents(product) * int(line[\"quantity\"])\n*17:    return {\"total_cents\": total, \"currency\": order_currency or \"USD\"}\n 18:\n# in/shopmono/packages/catalog/catalog/\n[in/shopmono/packages/catalog/catalog/models.py#EE91]\n 8:    amount_cents: int\n*9:    currency: str\n 10:\n 11:\n 12:@dataclass(frozen=True)\n 15:    name: str\n*16:    price: Money