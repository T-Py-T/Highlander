phan payments must not be deleted. Move them to `payment_orphans` with the same id, invoice_id, amount_cents, created_at columns plus `reason`.\n6:\n7:The migration package must include:\n8:- preflight report describing orphan payments and row counts.\n9:- idempotent transaction-safe migration.\n10:- rollback SQL that restores the old schema shape.\n11:- postcheck SQL with row counts, orphan preservation, status defaults, and foreign-key checks."}],"details":{"meta":{"source":"/workspace/in/billingdb/migration_policy.md","sourcePath":"/workspace/in/billingdb/migration_policy.md"}},"isError":false,"timestamp":1788195916451},{"role":"toolResult","toolCallId":"call_hOlkoMRXT4qURO9zT856qcb6|fc_03a1a0e00cb0d594016a95b44c4cc887d28542ebdcd3c9885e","toolName":"read","content":[{"type":"text","text":"[in/billingdb/schema.sql#030B]\n1:PRAGMA foreign_keys = OFF;\n2:\n3:CREATE TABLE invoices (\n4:  id TEXT PRIMARY KEY,\n5:  customer_id TEXT NOT NULL,\n6:  total_cents INTEGER NOT NULL,\n7:  created_at TEXT NOT NULL\n8:);\n9:\n10:CREATE TABLE payments (\n11:  id TEXT PRIMARY KEY,\n12:  invoice_id TEXT NOT NULL,\n13:  amount_cents INTEGER NOT NULL,\n14:  created_at TEXT NOT NULL\n15:);\n16:\n17:INSERT INTO invoices(id, customer_id, total_cents, created_at) VALUES\n18:  ('inv1', 'cust-a', 1200, '2024-01-03T10:00:00Z'),\n19:  ('inv2', 'cust-b', 5000, '2024-01-04T10:00:00Z'),\n20:  ('inv3', 'cust-a', 800, '2024-01-05T10:00:00Z');\n21:\n22:INSERT INTO payments(id, invoice_id, amount_cents, created_at) VALUES\n23:  ('p1', 'inv1', 1200, '2024-01-06T10:00:00Z'),\n24:  ('p2', 'inv2', 2500, '2024-01-06T11:00:00Z'),\n25:  ('p3', 'inv2', 2500, '2024-01-06T12:00:00Z'),\n26:  ('p4', 'missing-invoice', 700, '2024-01-07T10:00:00Z');"}],"details":{"meta":{"source":"/workspace/in/billingdb/schema.sql","sourcePath":"/workspace/in/billingdb/schema.sql"}},"isError":false,"timestamp":1788195916451},{"role":"toolResult","toolCallId":"call_f5qzqZOPy2LPeXTHamTzKLXW|fc_03a1a0e00cb0d594016a95b44c4cd087d288