FT JOIN invoices i ON i.id=p.invoice_id WHERE i.id IS NULL\"),\n    'fk_check': cur.execute('PRAGMA foreign_key_check').fetchall(),\n}\ncur.executescript(postcheck)\ncur.executescript(rollback)\npost_rb = {\n    'invoice_cols': [r[1] for r in rows(cur, 'PRAGMA table_info(invoices)')],\n    'payment_cols': [r[1] for r in rows(cur, 'PRAGMA table_info(payments)')],\n    'invoices': rows(cur, 'SELECT * FROM invoices ORDER BY id'),\n    'payments': rows(cur, 'SELECT * FROM payments ORDER BY id'),\n    'payment_orphans_exists': table_sql(cur, 'payment_orphans') is not None,\n}\nprint(json.dumps({'first': first, 'second': second, 'post_rollback': post_rb}, indent=2))\nPY","timeout":20}}}}
