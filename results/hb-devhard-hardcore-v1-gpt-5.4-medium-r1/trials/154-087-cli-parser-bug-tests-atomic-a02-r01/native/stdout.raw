{"type":"tool_execution_end","toolCallId":"call_I7Afp4TopBvU29hwNEKSYNnQ|fc_0bfe44bc0e6abfc9016a95cac65eec87d297beedddee73d56f","toolName":"read","result":{"content":[{"type":"text","text":"[in/csvtool/csvtool/cli.py#FE65]\n1:from __future__ import annotations\n2:\n3:import argparse\n4:import csv\n5:import sys\n6:\n7:from csvtool.filtering import CliUsageError, apply_where, parse_select, parse_where, select_fields\n8:\n9:\n10:def read_rows(path):\n11:    with open(path, encoding=\"utf-8\", newline=\"\") as handle:\n12:        reader = csv.DictReader(handle)\n13:        headers = reader.fieldnames or []\n14:        rows = list(reader)\n15:    return headers, rows\n16:\n17:\n18:def sort_key(value):\n19:    try:\n20:        return 0, float(value)\n21:    except (TypeError, ValueError):\n22:        return 1, \"\" if value is None else str(value)\n23:\n24:\n25:def write_rows(headers, rows):\n26:    writer = csv.DictWriter(sys.stdout, fieldnames=headers, lineterminator=\"\\n\")\n27:    writer.writeheader()\n28:    for row in rows:\n29:        writer.writerow({header: row.get(header, \"\") for header in headers})\n30:\n31:\n32:def main(argv=None):\n33:    parser = argparse.ArgumentParser()\n34:    parser.add_argument(\"csv_file\")\n35:    parser.add_argument(\"--where\", action=\"append\", default=[])\n36:    parser.add_argument(\"--select\")\n37:    parser.add_argument(\"--sort\")\n38:    args = parser.parse_args(argv)\n39:\n40:    try:\n41:        headers, rows = read_rows(args.csv_file)\n42:        predicates = parse_where(args.where, headers)\n43:        rows = apply_where(rows, predicates)\n44:\n45:        if args.sort:\n46:            reverse = args.sort.startswith(\"-\")\n47:            sort_field = args.sort[1:] if reverse else args.sort\n48:            if not sort_field:\n49:                raise CliUsageError(\"sort field not found: \")\n50:            if sort_field not in headers:\n51:                raise CliUsageError(f\"sort field not found: {sort_field}\")\n52:            rows.sort(key=lambda row: sort_key(row[sort_field]), reverse=reverse)\n53:\n54:        selected_headers = parse_select(args.select, headers)\n55:        rows = select_fields(rows, selected_headers)\n56:        write_rows(selected_headers, rows)\n57:        return 0\n58:    except CliUsageError as exc:\n59:        print(str(exc), file=sys.stderr)\n60:        return 1\n61:\n62:\n63:if __name__ == \"__main__\":\n64:    raise SystemExit(main())"}],"details":{"meta":{"source":"/workspace/in/csvtool/csvtool/cli.py","sourcePath":"/workspace/in/csvtool/csvtool/cli.py"}}},"isError":false}
