parse_where(args.where, headers)\n59:        rows = apply_where(rows, predicates)\n60:\n61:        if args.sort:\n62:            reverse = args.sort.startswith(\"-\")\n63:            sort_field = args.sort[1:] if reverse else args.sort\n64:            if not sort_field:\n65:                raise CliUsageError(\"sort field not found: \")\n66:            if sort_field not in headers:\n67:                raise CliUsageError(f\"sort field not found: {sort_field}\")\n68:            rows.sort(key=lambda row: sort_key(row[sort_field]), reverse=reverse)\n69:\n70:        selected_headers = parse_select(args.select, headers)\n71:        rows = select_fields(rows, selected_headers)\n72:        write_rows(selected_headers, rows)\n73:        return 0\n74:    except CliUsageError as exc:\n75:        print(str(exc), file=sys.stderr)\n76:        return 1\n77:\n78:\n79:if __name__ == \"__main__\":\n80:    raise SystemExit(main())"}],"details":{"meta":{"source":"/workspace/in/csvtool/csvtool/cli.py","sourcePath":"/workspace/in/csvtool/csvtool/cli.py"}},"isError":false,"timestamp":1788201678300}}
