l\")\n    assert proc.returncode == 0, proc.stderr\n    rows = list(csv.DictReader(proc.stdout.splitlines()))\n    assert rows == [\n        {\"id\": \"o1\", \"total\": \"1200\"},\n        {\"id\": \"o3\", \"total\": \"750\"},\n        {\"id\": \"o2\", \"total\": \"500\"},\n    ]\n\n\ndef test_output_preserves_quoted_commas():\n    proc = run_cli(\"samples/orders.csv\", \"--where\", \"id=o1\", \"--select\", \"id,customer\")\n    assert proc.returncode == 0, proc.stderr\n    assert proc.stdout == 'id,customer\\no1,\"Ava, Inc\"\\n'\n\n\ndef test_bad_where_expression_exits_non_zero_with_clear_message():\n    proc = run_cli(\"samples/orders.csv\", \"--where\", \"status\")\n    assert proc.returncode != 0\n    assert \"bad --where expression\" in proc.stderr\n\n\ndef test_missing_fields_exit_non_zero_with_clear_message():\n    cases = [\n        ((\"samples/orders.csv\", \"--where\", \"missing=value\"), \"filter field not found: missing\"),\n        ((\"samples/orders.csv\", \"--select\", \"missing\"), \"select field not found: missing\"),\n        ((\"samples/orders.csv\", \"--sort\", \"missing\"), \"sort field not found: missing\"),\n    ]\n\n    for args, message in cases:\n        proc = run_cli(*args)\n        assert proc.returncode != 0\n        assert message in proc.stderr\n"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":975,"output":688,"cacheRead":18944,"cacheWrite":0,"reasoning":57,"totalTokens":20607,"cost":{"input":0.0024375,"output":0.010320000000000001,"cacheRead":0.004736,"cacheWrite":0,"total":0.017493500000000002}},"stopReason":"toolUse","timestamp":1788201647077,"responseId":"resp_0bfe44bc0e6abfc9016a95caaf6bc487d28eeb0d86d1b7e774","rawStopReason":"completed"},{"role":"toolResult","toolCallId":"call_1ILIe478cPrnOcmuhIuOwLre|fc_0bfe44bc0e6abfc9016a95cab1a1c087d2b8a3971414505e2a","toolName":"write","content":[{"type":"text","text":"[in/csvtool/tests/test_cli_regression.py#649F]\nSuccessfully wrote 1949 byt