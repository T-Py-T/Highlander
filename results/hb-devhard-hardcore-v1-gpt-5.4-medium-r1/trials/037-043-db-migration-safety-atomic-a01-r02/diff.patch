+
+CREATE TABLE users (
+    id TEXT PRIMARY KEY,
+    email TEXT,
+    name TEXT NOT NULL,
+    created_at TEXT NOT NULL
+);
+
+INSERT INTO users (id, email, name, created_at)
+SELECT id, email, name, created_at
+FROM users__rollback_old;
+
+DROP TABLE users__rollback_old;
+
+COMMIT;
+
+PRAGMA foreign_keys = ON;
+PRAGMA foreign_key_check;
