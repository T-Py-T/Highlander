   self.value = None\n\n    def __enter__(self):\n        return self\n\n    def __exit__(self, exc_type, exc, tb):\n        if exc_type is None:\n            raise AssertionError(f\"DID NOT RAISE {self.expected.__name__}\")\n        if not issubclass(exc_type, self.expected):\n            return False\n        self.value = exc\n        if self.match is not None and re.search(self.match, str(exc)) is None:\n            raise AssertionError(f\"Exception message {exc!r} does not match {self.match!r}\")\n        return True\n\ndef raises(expected, match=None):\n    return RaisesContext(expected, match)\n'''))\n(shim / 'pytest' / '__main__.py').write_text(textwrap.dedent('''\nimport importlib.util\nimport pathlib\nimport sys\nimport traceback\n\n\ndef _load_module(path, root):\n    name = '.'.join(path.relative_to(root).with_suffix('').parts)\n    spec = importlib.util.spec_from_file_location(name, path)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef _iter_tests(module):\n    for name in sorted(dir(module)):\n        if name.startswith('test_') and callable(getattr(module, name)):\n            yield name, getattr(module, name)\n\n\ndef main(argv=None):\n    argv = list(sys.argv[1:] if argv is None else argv)\n    targets = [pathlib.Path(arg) for arg in argv or ['tests']]\n    failures = 0\n    total = 0\n    for target in targets:\n        paths = [target] if target.is_file() else sorted(target.rglob('test_*.py'))\n        for path in paths:\n            module = _load_module(path.resolve(), pathlib.Path.cwd())\n            for name, func in _iter_tests(module):\n                total += 1\n                try:\n                    func()\n                    print(f'{path}::{name} PASSED')\n                except Exception:\n                    failures += 1\n                    print(f'{path}::{name} FAILED')\n                    traceback.print_exc()\n    print(f'collected {total} items')\n    if failures:\n        print(f'{failures} failed, {total - failures} passed')\n        raise SystemExit(1)\n    print(f'{total} passed')\n\nif __name__ == '__main__':\n    main()\n'''))\npython_link = shim / 'python'\npython_link.symlink_to(Path('/usr/bin/python3'))\n\nlegacy_check = subprocess.run(\n    ['/usr/bin/python3', '-c', \"from orders.adapter import price_cents, currency; p={'sku':'PAD','name':'Pad','price_cents':'300','currency':'USD'}; print(price_cents(p), currency(p))\"],\n    cwd=repo,\n    env={**os.environ, 'PYTHONPATH': 'packages/catalog:packages/orders:packages/reports'},\n    capture_output=True,\n    text=True,\n    check=True,\n)\n\nrun = subprocess.run(\n    ['python', '-m', 'pytest', 'tests'],\n    cwd=repo,\n    env={\n        **os.environ,\n        'PATH': f\"{shim}:{os.environ['PATH']}\",\n        'PYTHONPATH': f\"{shim}:packages/catalog:packages/orders:packages/reports\",\n    },\n    capture_output=True,\n    text=True,\n)\n\ndisplay({\n    'shim_dir': str(shim),\n    'legacy_check_stdout': legacy_check.stdout,\n    'pytest_returncode': run.returncode,\n    'pytest_stdout': run.stdout,\n    'pytest_stderr': run.stderr,\n})","language":"python","output":"{'shim_dir': '/tmp/pytest-shim-enhzjrzq', 'legacy_check_stdout': '300 USD\\n', 'pytest_returncode': 0, 'pytest_stdout': 'tests/test_catalog_contract.py::test_legacy_product_dict_contract PASSED\\ntests/test_catalog_contract.py::test_new_money_product_contract PASSED\\ntests/test_orders_report_integration.py::test_mixed_currency_order_is_rejected PASSED\\ntests/test_orders_report_integration.py::test_order_prices_catalog_money_objects PASSED\\ntests/test_orders_report_integration.py::test_reports_group_by_currency PASSED\\ncollected 5 items\\n5 passed\\n', 'pytest_stderr': ''}\n\ndisplay[1]:\n{\n  \"shim_dir\": \"/tmp/pytest-shim-enhzjrzq\",\n  \"legacy_check_stdout\": \"300 USD\\n\",\n  \"pytest_returncode\": 0,\n  \"pytest_stdout\": \"tests/test_catalog_contract.py::test_legacy_product_dict_c