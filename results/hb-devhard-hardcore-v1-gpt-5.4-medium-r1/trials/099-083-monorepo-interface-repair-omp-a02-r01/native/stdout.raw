"mixed currencies are not supported\")\n*16:        total += price_cents(product) * int(line[\"quantity\"])\n*17:    return {\"total_cents\": total, \"currency\": order_currency or \"USD\"}\n\n### reports/reports/\n#### monthly.py#8B95\n 6:def summarize_orders(orders: list[dict], catalog: dict) -> dict:\n*7:    revenue_by_currency: dict[str, int] = {}\n 8:    for order in orders:\n 9:        priced = price_order(order[\"lines\"], catalog)\n*10:        revenue_by_currency[priced[\"currency\"]] = revenue_by_currency.get(priced[\"currency\"], 0) + priced[\"total_cents\"]\n*11:    return {\"order_count\": len(orders), \"revenue_by_currency\": revenue_by_currency}\n\n## tests/\n### test_catalog_contract.py#823E\n 1:from catalog.models import Money, Product\n*2:from orders.adapter import currency, price_cents\n 3:\n 4:\n 5:def test_new_money_product_contract():\n*6:    product = Product(\"PEN\", \"Pen\", Money(125, \"USD\"))\n*7:    assert price_cents(product) == 125\n*8:    assert currency(product) == \"USD\"\n 9:\n 10:\n 11:def test_legacy_product_dict_contract():\n*12:    product = {\"sku\": \"PAD\", \"name\": \"Pad\", \"price_cents\": \"300\", \"currency\": \"USD\"}\n*13:    assert price_cents(product) == 300\n*14:    assert currency(product) == \"USD\"\n### test_orders_report_integration.py#6F1F\n 11:        \"total_cents\": 550,\n*12:        \"currency\": \"USD\",\n 13:    }\n 14:\n 15:\n*16:def test_reports_group_by_currency():\n 17:    catalog = sample_catalog()\n 18:    result = summarize_orders(\n 19:        [\n...\n 24:    )\n*25:    assert result == {\"order_count\": 2, \"revenue_by_currency\": {\"USD\": 250, \"EUR\": 700}}\n 26:\n 27:\n*28:def test_mixed_currency_order_is_rejected():\n 29:    catalog = sample_catalog()\n 30:    with pytest.raises(ValueError, match=\"mixed\"):\n 31:        price_order([{\"sku\": \"PEN\", \"quantity\": 1}, {\"sku\": \"MUG\", \"quantity\": 1}], catalog)"}],"details":{"scopePath":"in/shopmono","searchPath":"/workspace/in/shopmono