ath)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef _iter_tests(module):\n    for name in sorted(dir(module)):\n        if name.startswith('test_') and callable(getattr(module, name)):\n            yield name, getattr(module, name)\n\n\ndef main(argv=None):\n    argv = list(sys.argv[1:] if argv is None else argv)\n    targets = [pathlib.Path(arg) for arg in argv or ['tests']]\n    failures = 0\n    total = 0\n    for target in targets:\n        paths = [target] if target.is_file() else sorted(target.rglob('test_*.py'))\n        for path in paths:\n            module = _load_module(path.resolve(), pathlib.Path.cwd())\n            for name, func in _iter_tests(module):\n                total += 1\n                try:\n                    func()\n                    print(f'{path}::{name} PASSED')\n                except Exception:\n                    failures += 1\n                    print(f'{path}::{name} FAILED')\n                    traceback.print_exc()\n    print(f'collected {total} items')\n    if failures:\n        print(f'{failures} failed, {total - failures} passed')\n        raise SystemExit(1)\n    print(f'{total} passed')\n\nif __name__ == '__main__':\n    main()\n'''))\npython_link = shim / 'python'\npython_link.symlink_to(Path('/usr/bin/python3'))\n\nlegacy_check = subprocess.run(\n    ['/usr/bin/python3', '-c', \"from orders.adapter import price_cents, currency; p={'sku':'PAD','name':'Pad','price_cents':'300','currency':'USD'}; print(price_cents(p), currency(p))\"],\n    cwd=repo,\n    env={**os.environ, 'PYTHONPATH': 'packages/catalog:packages/orders:packages/reports'},\n    capture_output=True,\n    text=True,\n    check=True,\n)\n\nrun = subprocess.run(\n    ['python', '-m', 'pytest', 'tests'],\n    cwd=repo,\n    env={\n        **os.environ,\n        'PATH': f\"{shim}:{os.environ['PATH']}\",\n        'PYTHONPATH': f\"{shim}:packages/catalog:packages/orders:packages/reports\",\n