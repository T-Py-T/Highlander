{"type":"tool_execution_end","toolCallId":"call_KvVWEz9dzG03xo26yzVm28hN|fc_0724ab837424664b016a958db1b2c087d28099b6f10d826e11","toolName":"read","result":{"content":[{"type":"text","text":"[in/schema_migration/client.py#8A94]\n1:from __future__ import annotations\n2:\n3:import json\n4:import sys\n5:from copy import deepcopy\n6:from pathlib import Path\n7:\n8:\n9:AUDIT_PATH = Path(__file__).with_name(\"conversion_audit.json\")\n10:PII_KEYS = {\n11:    \"ssn\",\n12:    \"credit_card\",\n13:    \"card_number\",\n14:    \"cvv\",\n15:    \"phone_number\",\n16:    \"passport_number\",\n17:}\n18:V2_TOP_LEVEL_KEYS = {\"orderId\", \"buyer\", \"lineItems\", \"shipping\", \"metadata\"}\n19:LEGACY_TOP_LEVEL_KEYS = {\n20:    \"id\",\n21:    \"order_ref\",\n22:    \"customer_id\",\n23:    \"customer_name\",\n24:    \"customer\",\n25:    \"items\",\n26:    \"lines\",\n27:    \"ship_to\",\n28:    \"shipTo\",\n29:    \"shipping_method\",\n30:    \"shipping\",\n31:}\n32:\n33:\n34:class ConversionError(ValueError):\n35:    def __init__(self, path: str, error: str):\n36:        super().__init__(error)\n37:        self.path = path\n38:        self.error = error\n39:\n40:\n41:class ConversionWarning(dict):\n42:    def __init__(self, index: int | None, path: str, warning: str):\n43:        super().__init__(index=index, path=path, warning=warning)\n44:\n45:\n46:class ConversionResult(tuple):\n47:    def __new__(cls, converted, errors, warnings):\n48:        obj = super().__new__(cls, (converted, errors))\n49:        obj.warnings = warnings\n50:        return obj\n51:\n52:\n53:class _Tracker:\n54:    def __init__(self):\n55:        self.warning_count = 0\n56:        self.pii_dropped_count = 0\n57:        self.unknown_fields_count = 0\n58:\n59:\n60:def _is_blank(value):\n61:    return value is None or (isinstance(value, str) and value.strip() == \"\")\n62:\n63:\n64:def _require_dict(payload, path):\n65:    if not isinstance(payload, dict):\n66:        raise ConversionError(path, \"must be an object\")\n67:    return payload\n68:\n69:\n70:def _require_list(value, path):\n71:    if not isinstance(value, list):\n72:        raise ConversionError(path, \"must be a list\")\n73:    if not value:\n74:        raise ConversionError(path, \"must not be empty\")\n75:    return value\n76:\n77:\n78:def _require_value(value, path):\n79:    if _is_blank(value):\n80:        raise ConversionError(path, \"missing required value\")\n81:    return value\n82:\n83:\n84:def _to_int(value, path):\n85:    if isinstance(value, bool):\n86:        raise ConversionError(path, \"must be an integer\")\n87:    if isinstance(value, int):\n88:        return value\n89:    if isinstance(value, str) and value.strip():\n90:        try:\n91:            return int(value)\n92:        except ValueError as exc:\n93:            raise ConversionError(path, \"must be an integer\") from exc\n94:    raise ConversionError(path, \"must be an integer\")\n95:\n96:\n97:def _shipping_method(value):\n98:    return \"standard\" if _is_blank(value) else value\n99:\n100:\n101:def _split_unknown_fields(source, mapped_keys, tracker, warnings, index):\n102:    unknown = {}\n103:    for key, value in source.items():\n104:        if key in mapped_keys:\n105:            continue\n106:        if key.lower() in PII_KEYS:\n107:            tracker.pii_dropped_count += 1\n108:            tracker.warning_count += 1\n109:            warnings.append(ConversionWarning(index, key, \"dropped pii field\"))\n110:            continue\n111:        unknown[key] = deepcopy(value)\n112:        tracker.unknown_fields_count += 1\n113:        tracker.warning_count += 1\n114:        warnings.append(ConversionWarning(index, f\"metadata.unknownFields.{key}\", \"preserved unknown field\"))\n115:    return unknown\n116:\n117:\n118:def _convert_legacy_line_items(items_key, items):\n119:    converted = []\n120:    for i, item in enumerate(_require_list(items, items_key)):\n121:        _require_dict(item, f\"{items_key}[{i}]\")\n122:        qty = _to_int(_require_value(item.get(\"qty\"), f\"{items_key}[{i}].qty\"), f\"{items_key}[{i}].qty\")\n123:        price_key = \"unit_price_cents\" if \"unit_price_cents\" in item else \"price_cents\"\n124:        price = _to_int(\n125:            _require_value(item.get(price_key), f\"{items_key}[{i}].{price_key}\"),\n126:            f\"{items_key}[{i}].{price_key}\",\n127:        )\n128:        line = {\n129:            key: deepcopy(value)\n130:            for key, value in item.items()\n131:            if key not in {\"qty\", \"price_cents\", \"unit_price_cents\"}\n132:        }\n133:        line[\"quantity\"] = qty\n134:        line[\"unitPriceCents\"] = price\n135:        converted.append(line)\n136:    return converted\n137:\n138:\n139:def _convert_legacy_shipping(payload):\n140:    shipping_source = payload.get(\"shipTo\") if \"shipTo\" in payload else payload.get(\"ship_to\")\n141:    shipping_path = \"shipTo\" if \"shipTo\" in payload else \"ship_to\"\n142:    address = _require_dict(_require_value(shipping_source, shipping_path), shipping_path)\n143:    postal = None\n144:    postal_path = None\n145:    for key in (\"postal\", \"postalCode\", \"postal_code\"):\n146:        if key in address:\n147:            postal = address.get(key)\n148:            postal_path = f\"{shipping_path}.{key}\"\n149:            break\n150:    postal = _require_value(postal, postal_path or f\"{shipping_path}.postal\")\n151:    converted_address = {\n152:        key: deepcopy(value)\n153:        for key, value in address.items()\n154:        if key not in {\"postal\", \"postalCode\", \"postal_code\"}\n155:    }\n156:    converted_address[\"postalCode\"] = postal\n157:    return {\n158:        \"method\": _shipping_method(payload.get(\"shipping_method\", payload.get(\"shipping\"))),\n159:        \"address\": converted_address,\n160:    }\n161:\n162:\n163:def _convert_v2(payload, tracker, warnings, index):\n164:    buyer = _require_dict(_require_value(payload.get(\"buyer\"), \"buyer\"), \"buyer\")\n165:    shipping = _require_dict(_require_value(payload.get(\"shipping\"), \"shipping\"), \"shipping\")\n166:    metadata = _require_dict(payload.get(\"metadata\") or {}, \"metadata\")\n167:    line_items = _require_list(payload.get(\"lineItems\"), \"lineItems\")\n168:\n169:    _require_value(payload.get(\"orderId\"), \"orderId\")\n170:    _require_value(buyer.get(\"id\"), \"buyer.id\")\n171:    _require_value(buyer.get(\"displayName\"), \"buyer.displayName\")\n172:    address = _require_dict(_require_value(shipping.get(\"address\"), \"shipping.address\"), \"shipping.address\")\n173:    _require_value(address.get(\"postalCode\"), \"shipping.address.postalCode\")\n174:\n175:    preserved_metadata = deepcopy(metadata)\n176:    unknown_existing = preserved_metadata.get(\"unknownFields\")\n177:    if unknown_existing is None:\n178:        unknown_existing = {}\n179:    elif not isinstance(unknown_existing, dict):\n180:        raise ConversionError(\"metadata.unknownFields\", \"must be an object\")\n181:    preserved_metadata[\"unknownFields\"] = deepcopy(unknown_existing)\n182:\n183:    extra_unknown = _split_unknown_fields(payload, V2_TOP_LEVEL_KEYS, tracker, warnings, index)\n184:    if extra_unknown:\n185:        preserved_metadata[\"unknownFields\"].update(extra_unknown)\n186:    if \"source\" not in preserved_metadata or _is_blank(preserved_metadata.get(\"source\")):\n187:        preserved_metadata[\"source\"] = \"public-v2\"\n188:\n189:    converted = deepcopy(payload)\n190:    converted[\"shipping\"] = deepcopy(shipping)\n191:    converted[\"shipping\"][\"method\"] = _shipping_method(shipping.get(\"method\"))\n192:    converted[\"metadata\"] = preserved_metadata\n193:    converted[\"lineItems\"] = deepcopy(line_items)\n194:    return converted\n195:\n196:\n197:def _convert_legacy(payload, tracker, warnings, index):\n198:    order_id_key = \"order_ref\" if \"order_ref\" in payload else \"id\"\n199:    order_id = _require_value(payload.get(order_id_key), order_id_key)\n200:\n201:    if \"customer\" in payload:\n202:        customer = _require_dict(_require_value(payload.get(\"customer\"), \"customer\"), \"customer\")\n203:        buyer = {\n204:            \"id\": _require_value(customer.get(\"id\"), \"customer.id\"),\n205:            \"displayName\": _require_value(customer.get(\"name\"), \"customer.name\"),\n206:        }\n207:    else:\n208:        buyer = {\n209:            \"id\": _require_value(payload.get(\"customer_id\"), \"customer_id\"),\n210:            \"displayName\": _require_value(payload.get(\"customer_name\"), \"customer_name\"),\n211:        }\n212:\n213:    items_key = \"lines\" if \"lines\" in payload else \"items\"\n214:    line_items = _convert_legacy_line_items(items_key, payload.get(items_key))\n215:    shipping = _convert_legacy_shipping(payload)\n216:\n217:    unknown = _split_unknown_fields(payload, LEGACY_TOP_LEVEL_KEYS, tracker, warnings, index)\n218:    metadata = {\"source\": \"legacy-v1\"}\n219:    if unknown:\n220:        metadata[\"unknownFields\"] = unknown\n221:\n222:    return {\n223:        \"orderId\": order_id,\n224:        \"buyer\": buyer,\n225:        \"lineItems\": line_items,\n226:        \"shipping\": shipping,\n227:        \"metadata\": metadata,\n228:    }\n229:\n230:\n231:def _convert_order(payload, tracker=None, warnings=None, index=None):\n232:    tracker = tracker or _Tracker()\n233:    warnings = warnings if warnings is not None else []\n234:    payload = _require_dict(payload, \"payload\")\n235:    if \"orderId\" in payload:\n236:        return _convert_v2(payload, tracker, warnings, index)\n237:    return _convert_legacy(payload, tracker, warnings, index)\n238:\n239:\n240:def convert_order(payload):\n241:    \"\"\"Convert a legacy or v2 order payload to the v2 public API shape.\"\"\"\n242:    return _convert_order(payload)\n243:\n244:\n245:def _write_audit(converted_count, errors, warnings, tracker):\n246:    AUDIT_PATH.write_text(\n247:        json.dumps(\n248:            {\n249:                \"converted_count\": converted_count,\n250:                \"error_count\": len(errors),\n251:                \"warning_count\": len(warnings),\n252:                \"pii_dropped_count\": tracker.pii_dropped_count,\n253:                \"unknown_fields_count\": tracker.unknown_fields_count,\n254:            },\n255:            indent=2,\n256:            sort_keys=True,\n257:        )\n258:        + \"\\n\",\n259:        encoding=\"utf-8\",\n260:    )\n261:\n262:\n263:def convert_many(payloads):\n264:    converted = []\n265:    errors = []\n266:    warnings = []\n267:    tracker = _Tracker()\n268:\n269:    for index, payload in enumerate(payloads):\n270:        try:\n271:            converted.append(_convert_order(payload, tracker=tracker, warnings=warnings, index=index))\n272:        except ConversionError as exc:\n273:            errors.append({\"index\": index, \"path\": exc.path, \"error\": exc.error})\n274:\n275:    _write_audit(len(converted), errors, warnings, tracker)\n276:    return ConversionResult(converted, errors, warnings)\n277:\n278:\n279:def summarize_order(v2_payload):\n280:    return f\"{v2_payload['orderId']}:{len(v2_payload['lineItems'])}\"\n281:\n282:\n283:def _load_jsonl(path):\n284:    payloads = []\n285:    with open(path, \"r\", encoding=\"utf-8\") as handle:\n286:        for line_no, line in enumerate(handle, start=1):\n287:            line = line.strip()\n288:            if not line:\n289:                continue\n290:            try:\n291:                payloads.append(json.loads(line))\n292:            except json.JSONDecodeError as exc:\n293:                raise ConversionError(f\"input[{line_no}]\", f\"invalid json: {exc.msg}\") from exc\n294:    return payloads\n295:\n296:\n297:def main(argv=None):\n298:    argv = list(sys.argv[1:] if argv is None else argv)\n299:    if len(argv) != 2:\n300:        print(\"Usage: python -m client input.jsonl output.json\", file=sys.stderr)\n301:        return 2\n302:\n303:    input_path, output_path = argv\n304:    try:\n305:        payloads = _load_jsonl(input_path)\n306:        result = convert_many(payloads)\n307:    except ConversionError as exc:\n308:        print(json.dumps({\"path\": exc.path, \"error\": exc.error}), file=sys.stderr)\n309:        return 1\n310:\n311:    with open(output_path, \"w\", encoding=\"utf-8\") as handle:\n312:        json.dump(result[0], handle, indent=2)\n313:        handle.write(\"\\n\")\n314:\n315:    return 0\n316:\n317:\n318:if __name__ == \"__main__\":\n319:    raise SystemExit(main())"}],"details":{"meta":{"source":"/workspace/in/schema_migration/client.py","sourcePath":"/workspace/in/schema_migration/client.py"}}},"isError":false}
