'id': 'bad', 'items': []}])\nok, errors = result\nassert len(ok) == 1\nassert errors and errors[0]['index'] == 1\nassert 'missing' in errors[0]['error'].lower() or 'customer' in errors[0]['error'].lower()\nassert result[2] == []\n\npayload = {\n    'order_ref': 'E500',\n    'customer': {'id': 'C-11', 'name': 'Iris'},\n    'lines': [{'sku': 'MUG', 'qty': '4', 'unit_price_cents': '325'}],\n    'shipTo': {'country': 'US', 'postal_code': '94105'},\n    'shipping_method': '',\n    'routing_tag': 'beta',\n    'card_number': '4111',\n}\nmigrated = convert_order(payload)\nassert migrated['orderId'] == 'E500'\nassert migrated['buyer'] == {'id': 'C-11', 'displayName': 'Iris'}\nassert migrated['lineItems'] == [{'sku': 'MUG', 'quantity': 4, 'unitPriceCents': 325}]\nassert migrated['shipping']['method'] == 'standard'\nassert migrated['shipping']['address']['postalCode'] == '94105'\nassert migrated['metadata']['unknownFields'] == {'routing_tag': 'beta'}\n\nsample_payloads = [json.loads(line) for line in open('sample_payloads.jsonl', encoding='utf-8') if line.strip()]\nresult = convert_many(sample_payloads)\nassert len(result[0]) == 4\nassert len(result[2]) >= 1\nassert json.loads(AUDIT_PATH.read_text())['converted_count'] == 4\n\nwith tempfile.TemporaryDirectory() as td:\n    out = os.path.join(td, 'out.json')\n    proc = subprocess.run([sys.executable, '-m', 'client', 'sample_payloads.jsonl', out], cwd='.', capture_output=True, text=True)\n    assert proc.returncode == 0, proc.stderr\n    data = json.load(open(out, encoding='utf-8'))\n    assert len(data) == 4\n\nprint('smoke ok')\nprint(AUDIT_PATH.read_text())\nPY","timeout":60,"cwd":"/workspace/in/schema_migration"}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":1309,"output":1038,"cacheRead":28672,"cacheWrite":0,"reasoning":10,"totalTokens":31019,"cost":{"input":0.0032725000000000002,"output":0.01557,"cacheRead":0.007168,"cacheWrite":0,"total":0.026010500000000002}},"stopReason":