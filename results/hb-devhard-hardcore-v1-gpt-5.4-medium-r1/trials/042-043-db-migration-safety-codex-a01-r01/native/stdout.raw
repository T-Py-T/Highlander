{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport sqlite3\nfrom pathlib import Path\nimport tempfile\n\nbase = Path('/workspace/in/db')\nschema = (base / 'schema.sql').read_text()\nmigration = (base / 'migration.sql').read_text()\npostcheck = (base / 'postcheck.sql').read_text()\nrollback = (base / 'rollback.sql').read_text()\n\nwith tempfile.TemporaryDirectory() as td:\n    db = Path(td) / 'test.db'\n    conn = sqlite3.connect(db)\n    conn.executescript(schema)\n    conn.executescript(migration)\n    conn.executescript(migration)\n\n    users = conn.execute(\\\"SELECT id, email, name, status, created_at FROM users ORDER BY id\\\").fetchall()\n    orders = conn.execute(\\\"SELECT id, user_id, total_cents, created_at FROM orders ORDER BY id\\\").fetchall()\n    schema_cols = conn.execute(\\\"PRAGMA table_info(users)\\\").fetchall()\n    fk_check = conn.execute(\\\"PRAGMA foreign_key_check\\\").fetchall()\n\n    print('USERS', users)\n    print('ORDERS', orders)\n    print('USER_COLS', [(c[1], c[2], c[3], c[4]) for c in schema_cols])\n    print('FK_CHECK', fk_check)\n\n    # sanity assertions\n    assert len(users) == 6\n    assert len(orders) == 4\n    expected = {\n        'u4': 'ada+u4@example.com',\n        'u5': 'missing+u5@example.invalid',\n        'u6': 'missing+u6@example.invalid',\n    }\n    for uid, email in expected.items():\n        got = conn.execute('SELECT email FROM users WHERE id = ?', (uid,)).fetchone()[0]\n        assert got == email, (uid, got)\n    assert conn.execute(\\\"SELECT COUNT(*) FROM users WHERE email IS NULL OR trim(email) = ''\\\").fetchone()[0] == 0\n    assert conn.execute(\\\"SELECT COUNT(*) FROM (SELECT email FROM users GROUP BY email HAVING COUNT(*) > 1)\\\").fetchone()[0] == 0\n    assert conn.execute(\\\"SELECT COUNT(*) FROM users WHERE status IS NULL OR trim(status) = ''\\\").fetchone()[0] == 0\n    assert not fk_check\n\n    # rollback validation\n    conn.executescript(rollback)\n    rolled_cols = conn.execute(\\\"PRAGMA table_info(users)\\\").fetchall()\n    rolled_users = conn.execute(\\\"SELECT id, email, name, created_at FROM users ORDER BY id\\\").fetchall()\n    rolled_fk = conn.execute(\\\"PRAGMA foreign_key_check\\\").fetchall()\n    print('ROLLED_COLS', [(c[1], c[2], c[3], c[4]) for c in rolled_cols])\n    print('ROLLED_USERS', rolled_users)\n    print('ROLLED_FK', rolled_fk)\n    assert [c[1] for c in rolled_cols] == ['id', 'email', 'name', 'created_at']\n    assert len(rolled_users) == 6\n    assert not rolled_fk\n\n    # exercise postcheck script for execution errors\n    conn.executescript(migration)\n    conn.executescript(postcheck)\n\n    conn.close()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
