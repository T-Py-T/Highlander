+def _is_v2_payload(payload):
+    if not isinstance(payload, dict):
+        return False
+    if "orderId" in payload:
+        return True
+    legacy_markers = {
+        "id",
+        "order_ref",
+        "customer_id",
+        "customer_name",
+        "customer",
+        "items",
+        "lines",
+        "ship_to",
+        "shipTo",
+    }
+    if legacy_markers.intersection(payload.keys()):
+        return False
+    return {"buyer", "lineItems"}.issubset(payload.keys())
