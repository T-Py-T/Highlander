{
  "modules": [
    {
      "name": "minisvc.cli",
      "path": "in/repo/minisvc/cli.py",
      "purpose": "Console entry point that loads settings, constructs the repository, initializes the schema, and reports readiness.",
      "kind": "runtime"
    },
    {
      "name": "minisvc.config",
      "path": "in/repo/minisvc/config.py",
      "purpose": "Configuration loader and immutable Settings dataclass sourced from environment variables.",
      "kind": "runtime"
    },
    {
      "name": "minisvc.models",
      "path": "in/repo/minisvc/models.py",
      "purpose": "Order domain dataclass shared by handlers, audit helpers, and persistence.",
      "kind": "runtime"
    },
    {
      "name": "minisvc.audit",
      "path": "in/repo/minisvc/audit.py",
      "purpose": "Builds in-memory order event dictionaries for create and read responses.",
      "kind": "runtime"
    },
    {
      "name": "minisvc.api.routes",
      "path": "in/repo/minisvc/api/routes.py",
      "purpose": "Registers POST and GET order routes on an external app object.",
      "kind": "runtime"
    },
    {
      "name": "minisvc.api.handlers",
      "path": "in/repo/minisvc/api/handlers.py",
      "purpose": "Implements create and fetch order request handlers, payload coercion, and response shaping.",
      "kind": "runtime"
    },
    {
      "name": "minisvc.storage.repo",
      "path": "in/repo/minisvc/storage/repo.py",
      "purpose": "SQLite-backed repository that initializes the orders table and performs inserts and lookups.",
      "kind": "runtime"
    },
    {
      "name": "minisvc.__init__",
      "path": "in/repo/minisvc/__init__.py",
      "purpose": "Package export marker; not business logic.",
      "kind": "package_marker"
    },
    {
      "name": "minisvc.api.__init__",
      "path": "in/repo/minisvc/api/__init__.py",
      "purpose": "Package marker; not business logic.",
      "kind": "package_marker"
    },
    {
      "name": "minisvc.storage.__init__",
      "path": "in/repo/minisvc/storage/__init__.py",
      "purpose": "Package marker; not business logic.",
      "kind": "package_marker"
    }
  ],
  "entry_points": [
    {
      "identifier": "minisvc.cli:main",
      "kind": "console_script",
      "source": "in/repo/pyproject.toml",
      "notes": "Published as the minisvc console command."
    },
    {
      "identifier": "minisvc.api.routes:register_routes",
      "kind": "http_route_registrar",
      "source": "in/repo/minisvc/api/routes.py",
      "notes": "Accepts an app object and wires POST /orders and GET /orders/<order_id> handlers."
    },
    {
      "identifier": "minisvc.api.handlers:create_order",
      "kind": "http_handler",
      "source": "in/repo/minisvc/api/handlers.py",
      "notes": "Creates an Order from request payload fields and writes it through the repository."
    },
    {
      "identifier": "minisvc.api.handlers:get_order",
      "kind": "http_handler",
      "source": "in/repo/minisvc/api/handlers.py",
      "notes": "Fetches an order by id and returns a shaped response plus an audit event payload."
    }
  ],
