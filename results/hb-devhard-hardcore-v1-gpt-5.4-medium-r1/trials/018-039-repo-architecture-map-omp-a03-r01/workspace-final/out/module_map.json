  "key_functions": [
    {
      "identifier": "minisvc.cli:main",
      "path": "in/repo/minisvc/cli.py",
      "summary": "CLI bootstrap; loads env-driven settings, opens the SQLite repository, initializes the schema, and prints readiness.",
      "side_effects": [
        "Reads process environment",
        "Creates orders table if missing",
        "Prints to stdout"
      ]
    },
    {
      "identifier": "minisvc.config:load_settings",
      "path": "in/repo/minisvc/config.py",
      "summary": "Maps MINISVC_DB and MINISVC_READONLY into an immutable Settings object.",
      "side_effects": []
    },
    {
      "identifier": "minisvc.api.routes:register_routes",
      "path": "in/repo/minisvc/api/routes.py",
      "summary": "Binds route paths to lambda wrappers around the handler functions.",
      "side_effects": [
        "Mutates the provided app routing table"
      ]
    },
    {
      "identifier": "minisvc.api.handlers:create_order",
      "path": "in/repo/minisvc/api/handlers.py",
      "summary": "Constructs an Order from payload keys, coerces total_cents with int(), saves the order, and returns a created response plus transient audit event data.",
      "side_effects": [
        "Writes to SQLite through OrderRepository.save",
        "Raises KeyError or ValueError on malformed payload",
        "May raise sqlite3.IntegrityError on duplicate order_id"
      ]
    },
    {
      "identifier": "minisvc.api.handlers:get_order",
      "path": "in/repo/minisvc/api/handlers.py",
      "summary": "Fetches an order by id, returns missing or ok status, and includes a transient read audit event.",
      "side_effects": []
    },
    {
      "identifier": "minisvc.audit:order_event",
      "path": "in/repo/minisvc/audit.py",
      "summary": "Creates an in-memory audit/event payload from an Order and action string.",
      "side_effects": []
    },
    {
      "identifier": "minisvc.storage.repo:OrderRepository.init_schema",
      "path": "in/repo/minisvc/storage/repo.py",
      "summary": "Ensures the orders table exists in the configured SQLite file.",
      "side_effects": [
        "Opens sqlite3 connection",
        "Executes DDL against the orders table"
      ]
    },
    {
      "identifier": "minisvc.storage.repo:OrderRepository.save",
      "path": "in/repo/minisvc/storage/repo.py",
      "summary": "Inserts a new order row into SQLite without retries or readonly enforcement.",
      "side_effects": [
        "Opens sqlite3 connection",
        "Executes INSERT into orders"
      ]
    },
    {
      "identifier": "minisvc.storage.repo:OrderRepository.get",
      "path": "in/repo/minisvc/storage/repo.py",
      "summary": "Selects an order row by primary key and materializes it as an Order dataclass.",
      "side_effects": [
        "Opens sqlite3 connection",
        "Executes SELECT from orders"
      ]
    }
  ],
  "runtime_flows": [
    {
      "name": "CLI startup",
      "trigger": "Console script minisvc",
      "steps": [
        {
          "step": 1,
          "location": "minisvc.cli:main",
          "action": "Read process environment through load_settings()."
        },
        {
          "step": 2,
          "location": "minisvc.config:load_settings",
          "action": "Resolve database_path from MINISVC_DB or default to orders.sqlite; parse MINISVC_READONLY into Settings.readonly."
        },
        {
          "step": 3,
          "location": "minisvc.cli:main",
          "action": "Instantiate OrderRepository with the configured database path."
        },
        {
          "step": 4,
          "location": "minisvc.storage.repo:OrderRepository.init_schema",
          "action": "Open SQLite and create the orders table if it does not already exist."
        },
        {
          "step": 5,
          "location": "minisvc.cli:main",
          "action": "Print readiness message and exit with status 0."
        }
      ]
    },
    {
      "name": "HTTP create-order",
      "trigger": "POST /orders routed through register_routes()",
      "steps": [
        {
          "step": 1,
          "location": "minisvc.api.routes:register_routes",
          "action": "External app invokes the registered POST /orders lambda."
        },
        {
          "step": 2,
          "location": "minisvc.api.handlers:create_order",
          "action": "Read payload['order_id'], payload['customer'], and payload['total_cents']; coerce total_cents with int()."
        },
        {
          "step": 3,
          "location": "minisvc.api.handlers:create_order",
          "action": "Instantiate an Order dataclass from the payload values."
        },
        {
          "step": 4,
          "location": "minisvc.storage.repo:OrderRepository.save",
          "action": "Open SQLite and INSERT the order row into the orders table."
        },
        {
          "step": 5,
          "location": "minisvc.audit:order_event",
          "action": "Build an in-memory created-event dictionary for the response body."
        },
        {
          "step": 6,
          "location": "minisvc.api.handlers:create_order",
          "action": "Return {'status': 'created', 'order_id': ..., 'event': ...}; malformed payload or duplicate keys escape as exceptions."
        }
      ]
    }
  ]
}