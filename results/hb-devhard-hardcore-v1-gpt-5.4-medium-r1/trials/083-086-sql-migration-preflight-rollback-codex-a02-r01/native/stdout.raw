{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport sqlite3\nbase = Path('/workspace/in/billingdb')\nschema = (base / 'schema.sql').read_text()\nmigration = (base / 'migration.sql').read_text()\nrollback = (base / 'rollback.sql').read_text()\npostcheck = (base / 'postcheck.sql').read_text()\n\ndef table_cols(conn, name):\n    return [row[1] for row in conn.execute(f\\\"PRAGMA table_info({name})\\\")]\n\ndef run_script(label, conn, script):\n    try:\n        conn.executescript(script)\n    except Exception as e:\n        raise RuntimeError(f'{label} failed: {e}')\n\nconn = sqlite3.connect(':memory:')\nrun_script('schema', conn, schema)\nrun_script('migration first', conn, migration)\nstate1 = {\n    'invoice_cols': table_cols(conn, 'invoices'),\n    'payment_cols': table_cols(conn, 'payments'),\n    'orphan_cols': table_cols(conn, 'payment_orphans'),\n    'invoice_count': conn.execute('SELECT COUNT(*) FROM invoices').fetchone()[0],\n    'payment_count': conn.execute('SELECT COUNT(*) FROM payments').fetchone()[0],\n    'orphan_count': conn.execute('SELECT COUNT(*) FROM payment_orphans').fetchone()[0],\n    'p4_orphan': conn.execute(\\\"SELECT id, invoice_id, amount_cents, created_at, reason FROM payment_orphans WHERE id='p4'\\\").fetchall(),\n    'bad_refs': conn.execute('SELECT COUNT(*) FROM payments p LEFT JOIN invoices i ON i.id=p.invoice_id WHERE i.id IS NULL').fetchone()[0],\n    'fk_violations': conn.execute('PRAGMA foreign_key_check').fetchall(),\n}\nrun_script('migration second', conn, migration)\nstate2 = {\n    'invoice_count': conn.execute('SELECT COUNT(*) FROM invoices').fetchone()[0],\n    'payment_count': conn.execute('SELECT COUNT(*) FROM payments').fetchone()[0],\n    'orphan_count': conn.execute('SELECT COUNT(*) FROM payment_orphans').fetchone()[0],\n    'p4_orphan': conn.execute(\\\"SELECT id, invoice_id, amount_cents, created_at, reason FROM payment_orphans WHERE id='p4'\\\").fetchall(),\n    'bad_refs': conn.execute('SELECT COUNT(*) FROM payments p LEFT JOIN invoices i ON i.id=p.invoice_id WHERE i.id IS NULL').fetchone()[0],\n    'fk_violations': conn.execute('PRAGMA foreign_key_check').fetchall(),\n}\nrun_script('rollback', conn, rollback)\nstate3 = {\n    'invoice_cols': table_cols(conn, 'invoices'),\n    'payment_cols': table_cols(conn, 'payments'),\n    'invoice_count': conn.execute('SELECT COUNT(*) FROM invoices').fetchone()[0],\n    'payment_count': conn.execute('SELECT COUNT(*) FROM payments').fetchone()[0],\n    'p4_payment': conn.execute(\\\"SELECT id, invoice_id, amount_cents, created_at FROM payments WHERE id='p4'\\\").fetchall(),\n    'has_payment_orphans': conn.execute(\\\"SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='payment_orphans'\\\").fetchone()[0],\n}\nprint('FIRST', state1)\nprint('SECOND', state2)\nprint('ROLLBACK', state3)\nprint('POSTCHECK SCRIPT EXECUTES')\nconn2 = sqlite3.connect(':memory:')\nrun_script('schema2', conn2, schema)\nrun_script('migration2', conn2, migration)\nfor stmt in [s.strip() for s in postcheck.split(';') if s.strip()]:\n    rows = conn2.execute(stmt).fetchall()\n    print(stmt.splitlines()[0], rows)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
