ue FROM invoices\",\n      [\n        [\n          \"invoice_count\",\n          3\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'payment_count' AS check_name, COUNT(*) AS value FROM payments\",\n      [\n        [\n          \"payment_count\",\n          3\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'payment_orphan_count' AS check_name, COUNT(*) AS value FROM payment_orphans\",\n      [\n        [\n          \"payment_orphan_count\",\n          1\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'null_status_count' AS check_name, COUNT(*) AS value FROM invoices WHERE status IS NULL\",\n      [\n        [\n          \"null_status_count\",\n          0\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'non_open_status_count' AS check_name, COUNT(*) AS value FROM invoices WHERE status <> 'open'\",\n      [\n        [\n          \"non_open_status_count\",\n          0\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'preserved_invoice_created_at_count' AS check_name, COUNT(*) AS value\\nFROM invoices\\nWHERE (id, created_at) IN (\\n  ('inv1', '2024-01-03T10:00:00Z'),\\n  ('inv2', '2024-01-04T10:00:00Z'),\\n  ('inv3', '2024-01-05T10:00:00Z')\\n)\",\n      [\n        [\n          \"preserved_invoice_created_at_count\",\n          3\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'preserved_orphan_p4_count' AS check_name, COUNT(*) AS value\\nFROM payment_orphans\\nWHERE id = 'p4'\\n  AND invoice_id = 'missing-invoice'\\n  AND amount_cents = 700\\n  AND created_at = '2024-01-07T10:00:00Z'\",\n      [\n        [\n          \"preserved_orphan_p4_count\",\n          1\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'dangling_payment_count' AS check_name, COUNT(*) AS value\\nFROM payments AS p\\nLEFT JOIN invoices AS i ON i.id = p.invoice_id\\nWHERE i.id IS NULL\",\n      [\n        [\n          \"dangling_payment_count\",\n          0\n        ]\n      ]\n    ]\n  ],\n  \"rolled\": {\n    \"tables\": [\n      [\n        \"invoices\",\n        \"CREATE TABLE \\\"invoices\\\" (\\n  id TEXT PRIMARY KEY,\\n  customer_id TEXT NOT NULL,\\n  total_cents INTEGER NOT NULL,\\n  created_at TEXT NOT NULL\\n)\"\n      ],\n      [\n        \"payments\",\n        \"CREATE TABLE \\\"payments\\\" (\\n  id TEXT PRIMARY KEY,\\n  invoice_id TEXT NOT NULL,\\n  amount_cents INTEGER NOT NULL,\\n  created_at TEXT NOT NULL\\n)\"\n      ]\n    ],\n    \"invoices\": [\n      [\n        \"inv1\",\n        \"cust-a\",\n        1200,\n        \"2024-01-03T10:00:00Z\"\n      ],\n      [\n        \"inv2\",\n        \"cust-b\",\n        5000,\n        \"2024-01-04T10:00:00Z\"\n      ],\n      [\n        \"inv3\",\n        \"cust-a\",\n        800,\n        \"2024-01-05T10:00:00Z\"\n      ]\n    ],\n    \"payments\": [\n      [\n        \"p1\",\n        \"inv1\",\n        1200,\n        \"2024-01-06T10:00:00Z\"\n      ],\n      [\n        \"p2\",\n        \"inv2\",\n        2500,\n        \"2024-01-06T11:00:00Z\"\n      ],\n      [\n        \"p3\",\n        \"inv2\",\n        2500,\n        \"2024-01-06T12:00:00Z\"\n      ],\n      [\n        \"p4\",\n        \"missing-invoice\",\n        700,\n        \"2024-01-07T10:00:00Z\"\n      ]\n    ],\n    \"fk_setting\": 0\n  }\n}"}],"details":{"language":"python","languages":["python"],"cells":[{"index":0,"title":"Verify billing migration package","code":"import sqlite3, json, os, tempfile\nfrom pathlib import Path\nbase = Path('/workspace/in/billingdb')\nschema = (base/'schema.sql').read_text()\nmigration = (base/'migration.sql').read_text()\nrollback = (base/'rollback.sql').read_text()\npostcheck = (base/'postcheck.sql').read_text()\n\ndef snapshot(conn):\n    cur = conn.cursor()\n    return {\n        'tables': cur.execute(\"SELECT name, sql FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name\").fetchall(),\n        'invoices': cur.execute(\"SELECT * FROM invoices ORDER BY id\").fetchall(),\n        'payments': cur.execute(\"SELECT * FROM payments ORDER BY id\").fetchall(),\n        'payment_orphans': cur.execute(\"SELECT * FROM payment_orphans ORDER BY id\").fetchall() if cur.execute(\"SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='payment_orphans'\").fetchone()[0] else None,\n        'fk_violations': cur.execute('PRAGMA foreign_key_check').fetchall(),\n        'fk_setting': cur.execute('PRAGMA foreign_keys').fetchone()[0],\n    }\n\ndb = tempfile.NamedTemporaryFile(suffix='.sqlite', delete=False)\ndb.close()\npath = db.name\nconn = sqlite3.connect(path)\nconn.executescript(schema)\npre = {\n    'invoice_count': conn.execute('SELECT COUNT(*) FROM invoices').fetchone()[0],\n    'payment_count': conn.execute('SELECT COUNT(*) FROM payments').fetchone()[0],\n    'orphan_count': conn.execute(\"SELECT COUNT(*) FROM payments p LEFT JOIN invoices i ON i.id=p.invoice_id WHERE i.id IS NULL\").fetchone()[0],\n}\nconn.executescript(migration)\nfirst = snapshot(conn)\nconn.executescript(migration)\nsecond = snapshot(conn)\npostcheck_rows = []\nfor stmt in [s.strip() for s in postcheck.split(';') if s.strip()]:\n    rows = conn.execute(stmt).fetchall()\n    if rows:\n        postcheck_rows.append((stmt, rows))\nconn.executescript(rollback)\nrolled = {\n    'tables': conn.execute(\"SELECT name, sql FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name\").fetchall(),\n    'invoices': conn.execute('SELECT * FROM invoices ORDER BY id').fetchall(),\n    'payments': conn.execute('SELECT * FROM payments ORDER BY id').fetchall(),\n    'fk_setting': conn.execute('PRAGMA foreign_keys').fetchone()[0],\n}\nconn.close()\nos.unlink(path)\nresult = {\n    'pre': pre,\n    'first': first,\n    'second': second,\n    'postcheck_rows': postcheck_rows,\n    'rolled': rolled,\n}\nprint(json.dumps(result, indent=2))","language":"python","output":"{\n  \"pre\": {\n    \"invoice_count\": 3,\n    \"payment_count\": 4,\n    \"orphan_count\": 1\n  },\n  \"first\": {\n    \"tables\": [\n      [\n        \"invoices\",\n        \"CREATE TABLE \\\"invoices\\\" (\\n  id TEXT PRIMARY KEY,\\n  customer_id TEXT NOT NULL,\\n  total_cents INTEGER NOT NULL,\\n  created_at TEXT NOT NULL,\\n  status TEXT NOT NULL DEFAULT 'open'\\n)\"\n      ],\n      [\n        \"payment_orphans\",\n        \"CREATE TABLE payment_orphans (\\n  id TEXT PRIMARY KEY,\\n  invoice_id TEXT NOT NULL,\\n  amount_cents INTEGER NOT NULL,\\n  created_at TEXT NOT NULL,\\n  reason TEXT NOT NULL\\n)\"\n      ],\n      [\n        \"payments\",\n        \"CREATE TABLE \\\"payments\\\" (\\n  id TEXT PRIMARY KEY,\\n  invoice_id TEXT NOT NULL,\\n  amount_cents INTEGER NOT NULL,\\n  created_at TEXT NOT NULL,\\n  FOREIGN KEY (invoice_id) REFERENCES invoices(id)\\n)\"\n      ]\n    ],\n    \"invoices\": [\n      [\n        \"inv1\",\n        \"cust-a\",\n        1200,\n        \"2024-01-03T10:00:00Z\",\n        \"open\"\n      ],\n      [\n        \"inv2\",\n        \"cust-b\",\n        5000,\n        \"2024-01-04T10:00:00Z\",\n        \"open\"\n      ],\n      [\n        \"inv3\",\n        \"cust-a\",\n        800,\n        \"2024-01-05T10:00:00Z\",\n        \"open\"\n      ]\n    ],\n    \"payments\": [\n      [\n        \"p1\",\n        \"inv1\",\n        1200,\n        \"2024-01-06T10:00:00Z\"\n      ],\n      [\n        \"p2\",\n        \"inv2\",\n        2500,\n        \"2024-01-06T11:00:00Z\"\n      ],\n      [\n        \"p3\",\n        \"inv2\",\n        2500,\n        \"2024-01-06T12:00:00Z\"\n      ]\n    ],\n    \"payment_orphans\": [\n      [\n        \"p4\",\n        \"missing-invoice\",\n        700,\n        \"2024-01-07T10:00:00Z\",\n        \"missing invoice during migration\"\n      ]\n    ],\n    \"fk_violations\": [],\n    \"fk_setting\": 1\n  },\n  \"second\": {\n    \"tables\": [\n      [\n        \"invoices\",\n        \"CREATE TABLE \\\"invoices\\\" (\\n  id TEXT PRIMARY KEY,\\n  customer_id TEXT NOT NULL,\\n  total_cents INTEGER NOT NULL,\\n  created_at TEXT NOT NULL,\\n  status TEXT NOT NULL DEFAULT 'open'\\n)\"\n      ],\n      [\n        \"payment_orphans\",\n        \"CREATE TABLE payment_orphans (\\n  id TEXT PRIMARY KEY,\\n  invoice_id TEXT NOT NULL,\\n  amount_cents INTEGER NOT NULL,\\n  created_at TEXT NOT NULL,\\n  reason TEXT NOT NULL\\n)\"\n      ],\n      [\n        \"payments\",\n        \"CREATE TABLE \\\"payments\\\" (\\n  id TEXT PRIMARY KEY,\\n  invoice_id TEXT NOT NULL,\\n  amount_cents INTEGER NOT NULL,\\n  created_at TEXT NOT NULL,\\n  FOREIGN KEY (invoice_id) REFERENCES invoices(id)\\n)\"\n      ]\n    ],\n    \"invoices\": [\n      [\n        \"inv1\",\n        \"cust-a\",\n        1200,\n        \"2024-01-03T10:00:00Z\",\n        \"open\"\n      ],\n      [\n        \"inv2\",\n        \"cust-b\",\n        5000,\n        \"2024-01-04T10:00:00Z\",\n        \"open\"\n      ],\n      [\n        \"inv3\",\n        \"cust-a\",\n        800,\n        \"2024-01-05T10:00:00Z\",\n        \"open\"\n      ]\n    ],\n    \"payments\": [\n      [\n        \"p1\",\n        \"inv1\",\n        1200,\n        \"2024-01-06T10:00:00Z\"\n      ],\n      [\n        \"p2\",\n        \"inv2\",\n        2500,\n        \"2024-01-06T11:00:00Z\"\n      ],\n      [\n        \"p3\",\n        \"inv2\",\n        2500,\n        \"2024-01-06T12:00:00Z\"\n      ]\n    ],\n    \"payment_orphans\": [\n      [\n        \"p4\",\n        \"missing-invoice\",\n        700,\n        \"2024-01-07T10:00:00Z\",\n        \"missing invoice during migration\"\n      ]\n    ],\n    \"fk_violations\": [],\n    \"fk_setting\": 1\n  },\n  \"postcheck_rows\": [\n    [\n      \"SELECT 'invoice_count' AS check_name, COUNT(*) AS value FROM invoices\",\n      [\n        [\n          \"invoice_count\",\n          3\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'payment_count' AS check_name, COUNT(*) AS value FROM payments\",\n      [\n        [\n          \"payment_count\",\n          3\n        ]\n      ]\n    ],\n    [\n      \"SELECT 'payment_orphan_count' AS check_name, COUNT(*) AS value FROM payment_o