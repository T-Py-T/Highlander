n11:\n12:class FakeRandom:\n13:    def __init__(self, values):\n14:        self.values = list(values)\n15:\n16:    def random(self):\n17:        return self.values.pop(0)\n18:\n19:\n20:def test_retry_jitter_uses_injected_random_source():\n21:    scheduler = Scheduler(clock=FakeClock(), random_source=FakeRandom([0.25]))\n22:    task = scheduler.add(\"task-retry\", priority=3)\n23:    retry = scheduler.schedule_retry(task, base_delay=10.0)\n24:    assert retry.attempts == 1\n25:    assert retry.run_at == 210.25\n26:\n27:\n28:def test_retry_task_is_not_ready_until_clock_reaches_run_at():\n29:    clock = FakeClock()\n30:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.5]))\n31:    task = scheduler.add(\"task-wait\", priority=3)\n32:    retry = scheduler.schedule_retry(task, base_delay=10.0)\n33:    assert scheduler.ready() == []\n34:    clock.value = retry.run_at\n35:    assert [task.id for task in scheduler.ready()] == [\"task-wait\"]"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/tests/test_retry_order.py","sourcePath":"/workspace/in/flakyqueue/tests/test_retry_order.py"}},"isError":false,"timestamp":1788213077399},{"role":"toolResult","toolCallId":"call_IV8nrZgqV8af2e6TSIlvzP6p|fc_0d1c21fd82de9baf016a95f755454087d287428787b07e4c05","toolName":"bash","content":[{"type":"text","text":"/usr/bin/python3: No module named pip\n\n\nCommand exited with code 1"}],"details":{"timeoutSeconds":20,"wallTimeMs":21,"exitCode":1},"isError":false,"timestamp":1788213077399},{"role":"assistant","content":[{"type":"thinking","thinking":"**Inspecting Python environment tools**","thinkingSignature":"{\"id\":\"rs_0d1c21fd82de9baf016a95f756887c87d288a05f2bf6555c4b\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"<PROVIDER_ENCRYPTED_PAYLOAD_REDACTED>\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Inspecting Python environment tools**\"}]}"},{"type":"toolCall","id":"call_pwy1zWRcmTXK4gXb01IuH3zm|fc_0d1c21fd82de9baf016a95f757708087d291ce8335c4