puts\": [\"Settings(database_path, readonly)\"],\n      \"notes\": [\"Defaults database_path to orders.sqlite.\", \"Treats MINISVC_READONLY=1 as true.\"]\n    },\n    {\n      \"identifier\": \"minisvc.storage.repo:OrderRepository.init_schema\",\n      \"kind\": \"method\",\n      \"summary\": \"Creates the single orders table if it does not already exist.\",\n      \"inputs\": [],\n      \"outputs\": [\"None\"],\n      \"notes\": [\"Schema contains only order_id, customer, and total_cents.\"]\n    },\n    {\n      \"identifier\": \"minisvc.storage.repo:OrderRepository.save\",\n      \"kind\": \"method\",\n      \"summary\": \"Inserts one Order row into SQLite without retry or conflict handling.\",\n      \"inputs\": [\"order: Order\"],\n      \"outputs\": [\"None\"],\n      \"notes\": [\"Duplicate primary keys or SQLite write errors propagate.\"]\n    },\n    {\n      \"identifier\": \"minisvc.storage.repo:OrderRepository.get\",\n      \"kind\": \"method\",\n      \"summary\": \"Loads one order row by id and materializes it into an Order dataclass.\",\n      \"inputs\": [\"order_id: str\"],\n      \"outputs\": [\"Order | None\"],\n      \"notes\": [\"Returns None when no row exists.\"]\n    },\n    {\n      \"identifier\": \"minisvc.api.handlers:create_order\",\n      \"kind\": \"function\",\n      \"summary\": \"Transforms payload fields into an Order, persists it, and returns a created response with an inline audit event.\",\n      \"inputs\": [\"payload: dict\", \"repo: OrderRepository\"],\n      \"outputs\": [\"dict response\"],\n      \"notes\": [\"Assumes payload contains order_id, customer, and total_cents.\", \"Casts total_cents with int() and does not catch validation or persistence failures.\"]\n    },\n    {\n      \"identifier\": \"minisvc.api.handlers:get_order\",\n      \"kind\": \"function\",\n      \"summary\": \"Fetches an order, returns missing when absent, otherwise returns order data plus a read audit event.\",\n      \"inputs\": [\"order_id: str\", \"repo: OrderRepository\"],\n      \"outputs\": [\"dict response\"],\n      \"notes\": [\"Read path emits an event in the response but does not persist audit state.\"]\n    },\n    {\n      \"identifier\": \"minisvc.api.routes:register_routes\",\n      \"kind\": \"function\",\n      \"summary\": \"Wires handler lambdas onto an app object exposing post() and get() methods.\",\n      \"inputs\": [\"app\", \"repo\"],\n      \"outputs\": [\"None\"],\n      \"notes\": [\"Route registration assumes an external framework supplies the app abstraction.\"]\n    },\n    {\n      \"identifier\": \"minisvc.audit:order_event\",\n      \"kind\": \"function\",\n      \"summary\": \"Builds the audit event dictionary returned from handlers.\",\n      \"inputs\": [\"order: Order\", \"action: str\"],\n      \"outputs\": [\"dict event\"],\n      \"notes\": [\"Pure function; no durable side effects.\"]\n    }\n  ],\n  \"runtime_flows\": [\n    {\n      \"name\": \"CLI startup flow\",\n      \"steps\": [\n        \"Packaging invokes minisvc.cli:main via the minisvc console script declared in pyproject.toml.\",\n        \"main reads os.environ and passes it to minisvc.config:load_settings.\",\n        \"load_settings returns Settings(database_path, readonly).\",\n        \"main instantiates minisvc.storage.repo:OrderRepository with settings.database_path.\",\n        \"main calls OrderRepository.init_schema to create the orders table if missing.\",\n        \"main prints a readiness line containing the database path and returns status code 0.\"\n      ]\n    },\n    {\n      \"name\": \"HTTP create-order flow\",\n      \"steps\": [\n        \"An integrator calls minisvc.api.routes:register_routes(app, repo).\",\n        \"register_routes wires POST /orders to minisvc.api.handlers:create_order via a lambda that forwards payload and repo.\",\n        \"create_order reads order_id, customer, and total_cents from the request payload.\",\n        \"create_order instantiates minisvc.models:Order after coercing total_cents with int().\",\n        \"create_order calls OrderRepository.save, which opens a sqlite3 connection and inserts the row into orders.\",\n        \"create_order calls minisvc.audit:order_event with action='created'.\",\n        \"create_order returns a response dict containing status, order_id, and the inline event payload.\"\n      ]\n    },\n    {\n      \"name\": \"HTTP get-order flow\",\n      \"steps\": [\n        \"register_routes wires GET /orders/<order_id> to minisvc.api.handlers:get_order.\",\n        \"get_order calls OrderRepository.get(order_id).\",\n        \"OrderRepository.get queries SQLite for a matching row and returns Order or None.\",\n        \"get_order returns status='missing' when the row is absent.\",\n        \"When the row exists, get_order serializes order.__dict__, adds order_event(action='read'), and returns status='ok'.\"\n      ]\n    }\n  ]\n}"},"partialResult":{"content":[{"type":"text","text":"Writing 9788 bytes to out/module_map.json..."}],"details":{"resolvedPath":"/workspace/out/module_map.json"}}}
