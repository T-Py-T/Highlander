+def _normalized_shipping_method(value: Any) -> str:
+    if value is None:
+        return _DEFAULT_SHIPPING_METHOD
+    if isinstance(value, str) and value.strip() == "":
+        return _DEFAULT_SHIPPING_METHOD
+    return str(value)
