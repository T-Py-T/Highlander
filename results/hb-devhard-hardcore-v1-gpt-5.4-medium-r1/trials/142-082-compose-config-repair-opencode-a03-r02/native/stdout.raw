/composeapp-api:1.4.2\n    host_port: 8080\n    container_port: 8000\n    required_env:\n      - DATABASE_URL\n      - REDIS_URL\n      - QUEUE_NAME\n      - APP_DATA_DIR\n    health_path: /healthz\n    data_volume: api-data\n    depends_on:\n      db: service_healthy\n      redis: service_healthy\n  worker:\n    image: ghcr.io/example/composeapp-worker:1.4.2\n    required_env:\n      - DATABASE_URL\n      - REDIS_URL\n      - QUEUE_NAME\n    queue_name: critical\n    depends_on:\n      db: service_healthy\n      redis: service_healthy\n  db:\n    image: postgres:16.2-alpine\n    healthcheck: pg_isready\n  redis:\n    image: redis:7.2-alpine\n    healthcheck: redis-cli ping\nvolumes:\n  api_data_name: api-data\n  api_data_target: /data","lineStart":1,"lineEnd":34,"totalLines":34,"truncated":false}},"title":"workspace/in/composeapp/config/service-policy.yml","time":{"start":1788214320689,"end":1788214320722}},"metadata":{"openai":{"itemId":"fc_0742efcf97fc88c9016a95fc3088bc87d2919921394928e4af"}},"id":"prt_059e11e2c001L43HZKhh70EVSI","sessionID":"ses_fa61f3f79ffeN3fseSBe3kQ0da","messageID":"msg_059e110b3001qM2lDYiYdmrKVU"}}
