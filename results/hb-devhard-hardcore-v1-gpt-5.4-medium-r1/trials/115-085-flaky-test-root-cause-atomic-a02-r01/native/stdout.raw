lected')\n    if failed:\n        print(f'{failed} failed, {passed} passed')\n        raise SystemExit(1)\n    print(f'{passed} passed')\n\n\nif __name__ == '__main__':\n    main(sys.argv)\nPY\nPYTHONPATH=/tmp python3 -m pytest tests","cwd":"/workspace/in/flakyqueue","timeout":120,"pty":false}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":782,"output":687,"cacheRead":18944,"cacheWrite":0,"reasoning":231,"totalTokens":20413,"cost":{"input":0.001955,"output":0.010305,"cacheRead":0.004736,"cacheWrite":0,"total":0.016996}},"stopReason":"toolUse","timestamp":1788199438637,"responseId":"resp_07c1d2010a9cba34016a95c20ef16487d2b01a4040f25e34eb","rawStopReason":"completed"}}
