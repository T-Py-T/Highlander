kyqueue/clock.py","sourcePath":"/workspace/in/flakyqueue/flakyqueue/clock.py"}},"isError":false,"timestamp":1788199391797},{"role":"toolResult","toolCallId":"call_Hq92QNMMGq3eomApAc2R6b65|fc_07c1d2010a9cba34016a95c1df9b4c87d288bea7644dc06831","toolName":"read","content":[{"type":"text","text":"[in/flakyqueue/tests/test_retry_order.py#8127]\n1:from flakyqueue.scheduler import Scheduler\n2:\n3:\n4:class FakeClock:\n5:    def __init__(self):\n6:        self.value = 200.0\n7:\n8:    def now(self):\n9:        return self.value\n10:\n11:\n12:class FakeRandom:\n13:    def __init__(self, values):\n14:        self.values = list(values)\n15:\n16:    def random(self):\n17:        return self.values.pop(0)\n18:\n19:\n20:def test_retry_jitter_uses_injected_random_source():\n21:    scheduler = Scheduler(clock=FakeClock(), random_source=FakeRandom([0.25]))\n22:    task = scheduler.add(\"task-retry\", priority=3)\n23:    retry = scheduler.schedule_retry(task, base_delay=10.0)\n24:    assert retry.attempts == 1\n25:    assert retry.run_at == 210.25\n26:\n27:\n28:def test_retry_task_is_not_ready_until_clock_reaches_run_at():\n29:    clock = FakeClock()\n30:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.5]))\n31:    task = scheduler.add(\"task-wait\", priority=3)\n32:    retry = scheduler.schedule_retry(task, base_delay=10.0)\n33:    assert scheduler.ready() == []\n34:    clock.value = retry.run_at\n35:    assert [task.id for task in scheduler.ready()] == [\"task-wait\"]"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/tests/test_retry_order.py","sourcePath":"/workspace/in/flakyqueue/tests/test_retry_order.py"}},"isError":false,"timestamp":1788199391797},{"role":"toolResult","toolCallId":"call_FUkQuDFMOS9FEoRWVkFd5pTB|fc_07c1d2010a9cba34016a95c1df9b5087d2b3dfa9acc88a14a1","toolName":"read","content":[{"type":"text","text":"[in/flakyqueue/tests/test_scheduler.py#C35B]\n1:from flakyqueue.scheduler import Scheduler\n2:\n3:\n4:class FakeClock:\n5:    def __init__(self):\n6:        self.value = 1000.0\n7:\n8:    def now(self):\n9:        return self.value\n10:\n11:\n12:class FakeRandom:\n13:    def __init__(self, values):\n14:        self.values = list(values)\n15:\n16:    def random(self):\n17:        return self.values.pop(0)\n18:\n19:\n20:def test_ready_order_is_stable_for_equal_priority():\n21:    clock = FakeClock()\n22:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.3]))\n23:    scheduler.add(\"task-b\", priority=5)\n24:    scheduler.add(\"task-a\", priority=5)\n25:    scheduler.add(\"task-c\", priority=9)\n26:    assert [task.id for task in scheduler.ready()] == [\"task-c\", \"task-a\", \"task-b\"]\n27:    assert [task.id for task in scheduler.ready()] == [\"task-c\", \"task-a\", \"task-b\"]\n28:\n29:\n30:def test_add_uses_injected_clock():\n31:    clock = FakeClock()\n32:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.1]))\n33:    task = scheduler.add(\"task-1\", priority=1)\n34:    assert task.created_at == 1000.0\n35:    assert task.run_at == 1000.0"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/tests/test_scheduler.py","sourcePath":"/workspace/in/flakyqueue/tests/test_scheduler.py"}},"isError":false,"timestamp":1788199391797}]}
