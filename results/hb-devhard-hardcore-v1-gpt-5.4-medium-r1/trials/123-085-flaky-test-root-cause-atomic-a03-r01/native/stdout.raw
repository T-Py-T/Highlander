{"type":"tool_execution_end","toolCallId":"call_QGMnnLVjCgv8uXAp0AIAnCZZ|fc_01f1371e534a58f8016a95c88cf46087d28533d2a6b2706dec","toolName":"read","result":{"content":[{"type":"text","text":"[in/flakyqueue/tests/test_scheduler.py#C35B]\n1:from flakyqueue.scheduler import Scheduler\n2:\n3:\n4:class FakeClock:\n5:    def __init__(self):\n6:        self.value = 1000.0\n7:\n8:    def now(self):\n9:        return self.value\n10:\n11:\n12:class FakeRandom:\n13:    def __init__(self, values):\n14:        self.values = list(values)\n15:\n16:    def random(self):\n17:        return self.values.pop(0)\n18:\n19:\n20:def test_ready_order_is_stable_for_equal_priority():\n21:    clock = FakeClock()\n22:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.3]))\n23:    scheduler.add(\"task-b\", priority=5)\n24:    scheduler.add(\"task-a\", priority=5)\n25:    scheduler.add(\"task-c\", priority=9)\n26:    assert [task.id for task in scheduler.ready()] == [\"task-c\", \"task-a\", \"task-b\"]\n27:    assert [task.id for task in scheduler.ready()] == [\"task-c\", \"task-a\", \"task-b\"]\n28:\n29:\n30:def test_add_uses_injected_clock():\n31:    clock = FakeClock()\n32:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.1]))\n33:    task = scheduler.add(\"task-1\", priority=1)\n34:    assert task.created_at == 1000.0\n35:    assert task.run_at == 1000.0"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/tests/test_scheduler.py","sourcePath":"/workspace/in/flakyqueue/tests/test_scheduler.py"}}},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_Uztn4YznUWQjwTKFJlXrl4sR|fc_01f1371e534a58f8016a95c88cf44087d29de55c345965a05a","toolName":"read","result":{"content":[{"type":"text","text":"[in/flakyqueue/flakyqueue/store.py#AB7E]\n1:from __future__ import annotations\n2:\n3:\n4:class MemoryStore:\n5:    def __init__(self) -> None:\n6:        self._items = {}\n7:\n8:    def save(self, task) -> None:\n9:        self._items[task.id] = task\n10:\n11:    def all(self):\n12:        return list(self._items.values())"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/flakyqueue/store.py","sourcePath":"/workspace/in/flakyqueue/flakyqueue/store.py"}}},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_Jcag3952nvKNTGfnqtuz1z2s|fc_01f1371e534a58f8016a95c88cf44887d28f8b42726fcde5c0","toolName":"read","result":{"content":[{"type":"text","text":"[in/flakyqueue/flakyqueue/clock.py#1FBE]\n1:from __future__ import annotations\n2:\n3:import time\n4:\n5:\n6:class SystemClock:\n7:    def now(self) -> float:\n8:        return time.time()"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/flakyqueue/clock.py","sourcePath":"/workspace/in/flakyqueue/flakyqueue/clock.py"}}},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_QnenzHEZsfpI6ilUmQNQqLG5|fc_01f1371e534a58f8016a95c88cf43487d28834c788c11b207a","toolName":"read","result":{"content":[{"type":"text","text":"[in/flakyqueue/flakyqueue/scheduler.py#3A57]\n1:from __future__ import annotations\n2:\n3:import random\n4:import time\n5:from dataclasses import dataclass, replace\n6:\n7:from flakyqueue.clock import SystemClock\n8:from flakyqueue.store import MemoryStore\n9:\n10:\n11:@dataclass(frozen=True)\n12:class Task:\n13:    id: str\n14:    priority: int\n15:    created_at: float\n16:    attempts: int = 0\n17:    run_at: float = 0.0\n18:\n19:\n20:class Scheduler:\n21:    def __init__(self, clock=None, store=None, random_source=None) -> None:\n22:        self.clock = clock or SystemClock()\n23:        self.store = store or MemoryStore()\n24:        self.random_source = random_source\n25:\n26:    def add(self, task_id: str, priority: int) -> Task:\n27:        task = Task(id=task_id, priority=priority, created_at=time.time(), run_at=time.time())\n28:        self.store.save(task)\n29:        return task\n30:\n31:    def ready(self):\n32:        now = time.time()\n33:        items = [task for task in self.store.all() if task.run_at <= now]\n34:        random.shuffle(items)\n35:        return sorted(items, key=lambda task: task.priority, reverse=True)\n36:\n37:    def schedule_retry(self, task: Task, base_delay: float = 5.0) -> Task:\n38:        jitter = random.random()\n39:        updated = replace(task, attempts=task.attempts + 1, run_at=time.time() + base_delay + jitter)\n40:        self.store.save(updated)\n41:        return updated"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/flakyqueue/scheduler.py","sourcePath":"/workspace/in/flakyqueue/flakyqueue/scheduler.py"}}},"isError":false}
{"type":"tool_execution_end","toolCallId":"call_vgDDsnTJ8yC72SYdHKN9A93W|fc_01f1371e534a58f8016a95c88cf45887d2bf4272fe648e46b4","toolName":"read","result":{"content":[{"type":"text","text":"[in/flakyqueue/tests/test_retry_order.py#8127]\n1:from flakyqueue.scheduler import Scheduler\n2:\n3:\n4:class FakeClock:\n5:    def __init__(self):\n6:        self.value = 200.0\n7:\n8:    def now(self):\n9:        return self.value\n10:\n11:\n12:class FakeRandom:\n13:    def __init__(self, values):\n14:        self.values = list(values)\n15:\n16:    def random(self):\n17:        return self.values.pop(0)\n18:\n19:\n20:def test_retry_jitter_uses_injected_random_source():\n21:    scheduler = Scheduler(clock=FakeClock(), random_source=FakeRandom([0.25]))\n22:    task = scheduler.add(\"task-retry\", priority=3)\n23:    retry = scheduler.schedule_retry(task, base_delay=10.0)\n24:    assert retry.attempts == 1\n25:    assert retry.run_at == 210.25\n26:\n27:\n28:def test_retry_task_is_not_ready_until_clock_reaches_run_at():\n29:    clock = FakeClock()\n30:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.5]))\n31:    task = scheduler.add(\"task-wait\", priority=3)\n32:    retry = scheduler.schedule_retry(task, base_delay=10.0)\n33:    assert scheduler.ready() == []\n34:    clock.value = retry.run_at\n35:    assert [task.id for task in scheduler.ready()] == [\"task-wait\"]"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/tests/test_retry_order.py","sourcePath":"/workspace/in/flakyqueue/tests/test_retry_order.py"}}},"isError":false}
