      self.values = list(values)\n15:\n16:    def random(self):\n17:        return self.values.pop(0)\n18:\n19:\n20:def test_ready_order_is_stable_for_equal_priority():\n21:    clock = FakeClock()\n22:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.3]))\n23:    scheduler.add(\"task-b\", priority=5)\n24:    scheduler.add(\"task-a\", priority=5)\n25:    scheduler.add(\"task-c\", priority=9)\n26:    assert [task.id for task in scheduler.ready()] == [\"task-c\", \"task-a\", \"task-b\"]\n27:    assert [task.id for task in scheduler.ready()] == [\"task-c\", \"task-a\", \"task-b\"]\n28:\n29:\n30:def test_add_uses_injected_clock():\n31:    clock = FakeClock()\n32:    scheduler = Scheduler(clock=clock, random_source=FakeRandom([0.1]))\n33:    task = scheduler.add(\"task-1\", priority=1)\n34:    assert task.created_at == 1000.0\n35:    assert task.run_at == 1000.0"}],"details":{"meta":{"source":"/workspace/in/flakyqueue/tests/test_scheduler.py","sourcePath":"/workspace/in/flakyqueue/tests/test_scheduler.py"}},"isError":false,"timestamp":1788201101115},{"role":"assistant","content":[{"type":"thinking","thinking":"**Identifying missing pytest dependency**","thinkingSignature":"{\"id\":\"rs_01f1371e534a58f8016a95c88e2cc087d2a0f14969050e44ee\",\"type\":\"reasoning\",\"content\":[],\"encrypted_content\":\"<PROVIDER_ENCRYPTED_PAYLOAD_REDACTED>\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Identifying missing pytest dependency**\"}]}"},{"type":"toolCall","id":"call_gdCGpYRUUMzQFZcwHjBbIHWt|fc_01f1371e534a58f8016a95c88f04a887d289d717e3b34d6678","name":"bash","arguments":{"command":"find .. -maxdepth 4 \\( -name '.venv' -o -name 'venv' -o -name 'requirements*.txt' -o -name 'tox.ini' -o -name 'setup.cfg' \\) | sort","cwd":"/workspace/in/flakyqueue","timeout":30}}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.4","usage":{"input":2106,"output":101,"cacheRead":16384,"cacheWrite":0,"reasoning":17,"totalTokens":18591,"cost":{"input":0.0