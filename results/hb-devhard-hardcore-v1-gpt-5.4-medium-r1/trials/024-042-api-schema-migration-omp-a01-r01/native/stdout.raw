r payloads to the public v2 API shape.\"\"\"\n    payload = _require_mapping(payload, \"payload\")\n    if _is_v2_payload(payload):\n        return _normalize_v2(payload)\n    return _convert_legacy(payload)\n\n\ndef _audit_path():\n    return Path(__file__).with_name(\"conversion_audit.json\")\n\n\ndef _write_audit(audit):\n    _audit_path().write_text(json.dumps(audit, indent=2, sort_keys=True), encoding=\"utf-8\")\n\n\ndef convert_many(payloads):\n    converted = []\n    errors = []\n    warnings = []\n    stats = {\n        \"converted_count\": 0,\n        \"error_count\": 0,\n        \"warning_count\": 0,\n        \"pii_dropped_count\": 0,\n        \"unknown_fields_count\": 0,\n    }\n    for index, payload in enumerate(payloads):\n        try:\n            converted.append(\n                _normalize_v2(payload, index=index, warnings=warnings, stats=stats)\n                if _is_v2_payload(payload)\n                else _convert_legacy(payload, index=index, warnings=warnings, stats=stats)\n            )\n            stats[\"converted_count\"] += 1\n…\n            errors.append({\"index\": index, \"path\": \"payload\", \"error\": str(exc)})\n…\n    return ConversionResult(converted, errors, warnings)","startLine":326,"lineNumbers":[326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,null,399,null,403]},"fileSize":14555,"meta":{"source":{"type":"path","value":"/workspace/in/schema_migration/client.py"},"truncation":{"direction":"head","truncatedBy":"lines","totalLines":442,"totalBytes":2388,"outputLines":65,"outputBytes":2388,"shownRange":{"start":329,"end":393},"nextOffset":394}}}},"isError":false}
