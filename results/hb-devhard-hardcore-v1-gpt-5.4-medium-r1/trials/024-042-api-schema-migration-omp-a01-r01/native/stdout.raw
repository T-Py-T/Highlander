|    \"shipping_method\",\n+29|    \"shipping\",\n+30|}\n+31|\n+32|\n+33|class ConversionError(ValueError):\n+34|    def __init__(self, path, error):\n+35|        super().__init__(error)\n+36|        self.path = path\n+37|        self.error = error\n+38|\n+39|\n+40|class ConversionResult(Sequence):\n+41|    def __init__(self, converted, errors, warnings):\n+42|        self.converted = converted\n+43|        self.errors = errors\n+44|        self.warnings = warnings\n+45|\n+46|    def __getitem__(self, index):\n+47|        if index == 0:\n+48|            return self.converted\n+49|        if index == 1:\n+50|            return self.errors\n+51|        if index == 2:\n+52|            return self.warnings\n+53|        raise IndexError(index)\n+54|\n+55|    def __len__(self):\n+56|        return 3\n+57|\n+58|    def __iter__(self):\n+59|        yield self.converted\n+60|        yield self.errors\n+61|\n+62|\n+63|def _raise(path, error):\n+64|    raise ConversionError(path, error)\n+65|\n+66|\n+67|def _require_mapping(value, path):\n+68|    if not isinstance(value, dict):\n+69|        _raise(path, \"must be an object\")\n+70|    return value\n+71|\n+72|\n+73|def _require_string(value, path):\n+74|    if value is None:\n+75|        _raise(path, \"missing value\")\n+76|    if not isinstance(value, str):\n+77|        _raise(path, \"must be a string\")\n+78|    if not value.strip():\n+79|        _raise(path, \"must not be blank\")\n+80|    return value\n+81|\n+82|\n+83|def _require_list(value, path):\n+84|    if not isinstance(value, list):\n+85|        _raise(path, \"must be an array\")\n+86|    if not value:\n+87|        _raise(path, \"must not be empty\")\n+88|    return value\n+89|\n+90|\n+91|def _coerce_int(value, path):\n+92|    if isinstance(value, bool):\n+93|        _raise(path, \"must be an integer\")\n+94|    if isinstance(value, int):\n+95|        return value\n+96|    if isinstance(value, str):\n+97|        stripped = value.strip()\n+98|        if stripped and (